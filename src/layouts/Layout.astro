---
import "../styles/global.css";
import { site } from "../data/site";
import { asset, page } from "../lib/paths";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
const path = Astro.url.pathname;
const wa = `https://wa.me/${site.whatsapp}`;
const logo = asset("images/Logo-FB-blanco-sin-fondo-02.png");
const publicOrigin = Astro.site || new URL("https://diazdiegok.github.io");
const canonicalUrl = new URL(path, publicOrigin).href;
const ogImage = new URL(asset("images/og-share.jpg"), publicOrigin).href;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
const isHome = path === basePath || path === `${basePath}/`;
const inLiga =
  path.includes("/ranking") ||
  path.includes("/fixture") ||
  path.includes("/resultados") ||
  path.includes("/fecha") ||
  (path.includes("/sedes") && !path.includes("/academia")) ||
  path.includes("/liga/");
const inAcademia = path.includes("/academia");
const inTorneos = path.includes("/torneos");
---
<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="FB Academia de pádel" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="es_AR" />
    <link rel="image_src" href={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href={logo} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&family=Oswald:wght@500;600&display=swap" rel="stylesheet" />
  </head>
  <body class:list={["court", { "is-admin": noindex }]}>
    <a class="skip-link" href="#main-content">Saltar al contenido</a>
    {!noindex && (
      <div class="splash" id="splash" hidden>
        <div class="splash-scene" aria-hidden="true">
          <svg class="splash-art" viewBox="0 0 440 248">
            <path class="splash-baseline" d="M28 232 H412" />
            <g class="splash-paddle">
              <path fill="#d6ff2f" d="M150 22c-44 0-74 34-74 74 0 34 20 60 52 70 9 3 15 11 22 20 7-9 13-17 22-20 32-10 52-36 52-70 0-40-30-74-74-74z"/>
              <path fill="#f4f1e8" d="M150 34c-36 0-60 28-60 62 0 28 16 50 42 58 8 2 12 8 18 16 6-8 10-14 18-16 26-8 42-30 42-58 0-34-24-62-60-62z"/>
              <g fill="#141814">
                <circle cx="128" cy="68" r="3.1"/><circle cx="150" cy="68" r="3.1"/><circle cx="172" cy="68" r="3.1"/>
                <circle cx="117" cy="88" r="3.1"/><circle cx="139" cy="88" r="3.1"/><circle cx="161" cy="88" r="3.1"/><circle cx="183" cy="88" r="3.1"/>
                <circle cx="128" cy="108" r="3.1"/><circle cx="150" cy="108" r="3.1"/><circle cx="172" cy="108" r="3.1"/>
                <circle cx="139" cy="128" r="3.1"/><circle cx="161" cy="128" r="3.1"/>
              </g>
              <rect x="142" y="176" width="16" height="34" rx="3" fill="#a39e92"/>
              <rect x="137" y="204" width="26" height="18" rx="5" fill="#d6ff2f"/>
              <rect x="141" y="218" width="18" height="4" rx="1" fill="#f4f1e8"/>
            </g>
            <g class="splash-ball">
              <circle class="splash-trail" cx="268" cy="96" r="13"/>
              <circle cx="268" cy="96" r="13" fill="#d6ff2f"/>
              <path d="M259 90c6 2 11 7 14 13" stroke="#141814" stroke-width="1.6" fill="none" stroke-linecap="round"/>
            </g>
            <circle class="splash-hit" cx="230" cy="96" r="8"/>
          </svg>
          <p class="splash-mark">PADEL <em>FB</em></p>
          <span class="splash-rule"></span>
          <p class="splash-sub">{site.city}, {site.province}</p>
        </div>
      </div>
    )}
    {!noindex && (
      <nav aria-label="Navegación principal">
        <div class="wrap">
          <a class="brand" href={page("")}>
            <img src={logo} alt={site.name} />
            PADEL FB
          </a>
          <ul class="nav-links" id="site-menu">
            <li><a href={page("")} aria-current={isHome ? "page" : undefined}>Inicio</a></li>
            <li class:list={["nav-item", { open: false }]}>
              <button class:list={["nav-trigger", { on: inLiga }]} type="button" data-nav-drop aria-expanded="false">Liga</button>
              <div class="nav-drop">
                <div class="nav-drop-inner">
                  <a href={page("liga/")}>Resumen</a>
                  <a href={page("ranking/")}>Ranking</a>
                  <a href={page("fixture/")}>Fixture</a>
                  <a href={page("resultados/")}>Resultados</a>
                  <a href={page("fecha/")}>Fecha</a>
                  <a href={page("sedes/")}>Sedes</a>
                </div>
              </div>
            </li>
            <li class="nav-item">
              <button class:list={["nav-trigger", { on: inAcademia }]} type="button" data-nav-drop aria-expanded="false">Academia</button>
              <div class="nav-drop">
                <div class="nav-drop-inner">
                  <a href={page("academia/")} aria-current={inAcademia && !path.includes("/sedes") && !path.includes("/infantiles") ? "page" : undefined}>Clases Adultos</a>
                  <a href={page("academia/infantiles/")} aria-current={path.includes("/infantiles") ? "page" : undefined}>Clases Infantiles</a>
                  <a href={page("academia/sedes/")} aria-current={path.includes("/academia") && path.includes("/sedes") ? "page" : undefined}>Sedes</a>
                </div>
              </div>
            </li>
            <li><a href={page("torneos/")} class:list={[{ on: inTorneos }]} aria-current={inTorneos ? "page" : undefined}>Torneos</a></li>
          </ul>
          <div class="nav-actions">
            <button class="nav-cta nav-cta-ghost" type="button" id="nav-logout" hidden>Salir</button>
            <a class="nav-cta" href={page("inscripcion/")}>Sumate</a>
          </div>
          <button class="menu-btn" type="button" data-menu aria-expanded="false" aria-controls="site-menu">Menu</button>
        </div>
      </nav>
    )}
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    {!noindex && (
      <footer>
        <div class="wrap">
          <div>
            <strong>{site.name.toUpperCase()} ® <span data-year>{new Date().getFullYear()}</span></strong>
            <p>Liga, academia y torneos de pádel · {site.city}, {site.province}</p>
          </div>
          <div class="footer-links">
            <a href={site.instagram} target="_blank" rel="noreferrer">Instagram</a>
            <a href={wa} target="_blank" rel="noreferrer">WhatsApp</a>
          </div>
        </div>
      </footer>
    )}
    {!noindex && (
      <a class="wa" href={wa} title="WhatsApp" aria-label="WhatsApp" target="_blank" rel="noreferrer">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path fill="currentColor" d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
      </a>
    )}
    <script>
      const menuBtn = document.querySelector("[data-menu]");
      menuBtn?.addEventListener("click", () => {
        const open = document.querySelector("nav")?.classList.toggle("open") || false;
        menuBtn.setAttribute("aria-expanded", String(open));
      });
      document.querySelectorAll("[data-nav-drop]").forEach((btn) => {
        btn.addEventListener("click", (e) => {
          e.preventDefault();
          e.stopPropagation();
          const item = btn.closest(".nav-item");
          const open = item?.classList.contains("open");
          document.querySelectorAll(".nav-item.open").forEach((el) => {
            if (el === item) return;
            el.classList.remove("open");
            el.querySelector("[data-nav-drop]")?.setAttribute("aria-expanded", "false");
          });
          if (item) {
            item.classList.toggle("open", !open);
            btn.setAttribute("aria-expanded", open ? "false" : "true");
          }
        });
        btn.addEventListener("keydown", (e) => {
          if (e.key === "ArrowDown") {
            e.preventDefault();
            if (btn.getAttribute("aria-expanded") !== "true") btn.click();
            btn.closest(".nav-item")?.querySelector(".nav-drop a")?.focus();
          }
        });
      });
      document.querySelectorAll(".nav-item").forEach((item) => {
        item.addEventListener("click", (e) => e.stopPropagation());
      });
      document.addEventListener("click", () => {
        document.querySelectorAll(".nav-item.open").forEach((el) => {
          el.classList.remove("open");
          el.querySelector("[data-nav-drop]")?.setAttribute("aria-expanded", "false");
        });
      });
      document.addEventListener("keydown", (e) => {
        if (e.key !== "Escape") return;
        document.querySelectorAll(".nav-item.open").forEach((el) => {
          el.classList.remove("open");
          const btn = el.querySelector("[data-nav-drop]");
          btn?.setAttribute("aria-expanded", "false");
          btn?.focus();
        });
        document.querySelector("nav")?.classList.remove("open");
        menuBtn?.setAttribute("aria-expanded", "false");
      });
      const AUTH_KEY = "liga-fb-admin-ok";
      const logoutBtn = document.getElementById("nav-logout");
      function adminLoggedIn() {
        try {
          const raw = localStorage.getItem(AUTH_KEY) || sessionStorage.getItem(AUTH_KEY);
          if (!raw) return false;
          const data = JSON.parse(raw);
          return !!(data?.token && data.exp && Date.now() <= data.exp);
        } catch {
          return false;
        }
      }
      if (logoutBtn) {
        logoutBtn.hidden = !adminLoggedIn();
        logoutBtn.addEventListener("click", () => {
          localStorage.removeItem(AUTH_KEY);
          sessionStorage.removeItem(AUTH_KEY);
          location.reload();
        });
      }
      const splash = document.getElementById("splash");
      document.querySelectorAll("[data-year]").forEach((el) => {
        el.textContent = String(new Date().getFullYear());
      });
      if (splash && !sessionStorage.getItem("liga-fb-splash-v4")) {
        splash.hidden = false;
        sessionStorage.setItem("liga-fb-splash-v4", "1");
        setTimeout(() => {
          splash.classList.add("out");
          setTimeout(() => splash.remove(), 560);
        }, 2500);
      } else {
        splash?.remove();
      }
    </script>
  </body>
</html>
