---
import "../styles/global.css";
import { site } from "../data/site";
import { asset, page } from "../lib/paths";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
const path = Astro.url.pathname;
const wa = `https://wa.me/${site.whatsapp}`;
const logo = asset("images/Logo-FB-blanco-sin-fondo-02.png");
const ogImage = "https://diazdiegok.github.io/Padel-FB/images/og-share.jpg";
const ogUrl = "https://diazdiegok.github.io/Padel-FB/";
const inLiga =
  path.includes("/ranking") ||
  path.includes("/fixture") ||
  path.includes("/resultados") ||
  path.includes("/fecha") ||
  (path.includes("/sedes") && !path.includes("/academia")) ||
  path.includes("/liga/");
const inAcademia = path.includes("/academia");
const inTorneos = path.includes("/torneos");
---
<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="FB Academia de pádel" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="es_AR" />
    <link rel="image_src" href={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href={logo} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&family=Oswald:wght@500;600&display=swap" rel="stylesheet" />
  </head>
  <body class:list={["court", { "is-admin": noindex }]}>
    {!noindex && (
      <div class="splash" id="splash" hidden>
        <div class="splash-scene" aria-hidden="true">
          <svg class="splash-art" viewBox="0 0 280 230">
            <g class="splash-paddle">
              <path fill="#d6ff2f" d="M70 8c-28 0-52 24-52 72 0 42 18 68 52 80 34-12 52-38 52-80 0-48-24-72-52-72z"/>
              <path fill="#f3f0e6" d="M70 18c-22 0-42 20-42 62 0 36 15 58 42 68 27-10 42-32 42-68 0-42-20-62-42-62z"/>
              <g fill="#070907">
                <circle cx="54" cy="42" r="4.2"/><circle cx="70" cy="42" r="4.2"/><circle cx="86" cy="42" r="4.2"/>
                <circle cx="46" cy="58" r="4.2"/><circle cx="62" cy="58" r="4.2"/><circle cx="78" cy="58" r="4.2"/><circle cx="94" cy="58" r="4.2"/>
                <circle cx="46" cy="74" r="4.2"/><circle cx="62" cy="74" r="4.2"/><circle cx="78" cy="74" r="4.2"/><circle cx="94" cy="74" r="4.2"/>
                <circle cx="54" cy="90" r="4.2"/><circle cx="70" cy="90" r="4.2"/><circle cx="86" cy="90" r="4.2"/>
                <circle cx="62" cy="106" r="4.2"/><circle cx="78" cy="106" r="4.2"/>
              </g>
              <rect x="62" y="148" width="16" height="42" rx="4" fill="#b8b4a8"/>
              <rect x="59" y="182" width="22" height="28" rx="5" fill="#d6ff2f"/>
              <rect x="58" y="206" width="24" height="7" rx="2" fill="#f3f0e6"/>
            </g>
            <g class="splash-ball">
              <circle cx="210" cy="128" r="16" fill="#d6ff2f"/>
              <path d="M198 122c8 2 16 8 20 18" stroke="#111" stroke-width="2" fill="none"/>
            </g>
          </svg>
          <p>{site.name}</p>
        </div>
      </div>
    )}
    <nav>
      <div class="wrap">
        <a class="brand" href={page("")}>
          <img src={logo} alt={site.name} />
          PADEL FB
        </a>
        <ul class="nav-links">
          <li><a href={page("")} aria-current={path.endsWith("/Padel-FB/") || path.endsWith("/Padel-FB") ? "page" : undefined}>Inicio</a></li>
          <li class:list={["nav-item", { open: false }]}>
            <button class:list={["nav-trigger", { on: inLiga }]} type="button" data-nav-drop aria-expanded="false">Liga</button>
            <div class="nav-drop">
              <div class="nav-drop-inner">
                <a href={page("liga/")}>Resumen</a>
                <a href={page("ranking/")}>Ranking</a>
                <a href={page("fixture/")}>Fixture</a>
                <a href={page("resultados/")}>Resultados</a>
                <a href={page("fecha/")}>Fecha</a>
                <a href={page("sedes/")}>Sedes</a>
              </div>
            </div>
          </li>
          <li class="nav-item">
            <button class:list={["nav-trigger", { on: inAcademia }]} type="button" data-nav-drop aria-expanded="false">Academia</button>
            <div class="nav-drop">
              <div class="nav-drop-inner">
                <a href={page("academia/")}>Clases</a>
                <a href={page("academia/sedes/")}>Sedes</a>
              </div>
            </div>
          </li>
          <li><a href={page("torneos/")} class:list={[{ on: inTorneos }]} aria-current={inTorneos ? "page" : undefined}>Torneos</a></li>
        </ul>
        <div class="nav-actions">
          <a class="nav-cta nav-cta-ghost" href={page("admin/")}>Admin</a>
          <a class="nav-cta" href={page("inscripcion/")}>Sumate</a>
        </div>
        <button class="menu-btn" type="button" data-menu>Menu</button>
      </div>
    </nav>
    <slot />
    <footer>
      <div class="wrap">
        <div>
          <strong>{site.name.toUpperCase()} ® {site.year}</strong>
          <p>Liga, academia y torneos de pádel · {site.city}, {site.province}</p>
        </div>
        <div>
          <a href={site.instagram} target="_blank" rel="noreferrer">Instagram</a>
          ·
          <a href={page("inscripcion/")}>WhatsApp</a>
        </div>
      </div>
    </footer>
    <a class="wa" href={wa} title="WhatsApp" aria-label="WhatsApp" target="_blank" rel="noreferrer">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path fill="currentColor" d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
    </a>
    <script>
      document.querySelector("[data-menu]")?.addEventListener("click", () => {
        document.querySelector("nav")?.classList.toggle("open");
      });
      document.querySelectorAll("[data-nav-drop]").forEach((btn) => {
        btn.addEventListener("click", (e) => {
          e.preventDefault();
          e.stopPropagation();
          const item = btn.closest(".nav-item");
          const open = item?.classList.contains("open");
          document.querySelectorAll(".nav-item.open").forEach((el) => {
            if (el === item) return;
            el.classList.remove("open");
            el.querySelector("[data-nav-drop]")?.setAttribute("aria-expanded", "false");
          });
          if (item) {
            item.classList.toggle("open", !open);
            btn.setAttribute("aria-expanded", open ? "false" : "true");
          }
        });
      });
      document.querySelectorAll(".nav-item").forEach((item) => {
        item.addEventListener("click", (e) => e.stopPropagation());
      });
      document.addEventListener("click", () => {
        document.querySelectorAll(".nav-item.open").forEach((el) => {
          el.classList.remove("open");
          el.querySelector("[data-nav-drop]")?.setAttribute("aria-expanded", "false");
        });
      });
      const splash = document.getElementById("splash");
      if (splash && !sessionStorage.getItem("liga-fb-splash-v2")) {
        splash.hidden = false;
        sessionStorage.setItem("liga-fb-splash-v2", "1");
        setTimeout(() => {
          splash.classList.add("out");
          setTimeout(() => splash.remove(), 500);
        }, 1700);
      } else {
        splash?.remove();
      }
    </script>
  </body>
</html>
