---
import "../styles/global.css";
import { site } from "../data/site";
import { asset, page } from "../lib/paths";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
const path = Astro.url.pathname;
const wa = `https://wa.me/${site.whatsapp}`;
const logo = asset("images/Logo-FB-blanco-sin-fondo-02.png");
const publicOrigin = Astro.site || new URL("https://diazdiegok.github.io");
const canonicalUrl = new URL(path, publicOrigin).href;
const ogImage = new URL(asset("images/og-share.jpg"), publicOrigin).href;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
const isHome = path === basePath || path === `${basePath}/`;
const inLiga =
  path.includes("/ranking") ||
  path.includes("/fixture") ||
  path.includes("/resultados") ||
  path.includes("/playoff") ||
  path.includes("/ascensos") ||
  path.includes("/fecha") ||
  path.includes("/inscribir-pareja") ||
  (path.includes("/sedes") && !path.includes("/academia")) ||
  path.includes("/liga/");
const inAcademia = path.includes("/academia");
const inTorneos = path.includes("/torneos");
---
<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="FB Academia de pádel" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="es_AR" />
    <link rel="image_src" href={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href={logo} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&family=Oswald:wght@500;600&display=swap" rel="stylesheet" />
    <script is:inline>
      // Al recargar (F5) siempre arrancar arriba, salvo que la URL tenga un ancla (#id).
      if ("scrollRestoration" in history) history.scrollRestoration = "manual";
      if (!location.hash) {
        window.scrollTo(0, 0);
        window.addEventListener("pageshow", () => window.scrollTo(0, 0), { once: true });
      }
    </script>
  </head>
  <body class:list={["court", { "is-admin": noindex, "is-home": isHome }]}>
    <a class="skip-link" href="#main-content">Saltar al contenido</a>
    {!noindex && (
      <div class="splash" id="splash" hidden>
        <div class="splash-scene" aria-hidden="true">
          <svg class="splash-art" viewBox="-48 -8 520 268">
            <defs>
              <radialGradient id="splash-face" cx="36%" cy="30%" r="74%">
                <stop offset="0%" stop-color="#fffdf8" />
                <stop offset="58%" stop-color="#f2efe4" />
                <stop offset="100%" stop-color="#c9cebf" />
              </radialGradient>
              <linearGradient id="splash-frame" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="#4a5644" />
                <stop offset="38%" stop-color="#161b16" />
                <stop offset="100%" stop-color="#2c3628" />
              </linearGradient>
              <linearGradient id="splash-grip" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0%" stop-color="#0c0e0c" />
                <stop offset="42%" stop-color="#343c30" />
                <stop offset="100%" stop-color="#101410" />
              </linearGradient>
              <radialGradient id="splash-ballg" cx="32%" cy="28%" r="74%">
                <stop offset="0%" stop-color="#f7ffc8" />
                <stop offset="40%" stop-color="#d6ff2f" />
                <stop offset="100%" stop-color="#6d9010" />
              </radialGradient>
              <linearGradient id="splash-line" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0%" stop-color="#d6ff2f" stop-opacity="0" />
                <stop offset="50%" stop-color="#d6ff2f" stop-opacity="0.9" />
                <stop offset="100%" stop-color="#d6ff2f" stop-opacity="0" />
              </linearGradient>
            </defs>
            <path class="splash-baseline" d="M20 236 H430" />
            <ellipse cx="150" cy="228" rx="34" ry="4.5" fill="#000" opacity="0.35" />
            <g class="splash-paddle-ghost">
              <use href="#splash-racket" />
            </g>
            <g class="splash-paddle">
              <g id="splash-racket">
                <path fill="url(#splash-frame)" d="M138 154 L132 176 H168 L162 154 Z" />
                <circle cx="150" cy="92" r="76" fill="url(#splash-frame)" />
                <circle cx="150" cy="92" r="76" fill="none" stroke="#d6ff2f" stroke-width="2.4" />
                <circle cx="150" cy="92" r="63" fill="url(#splash-face)" />
                <circle cx="150" cy="92" r="63" fill="none" stroke="rgba(0,0,0,0.22)" stroke-width="2.5" />
                <path d="M104 62a74 74 0 0 1 92-22" fill="none" stroke="rgba(255,255,255,0.42)" stroke-width="2.2" stroke-linecap="round" />
                <g fill="#1a1f1a">
                  <circle cx="136" cy="44" r="1.45"/><circle cx="145" cy="44" r="1.45"/><circle cx="154" cy="44" r="1.45"/><circle cx="163" cy="44" r="1.45"/>
                  <circle cx="122.5" cy="53" r="1.45"/><circle cx="131.5" cy="53" r="1.45"/><circle cx="140.5" cy="53" r="1.45"/><circle cx="149.5" cy="53" r="1.45"/><circle cx="158.5" cy="53" r="1.45"/><circle cx="167.5" cy="53" r="1.45"/><circle cx="176.5" cy="53" r="1.45"/>
                  <circle cx="109" cy="62" r="1.45"/><circle cx="118" cy="62" r="1.45"/><circle cx="127" cy="62" r="1.45"/><circle cx="136" cy="62" r="1.45"/><circle cx="145" cy="62" r="1.45"/><circle cx="154" cy="62" r="1.45"/><circle cx="163" cy="62" r="1.45"/><circle cx="172" cy="62" r="1.45"/><circle cx="181" cy="62" r="1.45"/><circle cx="190" cy="62" r="1.45"/>
                  <circle cx="104.5" cy="71" r="1.45"/><circle cx="113.5" cy="71" r="1.45"/><circle cx="122.5" cy="71" r="1.45"/><circle cx="131.5" cy="71" r="1.45"/><circle cx="140.5" cy="71" r="1.45"/><circle cx="149.5" cy="71" r="1.45"/><circle cx="158.5" cy="71" r="1.45"/><circle cx="167.5" cy="71" r="1.45"/><circle cx="176.5" cy="71" r="1.45"/><circle cx="185.5" cy="71" r="1.45"/><circle cx="194.5" cy="71" r="1.45"/>
                  <circle cx="100" cy="80" r="1.45"/><circle cx="109" cy="80" r="1.45"/><circle cx="118" cy="80" r="1.45"/><circle cx="127" cy="80" r="1.45"/><circle cx="136" cy="80" r="1.45"/><circle cx="145" cy="80" r="1.45"/><circle cx="154" cy="80" r="1.45"/><circle cx="163" cy="80" r="1.45"/><circle cx="172" cy="80" r="1.45"/><circle cx="181" cy="80" r="1.45"/><circle cx="190" cy="80" r="1.45"/><circle cx="199" cy="80" r="1.45"/>
                  <circle cx="104.5" cy="89" r="1.45"/><circle cx="113.5" cy="89" r="1.45"/><circle cx="122.5" cy="89" r="1.45"/><circle cx="131.5" cy="89" r="1.45"/><circle cx="140.5" cy="89" r="1.45"/><circle cx="149.5" cy="89" r="1.45"/><circle cx="158.5" cy="89" r="1.45"/><circle cx="167.5" cy="89" r="1.45"/><circle cx="176.5" cy="89" r="1.45"/><circle cx="185.5" cy="89" r="1.45"/><circle cx="194.5" cy="89" r="1.45"/>
                  <circle cx="100" cy="98" r="1.45"/><circle cx="109" cy="98" r="1.45"/><circle cx="118" cy="98" r="1.45"/><circle cx="127" cy="98" r="1.45"/><circle cx="136" cy="98" r="1.45"/><circle cx="145" cy="98" r="1.45"/><circle cx="154" cy="98" r="1.45"/><circle cx="163" cy="98" r="1.45"/><circle cx="172" cy="98" r="1.45"/><circle cx="181" cy="98" r="1.45"/><circle cx="190" cy="98" r="1.45"/><circle cx="199" cy="98" r="1.45"/>
                  <circle cx="104.5" cy="107" r="1.45"/><circle cx="113.5" cy="107" r="1.45"/><circle cx="122.5" cy="107" r="1.45"/><circle cx="131.5" cy="107" r="1.45"/><circle cx="140.5" cy="107" r="1.45"/><circle cx="149.5" cy="107" r="1.45"/><circle cx="158.5" cy="107" r="1.45"/><circle cx="167.5" cy="107" r="1.45"/><circle cx="176.5" cy="107" r="1.45"/><circle cx="185.5" cy="107" r="1.45"/><circle cx="194.5" cy="107" r="1.45"/>
                  <circle cx="109" cy="116" r="1.45"/><circle cx="118" cy="116" r="1.45"/><circle cx="127" cy="116" r="1.45"/><circle cx="136" cy="116" r="1.45"/><circle cx="145" cy="116" r="1.45"/><circle cx="154" cy="116" r="1.45"/><circle cx="163" cy="116" r="1.45"/><circle cx="172" cy="116" r="1.45"/><circle cx="181" cy="116" r="1.45"/><circle cx="190" cy="116" r="1.45"/>
                  <circle cx="113.5" cy="125" r="1.45"/><circle cx="122.5" cy="125" r="1.45"/><circle cx="131.5" cy="125" r="1.45"/><circle cx="140.5" cy="125" r="1.45"/><circle cx="149.5" cy="125" r="1.45"/><circle cx="158.5" cy="125" r="1.45"/><circle cx="167.5" cy="125" r="1.45"/><circle cx="176.5" cy="125" r="1.45"/><circle cx="185.5" cy="125" r="1.45"/>
                  <circle cx="127" cy="134" r="1.45"/><circle cx="136" cy="134" r="1.45"/><circle cx="145" cy="134" r="1.45"/><circle cx="154" cy="134" r="1.45"/><circle cx="163" cy="134" r="1.45"/><circle cx="172" cy="134" r="1.45"/>
                </g>
                <rect x="141" y="174" width="18" height="40" rx="7" fill="url(#splash-grip)" />
                <rect x="141" y="174" width="18" height="4" rx="2" fill="#d6ff2f" />
                <g stroke="rgba(243,240,230,0.34)" stroke-width="1" stroke-linecap="round">
                  <path d="M144 184 H156" /><path d="M144 190 H156" /><path d="M144 196 H156" /><path d="M144 202 H156" /><path d="M144 208 H156" />
                </g>
                <rect x="137" y="210" width="26" height="8" rx="3" fill="#d6ff2f" />
              </g>
            </g>
            <g class="splash-ball">
              <ellipse class="splash-trail" cx="236" cy="98" rx="28" ry="7" />
              <circle cx="236" cy="98" r="14.5" fill="url(#splash-ballg)" />
              <path d="M226 91c7 3 12 9 15 16" fill="none" stroke="#24300a" stroke-width="1.25" stroke-linecap="round" opacity="0.5" />
              <path d="M246 90c-3 7-2 15 3 21" fill="none" stroke="#fff" stroke-width="1.1" stroke-linecap="round" opacity="0.5" />
              <ellipse cx="229" cy="91" rx="4.4" ry="2.6" fill="#fff" opacity="0.62" />
            </g>
            <circle class="splash-hit" cx="220" cy="98" r="8" />
            <circle class="splash-hit splash-hit-2" cx="220" cy="98" r="8" />
          </svg>
          <p class="splash-mark">PADEL <em>FB</em></p>
          <span class="splash-rule"></span>
          <p class="splash-sub">{site.city}, {site.province}</p>
        </div>
      </div>
    )}
    <slot name="splash" />
    {!noindex && (
      <nav aria-label="Navegación principal">
        <div class="wrap">
          <a class="brand" href={page("")}>
            <img src={logo} alt={site.name} />
            PADEL FB
          </a>
          <ul class="nav-links" id="site-menu">
            <li><a href={page("")} aria-current={isHome ? "page" : undefined}>Inicio</a></li>
            <li class:list={["nav-item", { open: false }]}>
              <button class:list={["nav-trigger", { on: inLiga }]} type="button" data-nav-drop aria-expanded="false">Liga</button>
              <div class="nav-drop">
                <div class="nav-drop-inner">
                  <a href={page("liga/")} aria-current={path.replace(/\/$/, "").endsWith("/liga") ? "page" : undefined}>Resumen</a>
                  <a href={page("inscribir-pareja/")} aria-current={path.includes("/inscribir-pareja") ? "page" : undefined}>Inscripciones de parejas</a>
                  <a href={page("fixture/")} aria-current={path.includes("/fixture") ? "page" : undefined}>Fixture</a>
                  <a href={page("resultados/")} aria-current={path.includes("/resultados") ? "page" : undefined}>Resultados</a>
                  <a href={page("ranking/")} aria-current={path.includes("/ranking") ? "page" : undefined}>Ranking</a>
                  <a href={page("playoff/")} aria-current={path.includes("/playoff") ? "page" : undefined}>Playoff</a>
                  <a href={page("ascensos/")} aria-current={path.includes("/ascensos") ? "page" : undefined}>Ascensos</a>
                  <a href={page("sedes/")} aria-current={path.includes("/sedes") && !path.includes("/academia") ? "page" : undefined}>Sedes</a>
                </div>
              </div>
            </li>
            <li class="nav-item">
              <button class:list={["nav-trigger", { on: inAcademia }]} type="button" data-nav-drop aria-expanded="false">Academia</button>
              <div class="nav-drop">
                <div class="nav-drop-inner">
                  <a href={page("academia/")} aria-current={path.replace(/\/$/, "").endsWith("/academia") ? "page" : undefined}>Resumen</a>
                  <a href={page("academia/inscripcion/")} aria-current={path.includes("/academia/inscripcion") ? "page" : undefined}>Inscripción</a>
                  <a href={page("academia/adultos/")} aria-current={path.includes("/academia/adultos") ? "page" : undefined}>Clases Adultos</a>
                  <a href={page("academia/infantiles/")} aria-current={path.includes("/infantiles") ? "page" : undefined}>Clases Infantiles</a>
                  <a href={page("academia/sedes/")} aria-current={path.includes("/academia/sedes") ? "page" : undefined}>Sedes</a>
                </div>
              </div>
            </li>
            <li><a href={page("torneos/")} class:list={[{ on: inTorneos }]} aria-current={inTorneos ? "page" : undefined}>Torneos</a></li>
          </ul>
          <div class="nav-actions">
            <button class="nav-cta nav-cta-ghost" type="button" id="nav-logout" hidden>Salir</button>
            <a class="nav-cta" href={page("inscripcion/")}>Sumate</a>
            <button class="menu-btn" type="button" data-menu aria-expanded="false" aria-controls="site-menu">Menu</button>
          </div>
        </div>
      </nav>
    )}
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    {!noindex && (
      <footer>
        <div class="wrap">
          <div>
            <strong>{site.name.toUpperCase()} ® <span data-year>{new Date().getFullYear()}</span></strong>
            <p>Liga, academia y torneos de pádel · {site.city}, {site.province}</p>
          </div>
          <div class="footer-links">
            <a href={site.instagram} target="_blank" rel="noreferrer">Instagram</a>
            <a href={wa} target="_blank" rel="noreferrer">WhatsApp</a>
          </div>
        </div>
      </footer>
    )}
    {!noindex && (
      <a class="wa" href={wa} title="WhatsApp" aria-label="WhatsApp" target="_blank" rel="noreferrer">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path fill="currentColor" d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
      </a>
    )}
    <script>
      const menuBtn = document.querySelector("[data-menu]");
      const siteNav = document.querySelector("nav");
      function closeMobileMenu() {
        siteNav?.classList.remove("open");
        menuBtn?.setAttribute("aria-expanded", "false");
      }
      const canHover = () => window.matchMedia("(hover: hover) and (pointer: fine)").matches;
      function clearDropPos(item) {
        const drop = item?.querySelector(".nav-drop");
        if (!drop) return;
        drop.classList.remove("is-fixed");
        drop.style.left = "";
        drop.style.top = "";
      }
      function placeDrop(item) {
        const drop = item?.querySelector(".nav-drop");
        const btn = item?.querySelector("[data-nav-drop]");
        if (!drop || !btn || !canHover() || siteNav?.classList.contains("open")) {
          clearDropPos(item);
          return;
        }
        const r = btn.getBoundingClientRect();
        drop.classList.add("is-fixed");
        drop.style.left = `${r.left + r.width / 2}px`;
        drop.style.top = `${r.bottom - 2}px`;
      }
      function closeNavDrops() {
        document.querySelectorAll(".nav-item.open").forEach((el) => {
          el.classList.remove("open");
          el.querySelector("[data-nav-drop]")?.setAttribute("aria-expanded", "false");
          clearDropPos(el);
        });
      }
      menuBtn?.addEventListener("click", (e) => {
        e.stopPropagation();
        const open = siteNav?.classList.toggle("open") || false;
        menuBtn.setAttribute("aria-expanded", String(open));
        if (!open) closeNavDrops();
      });
      document.querySelectorAll("[data-nav-drop]").forEach((btn) => {
        btn.addEventListener("click", (e) => {
          e.preventDefault();
          e.stopPropagation();
          /* En desktop el desplegable se abre con hover; el click es para mobile/touch. */
          if (canHover() && !siteNav?.classList.contains("open")) return;
          const item = btn.closest(".nav-item");
          const open = item?.classList.contains("open");
          document.querySelectorAll(".nav-item.open").forEach((el) => {
            if (el === item) return;
            el.classList.remove("open");
            el.querySelector("[data-nav-drop]")?.setAttribute("aria-expanded", "false");
            clearDropPos(el);
          });
          if (item) {
            item.classList.toggle("open", !open);
            btn.setAttribute("aria-expanded", open ? "false" : "true");
            if (!open) placeDrop(item);
            else clearDropPos(item);
          }
        });
        btn.addEventListener("keydown", (e) => {
          if (e.key === "ArrowDown") {
            e.preventDefault();
            const item = btn.closest(".nav-item");
            if (!item?.classList.contains("open")) {
              item?.classList.add("open");
              btn.setAttribute("aria-expanded", "true");
              placeDrop(item);
            }
            item?.querySelector(".nav-drop a")?.focus();
          }
        });
      });
      document.querySelectorAll(".nav-item").forEach((item) => {
        item.addEventListener("click", (e) => e.stopPropagation());
        const btn = item.querySelector("[data-nav-drop]");
        item.addEventListener("mouseenter", () => {
          if (!canHover() || siteNav?.classList.contains("open")) return;
          closeNavDrops();
          item.classList.add("open");
          btn?.setAttribute("aria-expanded", "true");
          placeDrop(item);
        });
        item.addEventListener("mouseleave", () => {
          if (!canHover() || siteNav?.classList.contains("open")) return;
          item.classList.remove("open");
          btn?.setAttribute("aria-expanded", "false");
          clearDropPos(item);
        });
      });
      siteNav?.querySelector(".nav-links")?.addEventListener("click", (e) => {
        e.stopPropagation();
      });
      window.addEventListener("scroll", () => {
        if (!canHover()) return;
        document.querySelectorAll(".nav-item.open").forEach((item) => placeDrop(item));
      }, { passive: true });
      window.addEventListener("resize", () => {
        document.querySelectorAll(".nav-item.open").forEach((item) => {
          if (canHover()) placeDrop(item);
          else clearDropPos(item);
        });
      });
      /* Cerrar al tocar el fondo oscuro o fuera del menú */
      document.addEventListener("click", (e) => {
        const t = e.target;
        if (!(t instanceof Element)) return;
        if (siteNav?.classList.contains("open") && !t.closest(".nav-links") && !t.closest("[data-menu]")) {
          closeMobileMenu();
          closeNavDrops();
          return;
        }
        if (!t.closest(".nav-item")) closeNavDrops();
      });
      document.addEventListener("keydown", (e) => {
        if (e.key !== "Escape") return;
        closeNavDrops();
        closeMobileMenu();
        menuBtn?.focus();
      });
      const AUTH_KEY = "liga-fb-admin-ok";
      const logoutBtn = document.getElementById("nav-logout");
      function adminLoggedIn() {
        try {
          const raw = localStorage.getItem(AUTH_KEY) || sessionStorage.getItem(AUTH_KEY);
          if (!raw) return false;
          const data = JSON.parse(raw);
          return !!(data?.token && data.exp && Date.now() <= data.exp);
        } catch {
          return false;
        }
      }
      if (logoutBtn) {
        logoutBtn.hidden = !adminLoggedIn();
        logoutBtn.addEventListener("click", () => {
          localStorage.removeItem(AUTH_KEY);
          sessionStorage.removeItem(AUTH_KEY);
          location.reload();
        });
      }
      const splash = document.getElementById("splash");
      document.querySelectorAll("[data-year]").forEach((el) => {
        el.textContent = String(new Date().getFullYear());
      });
      if (splash && document.body.classList.contains("is-home")) {
        splash.hidden = false;
        setTimeout(() => {
          splash.classList.add("out");
          setTimeout(() => splash.remove(), 560);
        }, 2500);
      } else {
        splash?.remove();
      }
    </script>
    <script is:inline define:vars={{ logoUrl: logo, seasonCode: site.currentSeason }}>
      // El clic a "inscribir pareja" es el gesto que el navegador pide para el audio.
      // El remate suena acá, con la pelota, y después se abre el formulario (sin pedirte otro toque).
      (() => {
        const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const seasonLabel = /^T\d+$/i.test(String(seasonCode || ""))
          ? "Temporada " + String(seasonCode).slice(1)
          : String(seasonCode || "");
        function smash(ctx) {
          const now = ctx.currentTime;
          const hit = now + 0.78;
          const whooshLen = 0.72;
          const noise = ctx.createBuffer(1, Math.floor(ctx.sampleRate * whooshLen), ctx.sampleRate);
          const data = noise.getChannelData(0);
          for (let i = 0; i < data.length; i++) data[i] = Math.random() * 2 - 1;
          const whoosh = ctx.createBufferSource();
          whoosh.buffer = noise;
          const band = ctx.createBiquadFilter();
          band.type = "bandpass";
          band.Q.value = 0.8;
          band.frequency.setValueAtTime(280, now);
          band.frequency.exponentialRampToValueAtTime(2400, hit);
          const whooshGain = ctx.createGain();
          whooshGain.gain.setValueAtTime(0.001, now);
          whooshGain.gain.exponentialRampToValueAtTime(0.16, hit - 0.04);
          whooshGain.gain.exponentialRampToValueAtTime(0.001, hit + 0.04);
          whoosh.connect(band);
          band.connect(whooshGain);
          whooshGain.connect(ctx.destination);
          whoosh.start(now);
          whoosh.stop(hit + 0.05);
          const crackLen = 0.09;
          const crackBuf = ctx.createBuffer(1, Math.floor(ctx.sampleRate * crackLen), ctx.sampleRate);
          const crackData = crackBuf.getChannelData(0);
          for (let i = 0; i < crackData.length; i++) {
            crackData[i] = (Math.random() * 2 - 1) * Math.exp(-i / (ctx.sampleRate * 0.012));
          }
          const crack = ctx.createBufferSource();
          crack.buffer = crackBuf;
          const high = ctx.createBiquadFilter();
          high.type = "highpass";
          high.frequency.value = 700;
          const crackGain = ctx.createGain();
          crackGain.gain.value = 0.62;
          crack.connect(high);
          high.connect(crackGain);
          crackGain.connect(ctx.destination);
          crack.start(hit);
          const body = ctx.createOscillator();
          body.type = "sine";
          body.frequency.setValueAtTime(210, hit);
          body.frequency.exponentialRampToValueAtTime(48, hit + 0.2);
          const bodyGain = ctx.createGain();
          bodyGain.gain.setValueAtTime(0.72, hit);
          bodyGain.gain.exponentialRampToValueAtTime(0.001, hit + 0.24);
          body.connect(bodyGain);
          bodyGain.connect(ctx.destination);
          body.start(hit);
          body.stop(hit + 0.26);
        }
        function isInscribe(href) {
          try {
            const url = new URL(href, location.href);
            if (url.origin !== location.origin) return false;
            return url.pathname.replace(/\/$/, "").endsWith("/inscribir-pareja");
          } catch {
            return false;
          }
        }
        let splashTimer = 0;
        function disarmPreSplash() {
          clearTimeout(splashTimer);
          splashTimer = 0;
        }
        function clearPreSplash() {
          disarmPreSplash();
          document.querySelectorAll("[data-insc-pre]").forEach((el) => el.remove());
        }
        // Al irse, solo se apaga el temporizador. Si se saca la pelota acá,
        // se ve la página de abajo hasta que carga la siguiente.
        window.addEventListener("pagehide", disarmPreSplash);
        window.addEventListener("pageshow", (e) => {
          if (e.persisted) clearPreSplash();
        });
        document.addEventListener("click", (e) => {
          if (reduce || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
          const a = e.target instanceof Element ? e.target.closest("a[href]") : null;
          if (!a || !isInscribe(a.href)) return;
          if (isInscribe(location.href)) return;
          e.preventDefault();
          const href = a.href;
          let left = false;
          const go = () => {
            if (left) return;
            left = true;
            disarmPreSplash();
            try { sessionStorage.setItem("fb-insc-smash", "1"); } catch {}
            location.href = href;
          };
          try { fetch(href, { credentials: "same-origin" }).catch(() => {}); } catch {}
          const splash = document.createElement("div");
          splash.className = "insc-splash play";
          splash.setAttribute("data-insc-pre", "1");
          splash.innerHTML =
            '<div class="insc-splash-stage"><span class="insc-ball"></span><span class="insc-shock"></span><span class="insc-mark"><span class="insc-mark-seam"></span><img class="insc-mark-logo" alt="" src="' +
            logoUrl +
            '"></span><p class="insc-splash-text">Inscripciones de parejas <em>· ' +
            seasonLabel +
            "</em></p></div>";
          document.body.appendChild(splash);
          try {
            const Ctx = window.AudioContext || window.webkitAudioContext;
            if (Ctx) {
              const ctx = new Ctx();
              ctx.resume().then(() => smash(ctx)).catch(() => {});
            }
          } catch {}
          splash.addEventListener("click", go, { once: true });
          splashTimer = setTimeout(go, 1900);
        }, true);
      })();
    </script>
    {!noindex && site.apiUrl && (
      <script define:vars={{ apiUrl: String(site.apiUrl || "").replace(/\/$/, ""), basePath }}>
        (() => {
          if (!apiUrl || typeof navigator === "undefined") return;
          const path = (location.pathname.replace(new RegExp("^" + basePath.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")), "") || "/") || "/";
          const day = new Date().toISOString().slice(0, 10);
          const key = `liga-fb-hit:${day}:${path}`;
          try {
            if (sessionStorage.getItem(key)) return;
            sessionStorage.setItem(key, "1");
          } catch {
            /* private mode */
          }
          const body = JSON.stringify({ path, ref: document.referrer || "" });
          const url = `${apiUrl}/hit`;
          // text/plain evita preflight; el worker parsea JSON igual
          try {
            if (navigator.sendBeacon?.(url, new Blob([body], { type: "text/plain" }))) return;
          } catch {
            /* fallback abajo */
          }
          fetch(url, {
            method: "POST",
            headers: { "Content-Type": "text/plain" },
            body,
            keepalive: true,
            mode: "cors",
          }).catch(() => {});
        })();
      </script>
    )}
  </body>
</html>
