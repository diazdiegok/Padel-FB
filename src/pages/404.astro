---
import Layout from "../layouts/Layout.astro";
import { asset, page } from "../lib/paths";

const racket = asset("images/splash-racket.png");
const ball = asset("images/splash-ball.png");
const logo = asset("images/Logo-FB-blanco-sin-fondo-02.png");
---

<Layout title="404 · Padel FB" description="Esa página no está en la cancha. Volvé al inicio de Padel FB." noindex={true}>
  <section class="miss court">
    <div class="miss-glow" aria-hidden="true"></div>
    <img class="miss-ball miss-ball-a" src={ball} alt="" aria-hidden="true" />
    <img class="miss-ball miss-ball-b" src={ball} alt="" aria-hidden="true" />
    <img class="miss-racket" src={racket} alt="" aria-hidden="true" />

    <div class="miss-copy wrap">
      <img class="miss-logo" src={logo} alt="Padel FB" />
      <p class="miss-kicker">Fuera de cancha</p>
      <h1>404</h1>
      <p class="miss-lead">Esa página no entró. La pelota se fue larga.</p>
      <div class="miss-actions">
        <a class="btn btn-lime" href={page("/")}>Volver al inicio</a>
        <a class="btn btn-ghost" href={page("/liga/")}>Ir a la liga</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .miss {
    position: relative;
    min-height: calc(100vh - var(--nav));
    display: grid;
    place-items: center;
    overflow: hidden;
    isolation: isolate;
    background:
      radial-gradient(ellipse 80% 55% at 50% 15%, rgba(214, 255, 47, 0.16), transparent 60%),
      linear-gradient(180deg, #0b120b 0%, #070907 55%, #050705 100%);
  }

  .miss-glow {
    position: absolute;
    inset: 18% 10% auto;
    height: 42%;
    background: radial-gradient(circle at 50% 40%, rgba(214, 255, 47, 0.22), transparent 70%);
    filter: blur(18px);
    z-index: 0;
    animation: miss-pulse 4.5s ease-in-out infinite;
  }

  .miss-copy {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 48px 0 72px;
    display: grid;
    gap: 10px;
    justify-items: center;
  }

  .miss-logo {
    width: min(180px, 46vw);
    margin-bottom: 8px;
    filter: drop-shadow(0 10px 28px rgba(214, 255, 47, 0.18));
  }

  .miss-kicker {
    color: var(--lime);
    font-family: var(--display);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-size: 13px;
  }

  .miss-copy h1 {
    font-family: var(--display);
    font-size: clamp(5.5rem, 22vw, 9rem);
    line-height: 0.9;
    letter-spacing: 0.04em;
    color: var(--cream);
    text-shadow: 0 0 40px rgba(214, 255, 47, 0.25);
  }

  .miss-lead {
    max-width: 28ch;
    color: var(--muted);
    font-size: clamp(1.05rem, 2.4vw, 1.25rem);
  }

  .miss-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
    margin-top: 18px;
  }

  .miss-racket {
    position: absolute;
    right: max(-40px, 4vw);
    bottom: 6%;
    width: min(340px, 48vw);
    z-index: 1;
    opacity: 0.88;
    transform: rotate(-18deg);
    filter: drop-shadow(0 24px 40px rgba(0, 0, 0, 0.55));
    animation: miss-sway 6s ease-in-out infinite;
  }

  .miss-ball {
    position: absolute;
    z-index: 1;
    width: min(72px, 14vw);
    filter: drop-shadow(0 10px 18px rgba(214, 255, 47, 0.35));
  }

  .miss-ball-a {
    left: 12%;
    top: 22%;
    animation: miss-bounce 2.8s ease-in-out infinite;
  }

  .miss-ball-b {
    left: 28%;
    bottom: 18%;
    width: min(48px, 10vw);
    opacity: 0.75;
    animation: miss-bounce 3.4s ease-in-out infinite 0.4s;
  }

  @keyframes miss-bounce {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-18px);
    }
  }

  @keyframes miss-sway {
    0%,
    100% {
      transform: rotate(-18deg) translateY(0);
    }
    50% {
      transform: rotate(-12deg) translateY(-10px);
    }
  }

  @keyframes miss-pulse {
    0%,
    100% {
      opacity: 0.7;
      transform: scale(1);
    }
    50% {
      opacity: 1;
      transform: scale(1.06);
    }
  }

  @media (max-width: 720px) {
    .miss-racket {
      width: min(220px, 58vw);
      right: -24px;
      bottom: 4%;
      opacity: 0.7;
    }
    .miss-ball-b {
      display: none;
    }
  }
</style>
