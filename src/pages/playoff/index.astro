---
import Layout from "../../layouts/Layout.astro";
import playoffJson from "../../data/playoff.json";
import { site } from "../../data/site";
import { seasonLabel } from "../../lib/liga.js";
import { normalizePlayoffs, playoffSlug, resolveCategory } from "../../lib/playoff.js";
import { page } from "../../lib/paths";

const current = String(site.currentSeason || "").trim().toUpperCase();
const playoffs = normalizePlayoffs(playoffJson)
  .filter((p) => p.categories.length)
  .map((p) => {
    const categories = p.categories.map(resolveCategory);
    const champions = categories.filter((c) => c.champion).length;
    const live = p.temp === current;
    const done = champions > 0 && champions === categories.length;
    return {
      ...p,
      count: categories.length,
      done,
      live,
      label: done ? "Finalizado" : live ? "En juego" : "Histórico",
      href: page(`playoff/${playoffSlug(p.temp)}/`),
      heading: `Playoff ${seasonLabel(p.temp)} 🎾`,
    };
  });
---
<Layout title="Playoff | Padel FB" description={`Cuadros e historial de playoff de cada temporada de Padel FB en ${site.city}.`}>
  <div class="wrap">
    <header class="page-hero">
      <p class="kicker">Liga</p>
      <h1>Playoff</h1>
      <p>Historial de cuadros. Cada temporada queda guardada con su fecha, cruces, resultados y campeones.</p>
    </header>

    {playoffs.length === 0 ? (
      <p class="empty" style="display:block;padding:48px 0">Todavía no hay playoff publicados.</p>
    ) : (
      <div class="hub-grid" style="grid-template-columns: repeat(auto-fill, minmax(220px, 1fr))">
        {playoffs.map((p) => (
          <a class="hub-card" href={p.href}>
            <div class="hub-card-top">
              <p class="kicker" style="margin:0">{p.dates || seasonLabel(p.temp)}</p>
              <span class:list={["hub-tag", { live: p.live && !p.done, done: p.done }]}>{p.label}</span>
            </div>
            <h2>{p.heading}</h2>
            <p>{p.count} categorí{p.count === 1 ? "a" : "as"}</p>
          </a>
        ))}
      </div>
    )}
  </div>
</Layout>
