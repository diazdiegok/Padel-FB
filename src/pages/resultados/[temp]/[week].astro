---
import Layout from "../../../layouts/Layout.astro";
import BackNav from "../../../components/BackNav.astro";
import fixture from "../../../data/fixture.json";
import results from "../../../data/results.json";
import { site } from "../../../data/site";
import { combineResults, matchAnchor, seasonLabel, seasonSlug, weekSlug } from "../../../lib/liga.js";
import { CATS, sortCats } from "../../../lib/disponibilidad.js";
import { describeResult } from "../../../lib/scoring.js";
import { page } from "../../../lib/paths";

export function getStaticPaths() {
  const DAY_ORDER = ["lunes", "martes", "miércoles", "miercoles", "jueves", "viernes", "sábado", "sabado", "domingo"];
  const dayIdx = (d) => {
    const i = DAY_ORDER.indexOf(String(d || "").trim().toLowerCase());
    return i < 0 ? 99 : i;
  };
  const matches = combineResults(results, fixture.filter((m) => m.home && m.away)).sort((a, b) => {
    const da = dayIdx(a.day);
    const db = dayIdx(b.day);
    if (da !== db) return da - db;
    return String(a.time || "").localeCompare(String(b.time || ""), "es");
  });
  const seasons = [...new Set(matches.map((m) => m.temp || site.currentSeason || "T4"))];
  const paths = [];
  for (const temp of seasons) {
    const list = matches.filter((m) => (m.temp || site.currentSeason || "T4") === temp);
    const weeks = [...new Set(list.map((m) => m.week || "Sin fecha"))];
    for (const week of weeks) {
      paths.push({
        params: { temp: seasonSlug(temp), week: weekSlug(week) },
        props: { tempCode: temp, weekLabel: week },
      });
    }
  }
  return paths;
}

const { tempCode, weekLabel } = Astro.props;
const DAY_ORDER = ["lunes", "martes", "miércoles", "miercoles", "jueves", "viernes", "sábado", "sabado", "domingo"];
const dayIdx = (d: string) => {
  const i = DAY_ORDER.indexOf(String(d || "").trim().toLowerCase());
  return i < 0 ? 99 : i;
};
const list = combineResults(results, fixture.filter((m: any) => m.home && m.away))
  .filter((m) => (m.temp || site.currentSeason || "T4") === tempCode && (m.week || "Sin fecha") === weekLabel)
  .sort((a, b) => {
    const da = dayIdx(a.day);
    const db = dayIdx(b.day);
    if (da !== db) return da - db;
    return String(a.time || "").localeCompare(String(b.time || ""), "es");
  })
  .map((m) => {
    const info = describeResult(m.result);
    return {
      ...m,
      anchor: matchAnchor(m),
      scoreText: info?.score || "",
      setsLabel: info?.label || "",
      homeWin: info ? !!info.homeWin : null,
      homePts: info?.homePts ?? null,
      awayPts: info?.awayPts ?? null,
    };
  });
const title = seasonLabel(tempCode);
const seasonHref = page(`resultados/${seasonSlug(tempCode)}/`);
const days = [...new Set(list.map((m) => m.day).filter(Boolean))].sort((a, b) => dayIdx(a) - dayIdx(b));
const cats = sortCats(list.map((m) => m.cat));
const courts = [...new Set(list.map((m) => m.venue).filter(Boolean))].sort((a, b) => a.localeCompare(b, "es"));
---
<Layout title={`${weekLabel} · ${title} | Padel FB`} description={`Resultados de ${weekLabel} · ${title}.`}>
  <div class="wrap">
    <header class="page-hero">
      <BackNav crumbs={[
        { label: title, href: `resultados/${seasonSlug(tempCode)}/` },
        { label: "Resultados", href: "resultados/" },
        { label: "Liga", href: "liga/" },
      ]} />
      <p class="kicker">{title} · {list.length} partido{list.length === 1 ? "" : "s"}</p>
      <h1>{weekLabel}</h1>
      <p>Resultados de la jornada.</p>
    </header>

    {list.length > 0 && (
      <div class="filters fixture-filters">
        <input class="search" id="q" type="search" placeholder="Buscar pareja o jugador…" autocomplete="off" />
        <div class="filter-group">
          <span>Día</span>
          <div class="pills" id="f-days">
            <button class="pill on" data-day="Todas" type="button">Todos</button>
            {days.map((d) => (
              <button class="pill" data-day={d} type="button">{d}</button>
            ))}
          </div>
        </div>
        <div class="filter-group">
          <span>Categoría</span>
          <div class="pills" id="f-cats">
            <button class="pill on" data-cat="Todas" type="button">Todas</button>
            {cats.map((c) => (
              <button class="pill" data-cat={c} type="button">{c}</button>
            ))}
          </div>
        </div>
        <div class="filter-group">
          <span>Cancha</span>
          <div class="pills" id="f-courts">
            <button class="pill on" data-court="Todas" type="button">Todas</button>
            {courts.map((c) => (
              <button class="pill" data-court={c} type="button">{c}</button>
            ))}
          </div>
        </div>
        <span class="tag" id="count"></span>
      </div>
    )}
    <div id="result-root" class="result-panel"></div>
    <p class="empty" id="empty" hidden>No hay partidos con ese filtro.</p>
  </div>

  <script define:vars={{ list, weekLabel, catOrder: CATS }}>
    const root = document.querySelector("#result-root");
    const empty = document.querySelector("#empty");
    const count = document.querySelector("#count");
    const q = document.querySelector("#q");
    if (!root) throw new Error("resultados week");
    let day = "Todas";
    let cat = "Todas";
    let court = "Todas";
    function esc(s) {
      return String(s ?? "").replace(/[&<>"']/g, (c) =>
        ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c])
      );
    }
    function fold(s) {
      return String(s || "")
        .toLowerCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "");
    }
    const played = (m) => m.homeWin === true || m.homeWin === false;
    function card(m) {
      const known = played(m);
      return `<article class="fixture-row" id="${esc(m.anchor)}">
        <div class="fixture-meta">
          <span>${esc(m.day || m.date)}</span>
          <span>${esc(m.time)}</span>
          <span>${esc(m.venue)}${m.court ? ` · ${esc(m.court)}` : ""}</span>
        </div>
        <div class="fixture-vs">
          <div class="pair pair-a${m.homeWin ? " winner" : known ? " loser" : ""}">
            <span class="pair-label">Pareja 1</span>
            <strong>${esc(m.home)}</strong>
            ${m.homeWin ? `<span class="pair-won">Ganó</span>` : ""}
            ${known ? `<span class="pair-pts">${m.homePts} pts</span>` : ""}
          </div>
          <span class="vs">vs</span>
          <div class="pair pair-b${known && !m.homeWin ? " winner" : known ? " loser" : ""}">
            <span class="pair-label">Pareja 2</span>
            <strong>${esc(m.away)}</strong>
            ${known && !m.homeWin ? `<span class="pair-won">Ganó</span>` : ""}
            ${known ? `<span class="pair-pts">${m.awayPts} pts</span>` : ""}
          </div>
        </div>
        <div class="fixture-score">${
          known
            ? `<b>${esc(m.scoreText)}</b><span>${esc(m.setsLabel)}</span>`
            : m.result
              ? `<b>${esc(m.result)}</b>`
              : `<span class="tag">Pendiente</span>`
        }</div>
      </article>`;
    }
    function render() {
      const term = fold((q?.value || "").trim());
      const rows = list.filter((m) => {
        const okDay = day === "Todas" || m.day === day;
        const okCat = cat === "Todas" || m.cat === cat;
        const okCourt = court === "Todas" || m.venue === court;
        const blob = fold([m.home, m.away].filter(Boolean).join(" "));
        return okDay && okCat && okCourt && (!term || blob.includes(term));
      });
      const rank = (name) => {
        const i = catOrder.indexOf(name);
        return i < 0 ? catOrder.length + 1 : i;
      };
      const groups = [...new Set(rows.map((m) => m.cat || "Sin categoría"))].sort(
        (a, b) => rank(a) - rank(b) || a.localeCompare(b, "es")
      );
      root.innerHTML = rows.length
        ? `<section class="fixture-week" style="padding-top:0">
            ${groups
              .map((name) => {
                const games = rows.filter((m) => (m.cat || "Sin categoría") === name);
                return `<h3 class="kicker" style="margin:18px 0 10px">${esc(name)}</h3>
                  <div class="fixture-list">${games.map(card).join("")}</div>`;
              })
              .join("")}
          </section>`
        : "";
      if (empty) empty.hidden = rows.length > 0;
      if (count) count.textContent = rows.length + (rows.length === 1 ? " partido" : " partidos");
    }
    function bind(selector, key, setter) {
      document.querySelectorAll(selector).forEach((btn) => {
        btn.addEventListener("click", () => {
          document.querySelectorAll(selector).forEach((b) => b.classList.remove("on"));
          btn.classList.add("on");
          setter(btn.dataset[key]);
          render();
        });
      });
    }
    q?.addEventListener("input", render);
    bind("#f-days .pill", "day", (v) => { day = v; });
    bind("#f-cats .pill", "cat", (v) => { cat = v; });
    bind("#f-courts .pill", "court", (v) => { court = v; });
    render();
    const hash = decodeURIComponent(location.hash || "").replace(/^#/, "");
    if (hash) {
      const el = document.getElementById(hash);
      if (el) {
        el.classList.add("is-target");
        const head = el.closest(".fixture-list")?.previousElementSibling;
        (head || el).scrollIntoView({ block: "start" });
      }
    }
  </script>
</Layout>
