---
import Layout from "../../layouts/Layout.astro";
import BackNav from "../../components/BackNav.astro";
import { page } from "../../lib/paths";
import { site } from "../../data/site";

const links = [
  { href: "academia/inscripcion/", title: "Inscripción", text: "Anotate a las clases de adultos o infantiles." },
  { href: "academia/adultos/", title: "Clases Adultos", text: "Entrenamiento, equipo y programas." },
  { href: "academia/infantiles/", title: "Clases Infantiles", text: "Academia para los más chicos." },
  { href: "academia/sedes/", title: "Sedes", text: "Complejos donde se entrenan adultos y niños." },
];
---
<Layout
  title={`Academia | Padel FB`}
  description={`Clases de adultos e infantiles de la Academia FB en ${site.city}.`}
>
  <div class="wrap">
    <header class="page-hero">
      <BackNav crumbs={[{ label: "Inicio", href: "" }]} />
      <p class="kicker">Academia FB</p>
      <h1>Academia</h1>
      <p>Clases de adultos e infantiles, inscripción y sedes donde se entrena.</p>
    </header>

    <div class="hub-grid hub-fill">
      {links.map((l) => (
        <a class="hub-card" href={page(l.href)}>
          <p class="kicker" style="margin:0">{l.title}</p>
          <h2>{l.title}</h2>
          <p>{l.text}</p>
        </a>
      ))}
    </div>
  </div>
</Layout>
