---
import Layout from "../../layouts/Layout.astro";
import { site } from "../../data/site";
import { asset, page } from "../../lib/paths";
import VenueLinks from "../../components/VenueLinks.astro";

const kids = site.kids || {};
const titleLines = String(kids.title || "Clases infantiles").split("\n");
const staff = (site.staff || []).find((p) => p.id === kids.profeId) || (site.staff || []).find((p) => /barrionuevo/i.test(p.name || ""));
const features = kids.features || [];

function venueKey(s) {
  return String(s || "")
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/club|padel/g, "")
    .replace(/[^a-z0-9]/g, "");
}

const seen = new Set();
const kidsVenues = [];
for (const g of kids.groups || []) {
  const name = String(g.venue || "").trim();
  if (!name) continue;
  const key = venueKey(name);
  if (!key || seen.has(key)) continue;
  seen.add(key);
  const match = (site.venues || []).find((v) => {
    const vk = venueKey(v.name);
    return vk && (vk === key || vk.includes(key) || key.includes(vk));
  });
  kidsVenues.push(match || { name, id: key });
}
---
<Layout
  title="Clases infantiles | Padel FB"
  description={`Academia infantil FB en ${site.city}. ${kids.age || "De 7 a 13 años"}. ${kids.intro || ""}`}
>
  <div class="wrap">
    <header class="page-hero">
      <p class="kicker">{kids.kicker || "Academia infantil"}</p>
      <h1>
        {titleLines.map((line, i) => (
          <>{i > 0 && <br />}{line}</>
        ))}
      </h1>
      {kids.age && <p class="staff-role" style="margin-top:12px">{kids.age}</p>}
      <p>{kids.intro}</p>
      {features.length > 0 && (
        <ul class="staff-bullets" style="margin-top:18px">
          {features.map((f) => <li>{f}</li>)}
        </ul>
      )}
      <div class="actions">
        <a class="btn btn-lime" href={page("inscripcion/")}>Inscripción</a>
      </div>
    </header>
  </div>

  {staff && (
    <section>
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="kicker">Equipo</p>
            <h2>Con quién entrenan</h2>
          </div>
        </div>
        <div class="staff-list">
          <article class="staff-card">
            {staff.image && <img class="staff-photo" src={asset(staff.image)} alt={staff.name} />}
            <div>
              <p class="staff-role">{kids.profeRole || staff.role}</p>
              <h2>{staff.name}</h2>
              {staff.bio && <p class="lead" style="white-space:pre-line">{staff.bio}</p>}
              {staff.bullets?.length > 0 && (
                <ul class="staff-bullets">
                  {staff.bullets.map((b) => <li>{b}</li>)}
                </ul>
              )}
            </div>
          </article>
        </div>
      </div>
    </section>
  )}

  {kidsVenues.length > 0 && (
    <section style="padding-top:0">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="kicker">Sedes</p>
            <h2>Dónde pueden entrenar</h2>
          </div>
        </div>
        {kidsVenues.map((v) => (
          <article class="venue sede-grid" id={v.id} style="margin-bottom:28px">
            <div class="venue-photo">
              {v.image && <img class="photo" src={asset(v.image)} alt={v.name} />}
              <span>{v.name}</span>
            </div>
            <div class="venue-body">
              <h2>{v.name}</h2>
              {v.address && <p>{v.address}</p>}
              {v.city && <p>{v.city}</p>}
              {v.type && <p>{v.type}</p>}
              {v.maps && <VenueLinks maps={v.maps} instagram={v.instagram} whatsapp={v.whatsapp} />}
            </div>
          </article>
        ))}
      </div>
    </section>
  )}
</Layout>
