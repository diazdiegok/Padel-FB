---
import Layout from "../../layouts/Layout.astro";
import { site } from "../../data/site";
import { asset, page } from "../../lib/paths";

const kids = site.kids || {};
const titleLines = String(kids.title || "Clases infantiles").split("\n");
const staff = (site.staff || []).find((p) => p.id === kids.profeId) || (site.staff || []).find((p) => /barrionuevo/i.test(p.name || ""));
const groups = kids.groups || [];
const prices = kids.prices || [];
const features = kids.features || [];
---
<Layout
  title="Clases infantiles | Padel FB"
  description={`Academia infantil FB en ${site.city}. ${kids.age || "De 7 a 13 años"}. ${kids.intro || ""}`}
>
  <div class="wrap">
    <header class="page-hero">
      <p class="kicker">{kids.kicker || "Academia infantil"}</p>
      <h1>
        {titleLines.map((line, i) => (
          <>{i > 0 && <br />}{line}</>
        ))}
      </h1>
      {kids.age && <p class="staff-role" style="margin-top:12px">{kids.age}</p>}
      <p>{kids.intro}</p>
      {features.length > 0 && (
        <ul class="staff-bullets" style="margin-top:18px">
          {features.map((f) => <li>{f}</li>)}
        </ul>
      )}
      <div class="actions">
        <a class="btn btn-lime" href={page("inscripcion/")}>{kids.cta || "Quiero clases"}</a>
        <a class="btn btn-ghost" href={page("academia/")}>Clases adultos</a>
      </div>
    </header>
  </div>

  {staff && (
    <section>
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="kicker">Equipo</p>
            <h2>Con quién entrenan</h2>
          </div>
        </div>
        <div class="staff-list">
          <article class="staff-card">
            {staff.image && <img class="staff-photo" src={asset(staff.image)} alt={staff.name} />}
            <div>
              <p class="staff-role">{kids.profeRole || staff.role}</p>
              <h2>{staff.name}</h2>
              {staff.bio && <p class="lead" style="white-space:pre-line">{staff.bio}</p>}
              {staff.bullets?.length > 0 && (
                <ul class="staff-bullets">
                  {staff.bullets.map((b) => <li>{b}</li>)}
                </ul>
              )}
            </div>
          </article>
        </div>
      </div>
    </section>
  )}

  {groups.length > 0 && (
    <section style="padding-top:0">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="kicker">Horarios</p>
            <h2>Dónde y cuándo</h2>
          </div>
        </div>
        <div class="class-grid">
          {groups.map((g) => (
            <article class="class-card">
              <h3>{g.venue}</h3>
              {g.when && <p class="class-place">{g.when}</p>}
              {(g.rows || []).length > 0 && (
                <div class="class-rows">
                  {g.rows.map((row) => (
                    <div class="class-row">
                      <strong>{row.time}</strong>
                      <span>{row.level}</span>
                    </div>
                  ))}
                </div>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {prices.length > 0 && (
    <section style="padding-top:0">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="kicker">Clases mensuales</p>
            <h2>Valores</h2>
          </div>
        </div>
        <div class="class-grid">
          {prices.map((p) => (
            <article class="class-card">
              <h3>{p.amount}</h3>
              <p class="class-place">{p.text}</p>
            </article>
          ))}
        </div>
        <div class="actions" style="margin-top:28px">
          <a class="btn btn-lime" href={page("inscripcion/")}>Reservar por WhatsApp</a>
        </div>
      </div>
    </section>
  )}
</Layout>
