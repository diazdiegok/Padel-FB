---
import Layout from "../../layouts/Layout.astro";
import BackNav from "../../components/BackNav.astro";
import { page } from "../../lib/paths";
import { site } from "../../data/site";
import playoffJson from "../../data/playoff.json";
import { normalizePlayoffs } from "../../lib/playoff.js";

const playoffOn = normalizePlayoffs(playoffJson).some((p) => p.categories.length);
const links = [
  { href: "inscribir-pareja/", title: "Inscripciones de parejas", text: "Contactos, categoría y disponibilidad de la temporada." },
  { href: "fixture/", title: "Fixture", text: "Partidos semanales de la temporada." },
  { href: "resultados/", title: "Resultados", text: "Resultados cargados de cada fecha." },
  { href: "ranking/", title: "Ranking", text: "Tabla por categoría y temporada." },
  ...(playoffOn ? [{ href: "playoff/", title: "Playoff", text: "Historial de cuadros por temporada." }] : []),
  { href: "ascensos/", title: "Ascensos", text: "Fotos de los ascensos de cada temporada." },
  { href: "sedes/", title: "Sedes", text: "Canchas oficiales de la liga." },
];
---
<Layout
  title={`Padel FB | Competí en ${site.city}`}
  description="Ranking, fixture, resultados e inscripciones de Padel FB en Paraná."
>
  <div class="wrap">
    <header class="page-hero">
      <BackNav crumbs={[{ label: "Inicio", href: "" }]} />
      <p class="kicker">Liga · temporada {site.currentSeason}</p>
      <h1>Liga</h1>
      <p>Todo lo de la competencia: ranking, partidos, resultados e inscripciones.</p>
    </header>

    <div class="hub-grid hub-fill">
      {links.map((l) => (
        <a class="hub-card" href={page(l.href)}>
          <p class="kicker" style="margin:0">{l.title}</p>
          <h2>{l.title}</h2>
          <p>{l.text}</p>
        </a>
      ))}
    </div>
  </div>
</Layout>
