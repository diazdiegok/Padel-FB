---
import Layout from "../../layouts/Layout.astro";
import { site } from "../../data/site";
import { page } from "../../lib/paths";

const t = site.torneos || {};
const items = t.items || [];
---
<Layout
  title="Torneos | Padel FB"
  description={`Torneos de Padel FB en ${site.city}.`}
>
  <div class="wrap">
    <header class="page-hero">
      <p class="kicker">{t.kicker || "Torneos"}</p>
      <h1>{t.title || "Torneos"}</h1>
      <p>{t.intro}</p>
    </header>

    {items.length > 0 ? (
      <div class="staff-list" style="padding-bottom:64px">
        {items.map((item) => (
          <article class="staff-card">
            <div>
              {item.kicker && <p class="staff-role">{item.kicker}</p>}
              <h2>{item.title}</h2>
              {item.when && <p class="lead">{item.when}</p>}
              {item.text && <p>{item.text}</p>}
            </div>
          </article>
        ))}
      </div>
    ) : (
      <div class="coming">
        <p class="kicker" style="margin:0 0 12px">{t.emptyKicker || "En preparación"}</p>
        <h2 style="margin-bottom:12px">{t.emptyTitle || "Sin torneos por ahora"}</h2>
        <p style="margin:0 0 24px">{t.emptyText}</p>
        <div class="actions" style="margin:0">
          <a class="btn btn-ghost" href={page("liga/")}>Ir a la liga</a>
          <a class="btn btn-lime" href={page("inscripcion/")}>Consultar por WhatsApp</a>
        </div>
      </div>
    )}
  </div>
</Layout>
