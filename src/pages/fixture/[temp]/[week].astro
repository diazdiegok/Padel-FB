---
import Layout from "../../../layouts/Layout.astro";
import BackNav from "../../../components/BackNav.astro";
import fixture from "../../../data/fixture.json";
import results from "../../../data/results.json";
import { site } from "../../../data/site";
import { isPendingMatch, isRealPairMatch } from "../../../lib/fixturer.js";
import { combineResults, seasonLabel, seasonSlug, weekSlug } from "../../../lib/liga.js";
import { page } from "../../../lib/paths";

const fxVisible = ((fixture as any[]) || []).filter((m) => isRealPairMatch(m) || isPendingMatch(m));

export function getStaticPaths() {
  const DAY_ORDER = ["lunes", "martes", "miércoles", "miercoles", "jueves", "viernes", "sábado", "sabado", "domingo"];
  const dayIdx = (d) => {
    const i = DAY_ORDER.indexOf(String(d || "").trim().toLowerCase());
    return i < 0 ? 99 : i;
  };
  const live = ((fixture as any[]) || []).filter((m) => isRealPairMatch(m) || isPendingMatch(m));
  const matches = combineResults(results, live).sort((a, b) => {
    const da = dayIdx(a.day);
    const db = dayIdx(b.day);
    if (da !== db) return da - db;
    return String(a.time || "").localeCompare(String(b.time || ""), "es");
  });
  const seasons = [...new Set(matches.map((m) => m.temp || site.currentSeason || "T4"))];
  const paths = [];
  for (const temp of seasons) {
    const list = matches.filter((m) => (m.temp || site.currentSeason || "T4") === temp);
    const weeks = [...new Set(list.map((m) => m.week || "Sin fecha"))];
    for (const week of weeks) {
      paths.push({
        params: { temp: seasonSlug(temp), week: weekSlug(week) },
        props: { tempCode: temp, weekLabel: week },
      });
    }
  }
  return paths;
}

const { tempCode, weekLabel } = Astro.props;
const DAY_ORDER = ["lunes", "martes", "miércoles", "miercoles", "jueves", "viernes", "sábado", "sabado", "domingo"];
const dayIdx = (d: string) => {
  const i = DAY_ORDER.indexOf(String(d || "").trim().toLowerCase());
  return i < 0 ? 99 : i;
};
const list = combineResults(results, fxVisible)
  .filter((m) => (m.temp || site.currentSeason || "T4") === tempCode && (m.week || "Sin fecha") === weekLabel)
  .sort((a, b) => {
    const da = dayIdx(a.day);
    const db = dayIdx(b.day);
    if (da !== db) return da - db;
    return String(a.time || "").localeCompare(String(b.time || ""), "es");
  });
const title = seasonLabel(tempCode);
const seasonHref = page(`fixture/${seasonSlug(tempCode)}/`);
const days = [...new Set(list.map((m) => m.day).filter(Boolean))].sort((a, b) => dayIdx(a) - dayIdx(b));
const cats = [...new Set(list.map((m) => m.cat).filter(Boolean))].sort((a, b) => a.localeCompare(b, "es"));
const courts = [...new Set(list.map((m) => m.venue).filter(Boolean))].sort((a, b) => a.localeCompare(b, "es"));
---
<Layout title={`${weekLabel} · Fixture ${title} | Padel FB`} description={`Partidos de ${weekLabel} · ${title}.`}>
  <div class="wrap">
    <header class="page-hero fixture-week-hero">
      <BackNav crumbs={[
        { label: title, href: `fixture/${seasonSlug(tempCode)}/` },
        { label: "Fixture", href: "fixture/" },
        { label: "Liga", href: "liga/" },
      ]} />
      <div class="fixture-week-top">
        <div>
          <p class="kicker">Fixture · {title}</p>
          <h1>{weekLabel}</h1>
          <p>Partidos de la jornada. Si ves <strong>Por cubrir</strong>, una pareja de la misma categoría puede anotarse desde acá.</p>
        </div>
        {list.length > 0 && (
          <div class="fixture-dl">
            <label for="fx-public-dl-sort">Descargar Excel</label>
            <select id="fx-public-dl-sort" aria-label="Orden del Excel">
              <option value="complejo">Por complejo</option>
              <option value="fecha">Por fecha</option>
              <option value="pareja">Por pareja</option>
            </select>
            <button class="btn btn-ghost" type="button" id="fx-public-dl">Bajar</button>
          </div>
        )}
      </div>
    </header>

    {list.length === 0 ? (
      <p class="empty" style="display:block;padding:48px 0">Todavía no hay partidos fixtureados en esta fecha.</p>
    ) : (
      <>
        <div class="filters fixture-filters">
          <input class="search" id="q" type="search" placeholder="Buscar pareja o jugador…" autocomplete="off" />
          <div class="filter-group">
            <span>Día</span>
            <div class="pills" id="f-days">
              <button class="pill on" data-day="Todas" type="button">Todos</button>
              {days.map((d) => (
                <button class="pill" data-day={d} type="button">{d}</button>
              ))}
            </div>
          </div>
          <div class="filter-group">
            <span>Categoría</span>
            <div class="pills" id="f-cats">
              <button class="pill on" data-cat="Todas" type="button">Todas</button>
              {cats.map((c) => (
                <button class="pill" data-cat={c} type="button">{c}</button>
              ))}
            </div>
          </div>
          <div class="filter-group">
            <span>Cancha</span>
            <div class="pills" id="f-courts">
              <button class="pill on" data-court="Todas" type="button">Todas</button>
              {courts.map((c) => (
                <button class="pill" data-court={c} type="button">{c}</button>
              ))}
            </div>
          </div>
          <span class="tag" id="count"></span>
        </div>
        <div id="fixture-root"></div>
        <p class="empty" id="empty" hidden>No hay partidos con ese filtro.</p>
      </>
    )}

  </div>

  <script>
    import { describeResult } from "../../../lib/scoring.js";
    window.__ligaScoring = { describeResult };
  </script>
  <script define:vars={{
    matches: list,
    apiUrl: String(site.apiUrl || "").replace(/\/$/, ""),
    tempCode,
    weekLabel,
  }}>
    const q = document.querySelector("#q");
    const root = document.querySelector("#fixture-root");
    const empty = document.querySelector("#empty");
    const count = document.querySelector("#count");
    if (!root) throw new Error("fixture week");

    let day = "Todas";
    let cat = "Todas";
    let court = "Todas";
    /** @type {Record<string, {id:string,label:string,pj:number}[]>} */
    let candidatesByKey = {};
    let pendingLoaded = false;

    function esc(s) {
      return String(s ?? "").replace(/[&<>"']/g, (c) =>
        ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c])
      );
    }
    const describeResult = (raw) => window.__ligaScoring?.describeResult?.(raw) || null;
    function fold(s) {
      return String(s || "")
        .toLowerCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "");
    }
    function isOpen(m) {
      return !!(m.pending || m.away === "Pendiente / Pendiente");
    }
    function matchKey(m) {
      return `${m.temp || tempCode}|${m.week || weekLabel}|${m.cat || ""}|${m.home || ""}`;
    }

    function coverBox(m) {
      if (!isOpen(m)) return "";
      const key = matchKey(m);
      const options = candidatesByKey[key] || [];
      const opts = options.length
        ? options.map((c) => `<option value="${esc(c.id)}">${esc(c.label)} (${c.pj} PJ)</option>`).join("")
        : `<option value="" disabled>${pendingLoaded ? "No hay parejas disponibles en esta categoría" : "Cargando parejas…"}</option>`;
      return `<form class="fixture-cover" data-cover-key="${esc(key)}" data-home="${esc(m.home)}" data-cat="${esc(m.cat)}" data-week="${esc(m.week || weekLabel)}" data-temp="${esc(m.temp || tempCode)}">
        <label>
          <span>Cubrir con tu pareja de ${esc(m.cat)}</span>
          <select name="pairId" required>
            <option value="">Elegí tu pareja…</option>
            ${opts}
          </select>
        </label>
        <button class="btn" type="submit">Cubrir partido</button>
        <p class="fixture-cover-msg" hidden></p>
      </form>`;
    }

    function render() {
      const term = fold((q?.value || "").trim());
      const rows = matches.filter((m) => {
        const okDay = day === "Todas" || m.day === day || (isOpen(m) && !m.day);
        const okCat = cat === "Todas" || m.cat === cat;
        const okCourt = court === "Todas" || m.venue === court || (isOpen(m) && !m.venue);
        const blob = fold([m.home, m.away].filter(Boolean).join(" "));
        return okDay && okCat && okCourt && (!term || blob.includes(term));
      });
      root.innerHTML = `<section class="fixture-week" style="padding-top:0">
        <div class="fixture-list">
          ${rows
            .map((m) => {
              const info = describeResult(m.result);
              const open = isOpen(m);
              return `<article class="fixture-row${open ? " is-cover" : ""}">
                <div class="fixture-meta">
                  <span>${esc(m.day || m.date || "A coordinar")}</span>
                  <span>${esc(m.time || "—")}</span>
                  <span>${esc(m.cat)}</span>
                </div>
                <div class="fixture-vs">
                  <div class="pair pair-a${info?.homeWin ? " winner" : ""}">
                    <span class="pair-label">Pareja 1</span>
                    <strong>${esc(m.home)}</strong>
                    ${info ? `<span class="pair-pts">${info.homePts} pts</span>` : ""}
                  </div>
                  <span class="vs">vs</span>
                  <div class="pair pair-b${info && !info.homeWin ? " winner" : ""}">
                    <span class="pair-label">Pareja 2</span>
                    <strong>${esc(m.away)}</strong>
                    ${info ? `<span class="pair-pts">${info.awayPts} pts</span>` : ""}
                  </div>
                </div>
                <div class="fixture-score">${
                  info
                    ? `<b>${esc(info.score)}</b><span>${info.label}</span>`
                    : open
                      ? `<span class="tag">Por cubrir</span>`
                      : m.result
                        ? `<b>${esc(m.result)}</b>`
                        : `<span class="tag">Por jugar</span>`
                }</div>
                <div class="fixture-place">
                  <span>${esc(m.venue || (open ? "Sin sede aún" : ""))}${m.court ? ` · ${esc(m.court)}` : ""}</span>
                </div>
                ${coverBox(m)}
              </article>`;
            })
            .join("")}
        </div>
      </section>`;
      empty.hidden = rows.length > 0;
      count.textContent = rows.length + (rows.length === 1 ? " partido" : " partidos");
    }

    function bind(selector, key, setter) {
      document.querySelectorAll(selector).forEach((btn) => {
        btn.addEventListener("click", () => {
          document.querySelectorAll(selector).forEach((b) => b.classList.remove("on"));
          btn.classList.add("on");
          setter(btn.dataset[key]);
          render();
        });
      });
    }

    async function loadCandidates() {
      if (!apiUrl) return;
      try {
        const res = await fetch(`${apiUrl}/fixture/pending?temp=${encodeURIComponent(tempCode)}`);
        const data = res.ok ? await res.json() : [];
        candidatesByKey = {};
        for (const row of Array.isArray(data) ? data : []) {
          if (String(row.week || "") !== String(weekLabel)) continue;
          const key = `${row.temp}|${row.week}|${row.cat}|${row.home}`;
          candidatesByKey[key] = row.candidates || [];
        }
      } catch {
        candidatesByKey = {};
      }
      pendingLoaded = true;
      render();
    }

    root.addEventListener("submit", async (e) => {
      const form = e.target.closest("form.fixture-cover");
      if (!form) return;
      e.preventDefault();
      const msg = form.querySelector(".fixture-cover-msg");
      const btn = form.querySelector("button[type=submit]");
      const pairId = form.pairId?.value || "";
      if (!apiUrl) {
        if (msg) {
          msg.hidden = false;
          msg.textContent = "La cobertura todavía no está configurada.";
        }
        return;
      }
      if (!pairId) return;
      if (btn) {
        btn.disabled = true;
        btn.textContent = "Guardando…";
      }
      if (msg) {
        msg.hidden = true;
        msg.textContent = "";
      }
      try {
        const res = await fetch(`${apiUrl}/fixture/cover`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            pairId,
            week: form.dataset.week,
            temp: form.dataset.temp,
            cat: form.dataset.cat,
            home: form.dataset.home,
            website: "",
          }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.message || "No se pudo cubrir el partido.");
        if (msg) {
          msg.hidden = false;
          msg.className = "fixture-cover-msg is-ok";
          msg.textContent = data.message || "Partido cubierto. Se actualiza en ~1 minuto.";
        }
        form.querySelector("select")?.setAttribute("disabled", "true");
        if (btn) {
          btn.disabled = true;
          btn.textContent = "Cubierto";
        }
        const i = matches.findIndex(
          (m) =>
            isOpen(m) &&
            String(m.home || "") === String(form.dataset.home || "") &&
            String(m.cat || "") === String(form.dataset.cat || "")
        );
        if (i >= 0) {
          matches[i] = { ...matches[i], away: data.away || matches[i].away, pending: false };
          delete matches[i].pending;
        }
        setTimeout(render, 1200);
      } catch (err) {
        if (msg) {
          msg.hidden = false;
          msg.className = "fixture-cover-msg is-err";
          msg.textContent = err?.message || "No se pudo cubrir.";
        }
        if (btn) {
          btn.disabled = false;
          btn.textContent = "Cubrir partido";
        }
      }
    });

    q?.addEventListener("input", render);
    bind("[data-day]", "day", (v) => { day = v; });
    bind("[data-cat]", "cat", (v) => { cat = v; });
    bind("[data-court]", "court", (v) => { court = v; });

    const DAY_ORD = ["lunes", "martes", "miércoles", "miercoles", "jueves", "viernes", "sábado", "sabado", "domingo"];
    const dayI = (d) => {
      const i = DAY_ORD.indexOf(String(d || "").trim().toLowerCase());
      return i < 0 ? 99 : i;
    };
    document.querySelector("#fx-public-dl")?.addEventListener("click", async () => {
      const mode = document.querySelector("#fx-public-dl-sort")?.value || "complejo";
      const rows = matches.slice().sort((a, b) => {
        const byFecha =
          dayI(a.day) - dayI(b.day) ||
          String(a.time || "").localeCompare(String(b.time || ""), "es") ||
          String(a.venue || "").localeCompare(String(b.venue || ""), "es");
        if (mode === "complejo") {
          return (
            String(a.venue || "").localeCompare(String(b.venue || ""), "es") ||
            byFecha ||
            String(a.home || "").localeCompare(String(b.home || ""), "es")
          );
        }
        if (mode === "pareja") {
          return (
            String(a.home || "").localeCompare(String(b.home || ""), "es") ||
            String(a.away || "").localeCompare(String(b.away || ""), "es") ||
            byFecha
          );
        }
        return byFecha || String(a.cat || "").localeCompare(String(b.cat || ""), "es");
      });
      const data = rows.map((m) => ({
        fecha: m.week || weekLabel,
        dia: m.day || "",
        horario: m.time || "",
        categoria: m.cat || "",
        complejo: m.venue || "",
        cancha: m.court || "",
        pareja1: m.home || "",
        pareja2: m.away || "",
        resultado: m.result || "",
      }));
      const XLSX = await import("xlsx");
      const ws = XLSX.utils.json_to_sheet(data);
      const wb = XLSX.utils.book_new();
      XLSX.utils.book_append_sheet(wb, ws, String(weekLabel || "Fixture").slice(0, 31));
      const file = `${String(weekLabel || "fixture").replace(/\s+/g, "-").toLowerCase()}-${mode}.xlsx`;
      XLSX.writeFile(wb, file);
    });

    render();
    loadCandidates();
  </script>
</Layout>
