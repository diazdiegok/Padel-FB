---
import Layout from "../../layouts/Layout.astro";
import BackNav from "../../components/BackNav.astro";
import fixture from "../../data/fixture.json";
import results from "../../data/results.json";
import { site } from "../../data/site";
import { isPendingMatch, isRealPairMatch } from "../../lib/fixturer.js";
import { combineResults, seasonLabel, seasonSlug, weekNumber, weekSlug } from "../../lib/liga.js";
import { page } from "../../lib/paths";

const fxList = ((fixture as any[]) || []).filter((m) => isRealPairMatch(m) || isPendingMatch(m));

export function getStaticPaths() {
  const live = ((fixture as any[]) || []).filter((m) => isRealPairMatch(m) || isPendingMatch(m));
  const pool = combineResults(results, live);
  const seasons = [...new Set(pool.map((m) => m.temp || site.currentSeason || "T4"))];
  return seasons.map((temp) => ({
    params: { temp: seasonSlug(temp) },
    props: { tempCode: temp },
  }));
}

const { tempCode } = Astro.props;
const all = combineResults(results, fxList);
const liveKeys = new Set(fxList.map((m) => `${m.temp || ""}|${m.week || ""}`));
const list = all.filter((m) => (m.temp || site.currentSeason || "T4") === tempCode);
const weeks = [...new Set(list.map((m) => m.week || "Sin fecha"))].sort(
  (a, b) => weekNumber(b) - weekNumber(a) || String(a).localeCompare(String(b), "es")
);
const cards = weeks.map((week) => {
  const weekList = list.filter((m) => (m.week || "Sin fecha") === week);
  const live = liveKeys.has(`${tempCode}|${week}`);
  return {
    week,
    total: weekList.length,
    live,
    href: page(`fixture/${seasonSlug(tempCode)}/${weekSlug(week)}/`),
  };
});
const title = seasonLabel(tempCode);
const live = tempCode === site.currentSeason;
---
<Layout title={`Fixture ${title} | Padel FB`} description={`Fixture de ${title} de Padel FB.`}>
  <div class="wrap">
    <header class="page-hero">
      <BackNav crumbs={[
        { label: "Fixture", href: "fixture/" },
        { label: "Liga", href: "liga/" },
      ]} />
      <p class="kicker">{live ? "En juego" : "Histórico"}</p>
      <h1>Fixture · {title}</h1>
      <p>Elegí la fecha para ver los partidos.</p>
    </header>

    {cards.length === 0 ? (
      <p class="empty" style="display:block;padding:48px 0">Todavía no hay partidos fixtureados en esta temporada.</p>
    ) : (
      <div class="hub-grid hub-fill">
        {cards.map((c) => (
          <a class="hub-card" href={c.href}>
            <p class="kicker" style="margin:0">Fecha{c.live ? " · En juego" : ""}</p>
            <h2>{c.week}</h2>
            <p>{c.total} partido{c.total === 1 ? "" : "s"}</p>
          </a>
        ))}
      </div>
    )}

  </div>
</Layout>
