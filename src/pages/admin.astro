    $("venue-list").addEventListener("change", (e) => {
      const input = e.target.closest("[data-photo='venue']");
      const file = input?.files?.[0];
      if (!file) return;
      const i = Number(input.closest("[data-venue]").dataset.venue);
      readVenuesFromDom();
      attachPhoto(siteData.venues[i], file);
    });
    $("more-add").addEventListener("click", () => {
      readVenuesFromDom();
      siteData.moreVenues.push({ name: "", image: "" });
      fillVenueForm();
    });
    $("more-list").addEventListener("click", (e) => {
      const move = e.target.closest("[data-move]");
      if (move) {
        readVenuesFromDom();
        moveInList(siteData.moreVenues, move.dataset.i, move.dataset.dir);
        fillVenueForm();
        return;
      }
      const del = e.target.closest("[data-more-del]");
      if (!del) return;
      readVenuesFromDom();
      siteData.moreVenues.splice(Number(del.dataset.moreDel), 1);
      fillVenueForm();
    });
    $("more-list").addEventListener("change", (e) => {
      const input = e.target.closest("[data-photo='more']");
      const file = input?.files?.[0];
      if (!file) return;
      const i = Number(input.closest("[data-more]").dataset.more);
      readVenuesFromDom();
      attachPhoto(siteData.moreVenues[i], file);
    });

    $("tn-add").addEventListener("click", () => {
      readTorneosFromDom();
      siteData.torneos.items.push({ title: "", when: "", text: "" });
      fillTorneosForm();
    });
    $("tn-list").addEventListener("click", (e) => {
      const move = e.target.closest("[data-move]");
      if (move) {
        readTorneosFromDom();
        moveInList(siteData.torneos.items, move.dataset.i, move.dataset.dir);
        fillTorneosForm();
        return;
      }
      const del = e.target.closest("[data-tn-del]");
      if (!del) return;
      readTorneosFromDom();
      siteData.torneos.items.splice(Number(del.dataset.tnDel), 1);
      fillTorneosForm();
    });

    $("kids-group-add").addEventListener("click", () => {
      readKidsFromDom();
      siteData.kids.groups.push({ venue: "", when: "", rows: [] });
      fillKidsForm();
    });
    $("kids-group-list").addEventListener("click", (e) => {
      const move = e.target.closest("[data-move]");
      if (move) {
        readKidsFromDom();
        moveInList(siteData.kids.groups, move.dataset.i, move.dataset.dir);
        fillKidsForm();
        return;
      }
      const del = e.target.closest("[data-kids-group-del]");
      if (!del) return;
      readKidsFromDom();
      siteData.kids.groups.splice(Number(del.dataset.kidsGroupDel), 1);
      fillKidsForm();
    });
    $("kids-price-add").addEventListener("click", () => {
      readKidsFromDom();
      siteData.kids.prices.push({ amount: "", text: "" });
      fillKidsForm();
    });
    $("kids-price-list").addEventListener("click", (e) => {
      const move = e.target.closest("[data-move]");
      if (move) {
        readKidsFromDom();
        moveInList(siteData.kids.prices, move.dataset.i, move.dataset.dir);
        fillKidsForm();
        return;
      }
      const del = e.target.closest("[data-kids-price-del]");
      if (!del) return;
      readKidsFromDom();
      siteData.kids.prices.splice(Number(del.dataset.kidsPriceDel), 1);
      fillKidsForm();
    });
    $("kids-save").addEventListener("click", async () => {
      if (!usePublishToken($("kids-msg"))) return;
      readKidsFromDom();
      msg($("kids-msg"), "Guardando infantiles…");
      try {
        const local = cleanSiteForSave();
        await publishSiteFields({ kids: local.kids }, "Actualiza clases infantiles desde el admin.");
        fillKidsForm();
        msg($("kids-msg"), "Listo. En ~1 minuto se ve en la web.", "ok");
      } catch (err) {
        msg($("kids-msg"), publishError(err), "err");
      }
    });

    $("ac-save").addEventListener("click", async () => {
      if (!usePublishToken($("ac-msg"))) return;
      readAcademiaFromDom();
      msg($("ac-msg"), "Guardando academia…");
      try {
        await uploadPending(siteData.staff, "staff");
        const local = cleanSiteForSave();
        await publishSiteFields(
          { academia: local.academia, staff: local.staff },
          "Actualiza academia desde el admin."
        );
        fillAcademiaForm();
        msg($("ac-msg"), "Listo. En ~1 minuto se ve en la web.", "ok");
      } catch (err) {
        msg($("ac-msg"), publishError(err), "err");
      }
    });

    $("venue-save").addEventListener("click", async () => {
      if (!usePublishToken($("venue-msg"))) return;
      readVenuesFromDom();
      msg($("venue-msg"), "Guardando sedes…");
      try {
        await uploadPending(siteData.venues, "venue");
        await uploadPending(siteData.moreVenues, "more");
        const local = cleanSiteForSave();
        await publishSiteFields(
          { venues: local.venues, moreVenues: local.moreVenues },
          "Actualiza sedes desde el admin."
        );
        fillVenueForm();
        msg($("venue-msg"), "Listo. En ~1 minuto se ve en la web.", "ok");
      } catch (err) {
        msg($("venue-msg"), publishError(err), "err");
      }
    });

    $("tn-save").addEventListener("click", async () => {
      if (!usePublishToken($("tn-msg"))) return;
      readTorneosFromDom();
      siteData.torneos.items = (siteData.torneos.items || []).filter((item) => item.title || item.text || item.when);
      msg($("tn-msg"), "Guardando torneos…");
      try {
        const local = cleanSiteForSave();
        await publishSiteFields(
          { torneos: local.torneos },
          "Actualiza torneos desde el admin."
        );
        fillTorneosForm();
        msg($("tn-msg"), "Listo. En ~1 minuto se ve en la web.", "ok");
      } catch (err) {
        msg($("tn-msg"), publishError(err), "err");
      }
    });

    $("site-form").addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!usePublishToken($("site-msg"))) return;
      const form = e.target;
      siteData = {
        ...siteData,
        currentSeason: form.currentSeason.value.trim() || "T4",
        whatsapp: form.whatsapp.value.trim(),
        instagram: form.instagram.value.trim(),
        city: form.city.value.trim(),
        province: form.province.value.trim(),
        ligaIntro: form.ligaIntro.value.trim(),
      };
      msg($("site-msg"), "Guardando sitio…");
      try {
        const local = cleanSiteForSave();
        await publishSiteFields(
          {
            currentSeason: local.currentSeason,
            whatsapp: local.whatsapp,
            instagram: local.instagram,
            city: local.city,
            province: local.province,
            ligaIntro: local.ligaIntro,
          },
          "Actualiza datos del sitio desde el admin."
        );
        msg($("site-msg"), "Datos publicados. El sitio se actualiza en ~1 minuto.", "ok");
      } catch (err) {
        msg($("site-msg"), publishError(err), "err");
      }
    });

    if (isLoggedIn()) showApp();
  </script>
</Layout>
