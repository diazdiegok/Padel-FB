    });
    $("fx-publish").addEventListener("click", async () => {
      token = $("gh-token").value.trim();
      if (!token) {
        msg($("fx-msg"), "Para publicar pegá un token de GitHub arriba (Contents: write).", "err");
        $("gh-token").focus();
        return;
      }
      sessionStorage.setItem(KEY, token);
      const nextFixture = fixture.map(cleanMatch).filter((m) => m.home || m.away);
      const nextRanking = structuredClone(rows).map(cleanRow).filter((r) => r.name && r.cat.toLowerCase() !== "s masculina");
      const report = applyFixtureResults(nextRanking, nextFixture);
      msg($("fx-msg"), "Publicando fixture y ranking…");
      try {
        await publishFiles(
          [
            { path: FIXTURE_PATH, content: JSON.stringify(nextFixture, null, 2) + "\n" },
            { path: RANK_PATH, content: JSON.stringify(nextRanking, null, 2) + "\n" },
          ],
          report.applied
            ? `Carga resultados del fixture y actualiza el ranking (${report.applied}).`
            : "Actualiza fixture desde el admin."
        );
        fixture = nextFixture;
        rows = nextRanking;
        fillFilters();
        renderTable();
        renderFixture();
        const extra = report.created.length ? ` Altas: ${[...new Set(report.created)].join(" · ")}.` : "";
        const warn = report.unmatched.length ? ` ${report.unmatched[0]}` : "";
        msg(
          $("fx-msg"),
          (report.applied
            ? `Fixture y ranking publicados. ${report.applied} resultado${report.applied === 1 ? "" : "s"} sumados.${extra}`
            : "Fixture publicado. El sitio se actualiza en ~1 minuto.") + warn,
          report.unmatched.length ? "err" : "ok"
        );
      } catch (err) {
        msg($("fx-msg"), err.message, "err");
      }
    });

    $("copy-submit-token").addEventListener("click", () => {
