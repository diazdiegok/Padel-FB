    function loadFixtureText(text) {
      const parsed = parseFixtureText(text, {
        week: fallbackWeek(),
        temp: siteData.currentSeason || "T4",
      });
      const prev = new Map(fixture.map((m) => [matchKey(m), m]));
      fixture = parsed.map((m) => {
        const old = prev.get(matchKey(m));
        if (!old) return m;
        return {
          ...m,
          result: m.result || old.result,
          appliedResult: old.appliedResult,
        };
      });
      renderFixture();
      msg($("fx-msg"), `Cargué ${parsed.length} partidos de ${fallbackWeek()}. Revisá y publicá.`, "ok");
    }
