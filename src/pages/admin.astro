      disp.open = $("disp-open").checked;
      disp.temp = siteData.currentSeason || "T4";
      msg($("disp-msg"), "Guardando fecha…");
      try {
        const file = await loadDisponibilidad({ owner, repo, token });
        const latest = file.json;
        const keepIds = new Set((disp.entries || []).map((e) => e.id));
        latest.week = disp.week;
        latest.open = disp.open;
        latest.temp = disp.temp;
        latest.entries = (latest.entries || []).filter((e) => keepIds.has(e.id));
        await saveDisponibilidad({
          owner,
          repo,
          token,
          json: latest,
          sha: file.sha,
          message: latest.open ? `Abre carga de ${latest.week}.` : `Cierra carga de ${latest.week}.`,
        });
        disp = latest;
        fillDisp();
        msg($("disp-msg"), "Fecha guardada. El sitio se actualiza en ~1 minuto.", "ok");
      } catch (err) {
        msg($("disp-msg"), err.message, "err");
      }
    });

