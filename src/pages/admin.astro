---
import Layout from "../layouts/Layout.astro";
import "../styles/admin.css";
---
<Layout title="Admin | Padel FB" description="Panel interno para cargar y editar datos de Padel FB." noindex>
  <div class="admin-gate" id="gate">
    <form class="admin-card form" id="login-form" autocomplete="off">
      <p class="kicker">Panel interno</p>
      <h1>Admin Padel FB</h1>
      <div class="admin-step" id="step-pass">
        <p class="admin-help">Ingresá usuario y clave para continuar.</p>
        <label>Usuario
          <input id="user" name="liga-user" autocomplete="off" autocapitalize="off" spellcheck="false" />
        </label>
        <label>Clave
          <input id="pass" name="liga-pass" type="password" autocomplete="new-password" />
        </label>
        <div class="admin-login-actions">
          <button class="btn btn-lime" type="submit" id="login-next">Continuar</button>
        </div>
      </div>
      <div class="admin-step" id="step-otp" hidden>
        <p class="admin-help">Ahora el código de 6 dígitos del autenticador.</p>
        <label>Código
          <input id="otp" class="admin-otp" inputmode="numeric" maxlength="6" autocomplete="one-time-code" />
        </label>
        <div class="admin-login-actions">
          <button class="btn btn-lime" type="submit" id="login">Entrar</button>
          <button class="btn btn-ghost" type="button" id="login-back">Volver</button>
        </div>
      </div>
      <p class="admin-msg" id="login-msg"></p>
    </form>
  </div>

  <div class="admin-shell" id="app" hidden>
    <div class="admin-nav-backdrop" id="admin-nav-backdrop"></div>
    <aside class="admin-sidebar" id="admin-sidebar">
      <div class="admin-brand">
        <div class="admin-brand-mark">FB</div>
        <div>
          <strong>PADEL FB</strong>
          <span>Admin</span>
        </div>
      </div>

      <div class="admin-nav-group">
        <div class="admin-nav-label">Inicio</div>
        <button class="admin-nav-btn on" type="button" data-nav="sitio">Inicio</button>
      </div>
      <div class="admin-nav-group">
        <div class="admin-nav-label">Liga</div>
        <button class="admin-nav-btn" type="button" data-nav="temporadas">Temporadas</button>
        <button class="admin-nav-btn" type="button" data-nav="parejas">Inscripciones de parejas</button>
        <button class="admin-nav-btn" type="button" data-nav="fixture">Fixture</button>
        <button class="admin-nav-btn" type="button" data-nav="resultados">Resultados</button>
        <button class="admin-nav-btn" type="button" data-nav="ranking">Ranking</button>
        <button class="admin-nav-btn" type="button" data-nav="playoff">Playoff</button>
        <button class="admin-nav-btn" type="button" data-nav="sedes">Sedes</button>
      </div>
      <div class="admin-nav-group">
        <div class="admin-nav-label">Academia</div>
        <button class="admin-nav-btn" type="button" data-nav="acadinsc">Inscripciones</button>
        <button class="admin-nav-btn" type="button" data-nav="academia">Adultos</button>
        <button class="admin-nav-btn" type="button" data-nav="infantiles">Infantiles</button>
      </div>
      <div class="admin-nav-group">
        <div class="admin-nav-label">Torneos</div>
        <button class="admin-nav-btn" type="button" data-nav="torneos">Torneos</button>
      </div>

      <div class="admin-sidebar-foot">
        <button class="btn btn-ghost" type="button" id="admin-logout">Salir</button>
      </div>
    </aside>

    <div class="admin-main">
      <header class="admin-topbar">
        <div class="admin-topbar-left">
          <button class="admin-menu-btn" type="button" id="admin-menu-btn" aria-label="Menú">☰</button>
          <div>
            <h1 id="admin-page-title">Inicio</h1>
            <p class="admin-page-help" id="admin-page-help">Contacto, ciudad, texto de inicio y si se muestra el botón Ver playoff.</p>
          </div>
        </div>
        <div class="admin-topbar-right">
          <span class="admin-dirty" id="admin-dirty" hidden>Cambios sin guardar</span>
        </div>
      </header>

      <div class="admin-content">
        <!-- Inicio -->
        <section data-section="sitio">
          <form class="form" id="site-form">
            <div class="admin-site-grid">
              <div class="admin-site-block">
                <h3>Contacto</h3>
                <label>WhatsApp (549…):
                  <input name="whatsapp" />
                </label>
                <label>Instagram:
                  <input name="instagram" />
                </label>
              </div>
              <div class="admin-site-block">
                <h3>Ubicación</h3>
                <label>Ciudad:
                  <input name="city" />
                </label>
                <label>Provincia:
                  <input name="province" />
                </label>
              </div>
              <div class="admin-site-block span-2">
                <h3>Inicio</h3>
                <label>Texto de inicio:
                  <textarea name="ligaIntro" rows="6"></textarea>
                </label>
                <label class="chk"><input name="showPlayoff" type="checkbox" /> Mostrar botón Ver playoff</label>
                <p class="admin-help" id="site-playoff-help">Si está tildado, el inicio muestra Ver playoff y lleva al cuadro de la temporada en juego. Destildalo mientras se juega la fase regular; cuando armes el playoff, volvé a tildarlo.</p>
              </div>
            </div>
            <p class="admin-msg" id="site-msg"></p>
            <div class="admin-sticky-bar">
              <p class="admin-sticky-note">Estos datos alimentan el sitio público.</p>
              <div class="admin-sticky-actions">
                <button class="btn btn-lime" type="submit" id="site-save">Publicar inicio</button>
              </div>
            </div>
          </form>
        </section>

        <!-- Temporadas -->
        <section data-section="temporadas" hidden>
          <div class="admin-callout">
            <strong>En juego y próximamente</strong>
            La temporada en juego es la que usan el inicio, el ranking, el fixture y las inscripciones. La marcada Próximamente aparece en el inicio hasta que la pongas en juego.
          </div>
          <div class="admin-section-tools">
            <button class="btn btn-lime" type="button" id="season-create">Nueva temporada</button>
            <span class="tag" id="season-current"></span>
          </div>
          <p class="admin-help">En juego es la actual. Próximamente avisa en el inicio la que viene. Cambiá sedes, poné en juego o marcá próximamente: todo queda local hasta que toques <strong>Publicar temporadas</strong>.</p>
          <p class="admin-msg" id="season-msg"></p>
          <div id="season-list"></div>
          <div class="admin-sticky-bar">
            <p class="admin-sticky-note">Publicá los cambios de esta sección. El sitio se actualiza en ~1 minuto.</p>
            <div class="admin-sticky-actions">
              <button class="btn btn-lime" type="button" id="season-publish">Publicar temporadas</button>
            </div>
          </div>
        </section>

        <!-- Ranking -->
        <section data-section="ranking" hidden>
          <div class="admin-section-tools">
            <button class="btn btn-ghost" type="button" id="csv-export">Exportar</button>
            <span class="tag" id="rank-count"></span>
          </div>
          <div class="season-bar">
            <span class="filter-kicker">Temporada</span>
            <div class="seg" id="f-temps"></div>
          </div>
          <div class="filters">
            <input class="search" id="f-q" type="search" placeholder="Buscar pareja…" autocomplete="off" />
            <div class="filter-group" style="flex:1;min-width:220px">
              <span>Categoría</span>
              <div class="pills" id="f-cats"></div>
            </div>
          </div>
          <p class="admin-msg" id="rank-msg"></p>
          <div class="admin-empty" id="rank-empty" hidden>
            <p>Todavía no hay parejas en esta categoría. Cuando se inscriban aparecen solas acá con 0 puntos.</p>
          </div>
          <div class="admin-scroll">
            <table class="admin-table">
              <thead>
                <tr>
                  <th class="col-pos">#</th>
                  <th>Nombre / pareja</th>
                  <th class="col-cat">Categoría</th>
                  <th class="col-num">PJ</th>
                  <th class="col-num">Dif</th>
                  <th class="col-num">Pts</th>
                  <th></th>
                </tr>
              </thead>
              <tbody id="tbody"></tbody>
            </table>
          </div>
          <div class="admin-sticky-bar">
            <p class="admin-sticky-note">Los puntos se suman solos al publicar Resultados. Acá corregís a mano si hace falta.</p>
            <div class="admin-sticky-actions">
              <button class="btn btn-lime" type="button" id="publish">Publicar ranking</button>
            </div>
          </div>
        </section>

        <!-- Fixture -->
        <section data-section="fixture" hidden>
          <div class="admin-stepper">
            <div class="admin-step-card">
              <span>1 · Armar</span>
              <p>Armar fixture cruza las parejas inscriptas según su disponibilidad. Las que no coinciden quedan pendientes.</p>
            </div>
            <div class="admin-step-card">
              <span>2 · Revisar</span>
              <p>Editá día, horario, cancha y parejas. El score se carga en Resultados.</p>
            </div>
            <div class="admin-step-card">
              <span>3 · Publicar</span>
              <p>Se publica la fecha en juego. Las fechas anteriores quedan en Resultados.</p>
            </div>
          </div>

          <div class="admin-panel">
            <div class="admin-toolbar">
              <label class="admin-week">Jornada
                <input id="fx-week" value="Fecha 1" placeholder="Fecha 1" />
              </label>
              <button class="btn btn-lime" type="button" id="fx-build">Armar fixture</button>
              <button class="btn btn-ghost" type="button" id="fx-add">+ Partido</button>
              <span class="admin-summary" id="fx-summary">Sin partidos cargados</span>
            </div>
          </div>

          <p class="admin-msg" id="fx-msg"></p>
          <datalist id="fx-venues"></datalist>
          <div class="admin-empty" id="fx-empty" hidden>
            <p>Todavía no hay partidos. Usá Armar fixture o + Partido.</p>
          </div>
          <div class="fx-warnings" id="fx-warnings" role="status" hidden></div>
          <div class="fx-pending" id="fx-pending" hidden></div>
          <div class="admin-scroll">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Día</th>
                  <th>Horario</th>
                  <th>Cat</th>
                  <th>Complejo</th>
                  <th>Cancha</th>
                  <th>Pareja 1</th>
                  <th>Pareja 2</th>
                  <th></th>
                </tr>
              </thead>
              <tbody id="fx-body"></tbody>
            </table>
          </div>
          <div class="admin-sticky-bar">
            <p class="admin-sticky-note">Publicá el fixture de la fecha. Los resultados se cargan en la sección Resultados.</p>
            <div class="admin-sticky-actions">
              <button class="btn btn-lime" type="button" id="fx-publish">Publicar fixture</button>
            </div>
          </div>
        </section>

        <!-- Resultados -->
        <section data-section="resultados" hidden>
          <div class="admin-callout">
            <strong>Cómo se carga</strong>
            Desde Pareja 1: <b>6-4 6-2</b> (ganador 3 pts) o <b>6-4 3-6 6-2</b> (ganador 3 pts, perdedor 1).
          </div>
          <div class="admin-section-tools">
            <button class="btn btn-ghost" type="button" id="res-reload">Actualizar</button>
            <span class="tag" id="res-count"></span>
          </div>
          <div class="res-crumbs" id="res-crumbs" role="navigation" aria-label="Ubicación en resultados"></div>
          <div class="res-boxes" id="res-boxes"></div>
          <div class="admin-empty" id="res-empty" hidden>
            <p>Todavía no hay partidos. Cuando publiques un fixture, aparecen acá para cargar el resultado.</p>
          </div>
          <div class="res-filters" id="res-filters" hidden>
            <div class="pills" id="res-cats"></div>
            <input class="admin-search" id="res-search" type="search" placeholder="Buscar pareja…" autocomplete="off" />
          </div>
          <p class="admin-msg" id="res-msg"></p>
          <div id="res-list"></div>
          <div class="admin-sticky-bar">
            <p class="admin-sticky-note">Publicar suma los scores al ranking de la temporada del partido.</p>
            <div class="admin-sticky-actions">
              <button class="btn btn-lime" type="button" id="res-publish">Publicar resultados</button>
            </div>
          </div>
        </section>

        <!-- Playoff -->
        <section data-section="playoff" hidden>
          <div class="admin-callout">
            <strong>Cómo se carga</strong>
            <span>Elegí la temporada y la categoría, revisá el cuadro (se arma con el ranking: 1 vs 8, 4 vs 5, 2 vs 7, 3 vs 6) y cargá día, horario y resultado: <b>6-4 6-2</b> o <b>6-4 3-6 10-8</b>. Para cambiar una pareja tocá <b>Editar</b>. Cada temporada publicada queda en el historial de la web; la T4 y las que vengan se siguen viendo. El playoff no suma puntos al ranking.</span>
          </div>
          <div class="admin-panel">
            <div class="admin-toolbar">
              <label class="admin-week">Temporada
                <select id="po-temp"></select>
              </label>
              <label class="admin-week">Título
                <input id="po-title" placeholder="Playoff Temporada 4" />
              </label>
              <label class="admin-week">Fechas
                <input id="po-dates" placeholder="Domingo 25/10/2026" />
              </label>
            </div>
            <div class="admin-toolbar">
              <label class="admin-week po-note">Texto debajo del título
                <input id="po-note" placeholder="Si lo dejás vacío: Cuadro por categoría. La pareja ganadora de cada partido pasa a la ronda siguiente." />
              </label>
            </div>
          </div>
          <div class="admin-section-tools">
            <div class="pills" id="po-cat-pills">
              <div id="po-cats"></div>
              <button class="pill" type="button" id="po-edit" hidden aria-expanded="false" aria-controls="po-edit-panel">Editar</button>
            </div>
            <select class="po-select" id="po-cat-add" aria-label="Agregar categoría"></select>
            <button class="pill po-tool" type="button" id="po-reload">Actualizar</button>
          </div>
          <div class="po-edit-panel" id="po-edit-panel" hidden>
            <div>
              <h3 id="po-edit-title">Editar parejas</h3>
              <p>Elegí una pareja del ranking o escribí el nombre a mano. Si pasa directo, escribí Libre. Después tocá Publicar playoff.</p>
            </div>
            <div id="po-edit-list"></div>
          </div>
          <div class="admin-section-tools" id="po-cat-tools" hidden>
            <select class="po-select" id="po-size" aria-label="Tamaño del cuadro"></select>
            <button class="pill po-tool" type="button" id="po-arm">Armar desde ranking</button>
            <button class="pill po-tool po-tool-danger" type="button" id="po-cat-remove">Quitar categoría</button>
          </div>
          <p class="admin-msg" id="po-msg"></p>
          <div class="admin-empty" id="po-empty" hidden>
            <p>Todavía no hay categorías en el playoff. Agregá una con + Categoría.</p>
          </div>
          <div class="po-bracket" id="po-bracket"></div>
          <datalist id="po-pairs"></datalist>
          <div class="admin-sticky-bar">
            <p class="admin-sticky-note">Publicá cada vez que cargues resultados. El sitio se actualiza en ~1 minuto.</p>
            <div class="admin-sticky-actions">
              <button class="btn btn-lime" type="button" id="po-publish">Publicar playoff</button>
            </div>
          </div>
        </section>

        <!-- Parejas -->
        <section data-section="parejas" hidden>
          <div class="admin-panel">
            <div class="admin-toolbar">
              <label class="chk"><input id="pairs-open" type="checkbox" checked /> Inscripción abierta</label>
              <label class="admin-week">Cierra el:
                <input id="pairs-deadline" type="datetime-local" />
              </label>
              <span class="admin-status-pill open" id="pairs-status">Inscripción abierta</span>
            </div>
            <p class="admin-help">Si ponés fecha y hora, a esa hora se destilda sola y la web deja de aceptar inscripciones. Destildá para cerrarla ya. Los textos de abajo son los de la página pública. Se aplica al tocar Publicar parejas.</p>
            <div class="form cms-form pairs-copy">
              <label>Título:
                <input id="pairs-title" maxlength="80" />
              </label>
              <label>Texto:
                <textarea id="pairs-intro" rows="3" maxlength="400"></textarea>
              </label>
              <label>Aclaración del formulario:
                <textarea id="pairs-hint" rows="2" maxlength="300"></textarea>
              </label>
              <label>Texto del botón:
                <input id="pairs-cta" maxlength="40" />
              </label>
            </div>
          </div>
          <div class="admin-section-tools">
            <button class="btn btn-ghost" type="button" id="pairs-reload">Actualizar lista</button>
            <button class="btn btn-ghost" type="button" id="pairs-add">+ Pareja</button>
            <button class="btn btn-ghost" type="button" id="pairs-export">Exportar con WhatsApp</button>
            <span class="tag" id="pairs-count"></span>
          </div>
          <div class="pairs-filters">
            <div class="pills" id="pairs-cats"></div>
            <div class="pills" id="pairs-origins"></div>
          </div>
          <input class="admin-search" id="pairs-search" type="search" placeholder="Buscar jugador…" autocomplete="off" />
          <p class="admin-help">Filtrá por categoría u origen, o buscá por nombre. Corregí nombres, mails, categoría o disponibilidad si se equivocaron. En Repetida quitá el duplicado. WhatsApp y mails no se publican en la web: solo los ves acá.</p>
          <p class="admin-msg" id="pairs-msg"></p>
          <div id="pairs-list"></div>
          <div class="admin-sticky-bar">
            <p class="admin-sticky-note">Publicá para subir textos, parejas y disponibilidad.</p>
            <div class="admin-sticky-actions">
              <button class="btn btn-lime" type="button" id="pairs-publish">Publicar parejas</button>
            </div>
          </div>
        </section>

        <!-- Inscripciones academia -->
        <section data-section="acadinsc" hidden>
          <div class="admin-section-tools">
            <button class="btn btn-ghost" type="button" id="acad-reload">Actualizar lista</button>
            <button class="btn btn-ghost" type="button" id="acad-export">Exportar</button>
            <span class="tag" id="acad-count"></span>
          </div>
          <input class="admin-search" id="acad-search" type="search" placeholder="Buscar nombre o WhatsApp…" autocomplete="off" />
          <p class="admin-help">Cada vez que alguien completa la inscripción de la academia, queda acá. El WhatsApp sigue abriéndose para responderles.</p>
          <p class="admin-msg" id="acad-msg"></p>
          <div id="acad-list"></div>
        </section>

        <!-- Academia -->
        <section data-section="academia" hidden>
          <form class="form cms-form" id="ac-copy">
            <label>Título (un renglón = un corte):
              <textarea name="title" rows="2"></textarea>
            </label>
            <label>Texto de arriba:
              <textarea name="intro" rows="3"></textarea>
            </label>
            <label>Texto del equipo:
              <input name="teamNote" />
            </label>
            <label>Texto del botón:
              <input name="cta" placeholder="Inscripción" />
            </label>
          </form>
          <div class="cms-head">
            <h3>Profes</h3>
            <button class="btn btn-ghost" type="button" id="staff-add">+ Agregar profe</button>
          </div>
          <div class="admin-empty" id="staff-empty" hidden>
            <p>Todavía no hay profes. Agregá el primero.</p>
          </div>
          <div class="cms-list" id="staff-list"></div>
          <div class="cms-head">
            <h3>Programas</h3>
          </div>
          <div class="cms-list" id="prog-list"></div>
          <p class="admin-msg" id="ac-msg"></p>
          <div class="admin-sticky-bar">
            <p class="admin-sticky-note">Se publican textos, orden y fotos pendientes.</p>
            <div class="admin-sticky-actions">
              <button class="btn btn-lime" type="button" id="ac-save">Publicar academia</button>
            </div>
          </div>
        </section>

        <!-- Infantiles -->
        <section data-section="infantiles" hidden>
          <form class="form cms-form" id="kids-copy">
            <label>Título (un renglón = un corte):
              <textarea name="title" rows="2"></textarea>
            </label>
            <label>Edades:
              <input name="age" placeholder="De 7 a 13 años" />
            </label>
            <label>Texto de arriba:
              <textarea name="intro" rows="2"></textarea>
            </label>
            <label>Viñetas (un renglón cada una):
              <textarea name="features" rows="4"></textarea>
            </label>
            <label>Profe:
              <select name="profeId"></select>
            </label>
            <label>Rol en esta página:
              <input name="profeRole" placeholder="Profe · Academia infantil" />
            </label>
            <label>Texto del botón:
              <input name="cta" />
            </label>
          </form>
          <div class="cms-head">
            <h3>Sedes y horarios</h3>
            <button class="btn btn-ghost" type="button" id="kids-group-add">+ Agregar sede</button>
          </div>
          <div class="cms-list" id="kids-group-list"></div>
          <div class="cms-head" hidden>
            <h3>Valores mensuales</h3>
            <button class="btn btn-ghost" type="button" id="kids-price-add">+ Agregar valor</button>
          </div>
          <div class="cms-list" id="kids-price-list" hidden></div>
          <p class="admin-msg" id="kids-msg"></p>
          <div class="admin-sticky-bar">
            <p class="admin-sticky-note">El profe se elige de la lista de Adultos.</p>
            <div class="admin-sticky-actions">
              <button class="btn btn-lime" type="button" id="kids-save">Publicar infantiles</button>
            </div>
          </div>
        </section>

        <!-- Sedes -->
        <section data-section="sedes" hidden>
          <div class="cms-head">
            <h3>Sedes</h3>
            <button class="btn btn-ghost" type="button" id="venue-add">+ Agregar sede</button>
          </div>
          <div class="admin-empty" id="venue-empty" hidden>
            <p>Todavía no hay sedes. Agregá la primera.</p>
          </div>
          <div class="cms-list" id="venue-list"></div>
          <div class="cms-head">
            <h3>Otros complejos</h3>
            <button class="btn btn-ghost" type="button" id="more-add">+ Agregar</button>
          </div>
          <div class="cms-list" id="more-list"></div>
          <p class="admin-msg" id="venue-msg"></p>
          <div class="admin-sticky-bar">
            <p class="admin-sticky-note">Marcá Liga / Academia / Infantiles en cada sede para controlar dónde se muestra. Al tildar Infantiles, la sede aparece sola en Infantiles para cargarle horarios.</p>
            <div class="admin-sticky-actions">
              <button class="btn btn-lime" type="button" id="venue-save">Publicar sedes</button>
            </div>
          </div>
        </section>

        <!-- Torneos -->
        <section data-section="torneos" hidden>
          <form class="form cms-form" id="tn-copy">
            <label>Título:
              <input name="title" />
            </label>
            <label>Texto de arriba:
              <textarea name="intro" rows="3"></textarea>
            </label>
            <label>Aviso si no hay torneos:
              <input name="emptyTitle" />
            </label>
            <label>Texto del aviso:
              <textarea name="emptyText" rows="3"></textarea>
            </label>
          </form>
          <div class="cms-head">
            <h3>Torneos</h3>
            <button class="btn btn-ghost" type="button" id="tn-add">+ Agregar torneo</button>
          </div>
          <div class="admin-empty" id="tn-empty" hidden>
            <p>Todavía no hay torneos. La web mostrará el aviso vacío.</p>
          </div>
          <div class="cms-list" id="tn-list"></div>
          <p class="admin-msg" id="tn-msg"></p>
          <div class="admin-sticky-bar">
            <p class="admin-sticky-note">Con Subir / Bajar ordenás cómo se listan en la web.</p>
            <div class="admin-sticky-actions">
              <button class="btn btn-lime" type="button" id="tn-save">Publicar torneos</button>
            </div>
          </div>
        </section>

      </div>
    </div>

    <div class="admin-toasts" id="admin-toasts"></div>
    <dialog class="admin-modal" id="admin-modal">
      <div class="admin-modal-inner">
        <h2 id="admin-modal-title">Confirmar</h2>
        <p id="admin-modal-body"></p>
        <div class="admin-modal-actions">
          <button class="btn btn-ghost" type="button" id="admin-modal-cancel">Cancelar</button>
          <button class="btn btn-lime" type="button" id="admin-modal-ok">Confirmar</button>
        </div>
      </div>
    </dialog>
  </div>

  <script>
    import rankingJson from "../data/ranking.json";
