---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Admin | Padel FB" description="Panel para cargar ranking y datos de Padel FB." noindex>
  <div class="wrap admin-gate" id="gate">
    <form class="admin-card form" id="login-form" autocomplete="off">
      <p class="kicker">Panel interno</p>
      <h1>Admin Padel FB</h1>
      <div class="admin-step" id="step-pass">
        <p class="admin-help">Ingresá usuario y clave.</p>
        <label>Usuario
          <input id="user" name="liga-user" autocomplete="off" autocapitalize="off" spellcheck="false" />
        </label>
        <label>Clave
          <input id="pass" name="liga-pass" type="password" autocomplete="new-password" />
        </label>
        <div class="admin-login-actions">
          <button class="btn btn-lime" type="submit" id="login-next">Continuar</button>
        </div>
      </div>
      <div class="admin-step" id="step-otp" hidden>
        <p class="admin-help">Ahora el código de 6 dígitos del autenticador.</p>
        <label>Código
          <input id="otp" class="admin-otp" inputmode="numeric" maxlength="6" autocomplete="one-time-code" />
        </label>
        <div class="admin-login-actions">
          <button class="btn btn-lime" type="submit" id="login">Entrar</button>
          <button class="btn btn-ghost" type="button" id="login-back">Volver</button>
        </div>
      </div>
      <p class="admin-msg" id="login-msg"></p>
    </form>
  </div>

  <div class="wrap admin-app" id="app" hidden>
    <p class="kicker">Panel interno</p>
    <h1>Cargar y editar</h1>
    <div class="admin-toolbar">
      <details class="admin-pub">
        <summary>Publicar</summary>
        <input id="gh-token" type="password" placeholder="Token de publicación" autocomplete="off" />
      </details>
      <button class="btn btn-ghost" type="button" id="logout">Salir</button>
    </div>

    <div class="admin-tabs">
      <button class="pill on" type="button" data-tab="ranking">Ranking</button>
      <button class="pill" type="button" data-tab="fixture">Fixture</button>
      <button class="pill" type="button" data-tab="fecha">Fecha</button>
      <button class="pill" type="button" data-tab="academia">Academia</button>
      <button class="pill" type="button" data-tab="sedes">Sedes</button>
      <button class="pill" type="button" data-tab="torneos">Torneos</button>
      <button class="pill" type="button" data-tab="sitio">Sitio</button>
    </div>

    <section id="tab-ranking">
      <div class="season-bar">
        <span class="filter-kicker">Temporada</span>
        <div class="seg" id="f-temps"></div>
      </div>
      <div class="filters">
        <input class="search" id="f-q" type="search" placeholder="Buscar pareja…" autocomplete="off" />
        <div class="filter-group" style="flex:1;min-width:220px">
          <span>Categoría</span>
          <div class="pills" id="f-cats"></div>
        </div>
        <span class="tag" id="rank-count"></span>
      </div>
      <div class="admin-actions">
        <button class="btn btn-ghost" type="button" id="add">+ Jugador</button>
        <button class="btn btn-ghost" type="button" id="csv-model">Modelo CSV</button>
        <button class="btn btn-ghost" type="button" id="csv-export">Exportar</button>
        <label class="btn btn-ghost" style="cursor:pointer">
          Importar
          <input id="csv" type="file" accept=".csv,.txt,.tsv" hidden />
        </label>
        <label class="chk"><input id="replace-temp" type="checkbox" checked /> Reemplazar temporada</label>
        <button class="btn btn-lime" type="button" id="publish">Publicar ranking</button>
      </div>
      <p class="admin-msg" id="rank-msg"></p>
      <div class="admin-scroll">
        <table class="admin-table">
          <thead>
            <tr>
              <th class="col-pos">#</th>
              <th>Nombre / pareja</th>
              <th class="col-cat">Categoría</th>
              <th class="col-num">PJ</th>
              <th class="col-num">Dif</th>
              <th class="col-num">Pts</th>
              <th class="col-temp">Temp</th>
              <th></th>
            </tr>
          </thead>
          <tbody id="tbody"></tbody>
        </table>
      </div>
    </section>

    <section id="tab-fixture" hidden>
      <div class="admin-panel">
        <div class="admin-toolbar">
          <label class="admin-week">Fecha
            <input id="fx-week" value="Fecha 5" placeholder="Fecha 5" />
          </label>
          <button class="btn btn-ghost" type="button" id="fx-add">+ Partido</button>
          <button class="btn btn-ghost" type="button" id="fx-model">Modelo CSV</button>
          <button class="btn btn-ghost" type="button" id="fx-export">Exportar CSV</button>
          <label class="btn btn-ghost" style="cursor:pointer">
            Importar CSV
            <input id="fx-csv" type="file" accept=".csv,.txt,.tsv" hidden />
          </label>
        </div>
        <label class="admin-help" style="display:block;margin-top:12px">Pegá la tabla de Drive (categoria, partido, complejo, cancha, dia, horario)
          <textarea id="fx-paste" rows="6" placeholder="categoria	partido	complejo	cancha	dia	horario"></textarea>
        </label>
        <div class="admin-toolbar">
          <button class="btn btn-ghost" type="button" id="fx-paste-btn">Cargar tabla</button>
          <button class="btn btn-lime" type="button" id="fx-publish">Publicar fixture</button>
        </div>
      </div>
      <p class="admin-help">Resultado desde Pareja 1: <b>6-4 6-2</b> (2-0 = 3 pts) o <b>6-4 3-6 6-2</b> (2-1 = 2 pts y 1 la otra). Al publicar, se ven en Resultados y se suman al ranking.</p>
      <p class="admin-msg" id="fx-msg"></p>
      <div class="admin-scroll">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Semana</th>
              <th>Día</th>
              <th>Horario</th>
              <th>Cat</th>
              <th>Complejo</th>
              <th>Cancha</th>
              <th>Pareja 1</th>
              <th>Pareja 2</th>
              <th class="col-result">Resultado</th>
              <th></th>
            </tr>
          </thead>
          <tbody id="fx-body"></tbody>
        </table>
      </div>
    </section>

    <section id="tab-fecha" hidden>
      <div class="admin-panel">
        <div class="admin-toolbar">
          <label class="admin-week">Fecha
            <input id="disp-week" placeholder="Fecha 6" />
          </label>
          <label class="chk"><input id="disp-open" type="checkbox" checked /> Carga abierta</label>
          <button class="btn btn-ghost" type="button" id="disp-reload">Actualizar</button>
          <button class="btn btn-lime" type="button" id="disp-publish">Guardar fecha</button>
        </div>
      </div>
      <p class="admin-help">Las parejas cargan disponibilidad en /fecha/. Acá ves lo anotado y podés abrir o cerrar la fecha.</p>
      <p class="admin-msg" id="disp-msg"></p>
      <p class="tag" id="disp-count"></p>
      <div id="disp-list" class="disp-list"></div>
    </section>

    <section id="tab-academia" hidden>
      <p class="admin-help">Cambiá profes y textos de la academia. Un renglón por viñeta. Elegí la foto desde la computadora.</p>
      <form class="form cms-form" id="ac-copy">
        <label>Título (un renglón = un corte)
          <textarea name="title" rows="2"></textarea>
        </label>
        <label>Texto de arriba
          <textarea name="intro" rows="3"></textarea>
        </label>
        <label>Texto del equipo
          <input name="teamNote" />
        </label>
      </form>
      <div class="cms-head">
        <h3>Profes</h3>
        <button class="btn btn-ghost" type="button" id="staff-add">+ Agregar profe</button>
      </div>
      <div class="cms-list" id="staff-list"></div>
      <h3>Programas</h3>
      <div class="cms-list" id="prog-list"></div>
      <div class="admin-actions">
        <button class="btn btn-lime" type="button" id="ac-save">Guardar academia</button>
      </div>
      <p class="admin-msg" id="ac-msg"></p>
    </section>

    <section id="tab-sedes" hidden>
      <p class="admin-help">Complejos de la liga y la academia. Marcá dónde se ve cada uno.</p>
      <div class="cms-head">
        <h3>Sedes</h3>
        <button class="btn btn-ghost" type="button" id="venue-add">+ Agregar sede</button>
      </div>
      <div class="cms-list" id="venue-list"></div>
      <div class="cms-head">
        <h3>Otros complejos</h3>
        <button class="btn btn-ghost" type="button" id="more-add">+ Agregar</button>
      </div>
      <div class="cms-list" id="more-list"></div>
      <div class="admin-actions">
        <button class="btn btn-lime" type="button" id="venue-save">Guardar sedes</button>
      </div>
      <p class="admin-msg" id="venue-msg"></p>
    </section>

    <section id="tab-torneos" hidden>
      <p class="admin-help">Si no hay torneos, la web muestra el aviso de “sin torneos”. Si agregás uno, se publica en la página.</p>
      <form class="form cms-form" id="tn-copy">
        <label>Título
          <input name="title" />
        </label>
        <label>Texto de arriba
          <textarea name="intro" rows="3"></textarea>
        </label>
        <label>Aviso si no hay torneos
          <input name="emptyTitle" />
        </label>
        <label>Texto del aviso
          <textarea name="emptyText" rows="3"></textarea>
        </label>
      </form>
      <div class="cms-head">
        <h3>Torneos</h3>
        <button class="btn btn-ghost" type="button" id="tn-add">+ Agregar torneo</button>
      </div>
      <div class="cms-list" id="tn-list"></div>
      <div class="admin-actions">
        <button class="btn btn-lime" type="button" id="tn-save">Guardar torneos</button>
      </div>
      <p class="admin-msg" id="tn-msg"></p>
    </section>

    <section id="tab-sitio" hidden>
      <form class="form" id="site-form" style="max-width:640px">
        <label>Temporada en juego
          <input name="currentSeason" />
        </label>
        <label>WhatsApp (549…)
          <input name="whatsapp" />
        </label>
        <label>Instagram
          <input name="instagram" />
        </label>
        <label>Ciudad
          <input name="city" />
        </label>
        <label>Provincia
          <input name="province" />
        </label>
        <label>Texto de inicio
          <textarea name="ligaIntro" rows="6"></textarea>
        </label>
        <label>Token para cargar la fecha
          <input name="submitToken" type="password" autocomplete="off" placeholder="Mismo token de Publicar" />
        </label>
        <p class="admin-help">Con este token las parejas pueden cargar disponibilidad en /fecha/. Puede ser el mismo de Publicar. Después de guardarlo, esperá ~1 minuto.</p>
        <button class="btn btn-ghost" type="button" id="copy-submit-token">Usar el token de esta sesión</button>
        <button class="btn btn-lime" type="submit">Guardar sitio</button>
      </form>
      <p class="admin-msg" id="site-msg"></p>
    </section>
  </div>

  <script>
    import rankingJson from "../data/ranking.json";
    import fixtureJson from "../data/fixture.json";
    import siteJson from "../data/site.json";
    import auth from "../data/admin-auth.json";
    import dispJson from "../data/disponibilidad.json";
    import { applyFixtureResults, describeResult } from "../lib/scoring.js";
    import { pairLabel, loadDisponibilidad, saveDisponibilidad } from "../lib/disponibilidad.js";

    const HIDDEN_CATS = new Set(["S Masculina"]);
    const initialRows = rankingJson.filter((p) => !HIDDEN_CATS.has(p.cat));
    const initialSite = siteJson;
    const initialFixture = fixtureJson;
    const KEY = "liga-fb-gh-token";
    const AUTH_KEY = "liga-fb-admin-ok";
    const PASS_SALT = "liga-fb-admin-v1";
    const owner = initialSite.githubOwner;
    const repo = initialSite.githubRepo;
    const RANK_PATH = "src/data/ranking.json";
    const SITE_PATH = "src/data/site.json";
    let disp = structuredClone(dispJson);
    const FIXTURE_PATH = "src/data/fixture.json";
    const RANK_COLS = ["name", "cat", "pts", "pj", "dif", "pos", "temp"];
    const FX_COLS = ["categoria", "partido", "complejo", "cancha", "dia", "horario"];
    const CATS = ["A Masculina", "B Masculina", "C Masculina", "A Femenino", "B Femenino", "C Femenino"];
    const CAT_MAP = {
      "A MASC": "A Masculina", "A MASCULINA": "A Masculina",
      "B MASC": "B Masculina", "B MASCULINA": "B Masculina",
      "C MASC": "C Masculina", "C MASCULINA": "C Masculina",
      "A FEM": "A Femenino", "A FEMENINO": "A Femenino",
      "B FEM": "B Femenino", "B FEMENINO": "B Femenino",
      "C FEM": "C Femenino", "C FEMENINO": "C Femenino",
    };
    const VENUE_MAP = {
      OPEN: "Open Padel", "OPEN PADEL": "Open Padel",
      AMERICAS: "Americas Padel", "AMÉRICAS": "Americas Padel", "AMERICAS PADEL": "Americas Padel",
      PALERMO: "Palermo Padel", "PALERMO PÁDEL": "Palermo Padel", "PALERMO PADEL": "Palermo Padel",
      TERRAZAS: "Terrazas Padel", "TERRAZAS PADEL": "Terrazas Padel",
      BENGURION: "Bengurion Padel", "BEN GURION": "Bengurion Padel",
    };

    let rows = structuredClone(initialRows);
    let siteData = structuredClone(initialSite);
    let fixture = structuredClone(initialFixture || []);
    const BASE = import.meta.env.BASE_URL || "/";
    let token = sessionStorage.getItem(KEY) || "";
    let filterTemp = siteData.currentSeason || "T4";
    let filterCat = "TODAS";

    const $ = (id) => document.getElementById(id);
    const gate = $("gate");
    const app = $("app");

    function toB64(str) {
      return btoa(unescape(encodeURIComponent(str)));
    }
    function fromB64(b64) {
      return decodeURIComponent(escape(atob(b64)));
    }
    function headers() {
      return {
        Accept: "application/vnd.github+json",
        Authorization: "Bearer " + token,
        "Content-Type": "application/json",
        "X-GitHub-Api-Version": "2022-11-28",
      };
    }
    function msg(el, text, kind) {
      el.textContent = text;
      el.className = "admin-msg" + (kind ? " " + kind : "");
    }
    function num(v) {
      const n = Number(v);
      return Number.isFinite(n) ? n : 0;
    }
    function cleanRow(r) {
      return {
        name: String(r.name || "").trim(),
        cat: String(r.cat || "").trim(),
        pts: num(r.pts),
        pj: num(r.pj),
        dif: num(r.dif),
        pos: num(r.pos),
        temp: String(r.temp || siteData.currentSeason || "T4").trim().toUpperCase(),
      };
    }

    async function api(path, opts = {}) {
      const res = await fetch("https://api.github.com" + path, {
        ...opts,
        headers: { ...headers(), ...(opts.headers || {}) },
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        throw new Error(data.message || "Error GitHub " + res.status);
      }
      return data;
    }

    async function getFileSha(filePath) {
      const res = await fetch(`https://api.github.com/repos/${owner}/${repo}/contents/${filePath}`, {
        headers: headers(),
      });
      if (res.status === 404) return null;
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.message || "Error GitHub " + res.status);
      return data.sha || null;
    }

    async function publishFile(filePath, content, message, alreadyB64 = false) {
      const sha = await getFileSha(filePath);
      const body = {
        message,
        content: alreadyB64 ? content : toB64(content),
        branch: "main",
      };
      if (sha) body.sha = sha;
      await api(`/repos/${owner}/${repo}/contents/${filePath}`, {
        method: "PUT",
        body: JSON.stringify(body),
      });
    }
    async function publishFiles(files, message) {
      const ref = await api(`/repos/${owner}/${repo}/git/refs/heads/main`);
      const baseSha = ref.object.sha;
      const baseCommit = await api(`/repos/${owner}/${repo}/git/commits/${baseSha}`);
      const tree = await api(`/repos/${owner}/${repo}/git/trees`, {
        method: "POST",
        body: JSON.stringify({
          base_tree: baseCommit.tree.sha,
          tree: files.map((f) => ({
            path: f.path,
            mode: "100644",
            type: "blob",
            content: f.content,
          })),
        }),
      });
      const commit = await api(`/repos/${owner}/${repo}/git/commits`, {
        method: "POST",
        body: JSON.stringify({
          message,
          tree: tree.sha,
          parents: [baseSha],
        }),
      });
      await api(`/repos/${owner}/${repo}/git/refs/heads/main`, {
        method: "PATCH",
        body: JSON.stringify({ sha: commit.sha }),
      });
    }

    function temps() {
      return [...new Set(rows.map((r) => r.temp))].sort();
    }
    function catsInView() {
      const list = filterTemp === "TODAS" ? rows : rows.filter((r) => r.temp === filterTemp);
      return [...new Set(list.map((r) => r.cat))].sort();
    }

    function fillFilters() {
      const tlist = temps();
      if (filterTemp !== "TODAS" && tlist.length && !tlist.includes(filterTemp)) {
        filterTemp = tlist.includes(siteData.currentSeason) ? siteData.currentSeason : tlist[0];
      }
      const counts = Object.fromEntries(tlist.map((t) => [t, rows.filter((r) => r.temp === t).length]));
      $("f-temps").innerHTML = tlist
        .map((t) => `<button class="seg-item${t === filterTemp ? " on" : ""}" type="button" data-temp="${t}"><strong>${t}</strong><span>${counts[t] || 0}</span></button>`)
        .join("");
      const catList = catsInView();
      if (filterCat !== "TODAS" && !catList.includes(filterCat)) filterCat = "TODAS";
      $("f-cats").innerHTML =
        `<button class="pill${filterCat === "TODAS" ? " on" : ""}" type="button" data-cat="TODAS">Todas</button>` +
        catList.map((c) => `<button class="pill${c === filterCat ? " on" : ""}" type="button" data-cat="${c}">${c}</button>`).join("");
    }

    function visible() {
      const q = ($("f-q").value || "").trim().toLowerCase();
      return rows
        .map((r, i) => ({ r, i }))
        .filter(({ r }) => {
          if (filterTemp !== "TODAS" && r.temp !== filterTemp) return false;
          if (filterCat !== "TODAS" && r.cat !== filterCat) return false;
          if (q && !(r.name || "").toLowerCase().includes(q)) return false;
          return true;
        });
    }

    function renderTable() {
      const list = visible();
      $("rank-count").textContent = list.length + " visibles · " + rows.length + " total";
      $("tbody").innerHTML = list
        .map(({ r, i }) => {
          const catOpts = [...new Set([...CATS, r.cat].filter(Boolean))]
            .map((c) => `<option ${c === r.cat ? "selected" : ""}>${c}</option>`)
            .join("");
          const tempOpts = [...new Set([...(temps().length ? temps() : ["T4"]), r.temp])]
            .map((t) => `<option ${t === r.temp ? "selected" : ""}>${t}</option>`)
            .join("");
          return `<tr data-i="${i}">
            <td class="col-pos"><input data-k="pos" type="number" inputmode="numeric" value="${r.pos}" /></td>
            <td><input class="admin-name" data-k="name" value="${String(r.name).replace(/"/g, "&quot;")}" /></td>
            <td class="col-cat"><select data-k="cat">${catOpts}</select></td>
            <td class="col-num"><input data-k="pj" type="number" inputmode="numeric" value="${r.pj}" /></td>
            <td class="col-num"><input data-k="dif" type="number" inputmode="numeric" value="${r.dif}" /></td>
            <td class="col-num"><input data-k="pts" type="number" inputmode="numeric" value="${r.pts}" /></td>
            <td class="col-temp"><select data-k="temp">${tempOpts}</select></td>
            <td class="col-del"><button class="admin-del" type="button" data-del="${i}" aria-label="Eliminar">×</button></td>
          </tr>`;
        })
        .join("");
    }

    function fillSiteForm() {
      const form = $("site-form");
      form.currentSeason.value = siteData.currentSeason || "T4";
      form.whatsapp.value = siteData.whatsapp || "";
      form.instagram.value = siteData.instagram || "";
      form.city.value = siteData.city || "";
      form.province.value = siteData.province || "";
      form.ligaIntro.value = siteData.ligaIntro || "";
      form.submitToken.value = siteData.submitToken || "";
    }

    function ensureCms() {
      if (!siteData.academia) siteData.academia = {};
      if (!Array.isArray(siteData.academia.programs)) {
        siteData.academia.programs = [
          { n: "01", title: "Adultos", text: "" },
          { n: "02", title: "Niños", text: "" },
          { n: "03", title: "Personalizado", text: "" },
        ];
      }
      if (!Array.isArray(siteData.staff)) siteData.staff = [];
      if (!siteData.torneos) siteData.torneos = {};
      if (!Array.isArray(siteData.torneos.items)) siteData.torneos.items = [];
      if (!Array.isArray(siteData.venues)) siteData.venues = [];
      if (!Array.isArray(siteData.moreVenues)) siteData.moreVenues = [];
    }

    function escAttr(s) {
      return String(s ?? "")
        .replace(/&/g, "&amp;")
        .replace(/"/g, "&quot;")
        .replace(/</g, "&lt;");
    }

    function assetUrl(path) {
      if (!path) return "";
      if (String(path).startsWith("data:")) return path;
      return BASE + String(path).replace(/^\//, "");
    }

    function slugify(s) {
      return String(s || "foto")
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, "-")
        .replace(/^-|-$/g, "") || "foto";
    }

    function fileExt(file) {
      const n = String(file?.name || "").split(".").pop().toLowerCase();
      if (["png", "jpg", "jpeg", "webp", "gif"].includes(n)) return n === "jpeg" ? "jpg" : n;
      return "png";
    }

    function fileToB64(file) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = () => resolve(String(reader.result).split(",")[1] || "");
        reader.onerror = reject;
        reader.readAsDataURL(file);
      });
    }

    function photoBox(src, alt) {
      if (src) return `<img class="cms-photo" src="${escAttr(assetUrl(src))}" alt="${escAttr(alt)}" />`;
      return `<div class="cms-photo cms-photo-empty">Sin foto</div>`;
    }
    function cmsMedia(src, alt, actions) {
      return `<div class="cms-media">${photoBox(src, alt)}<div class="cms-card-actions">${actions}</div></div>`;
    }

    function fillAcademiaForm() {
      ensureCms();
      const ac = siteData.academia;
      const form = $("ac-copy");
      form.title.value = ac.title || "";
      form.intro.value = ac.intro || "";
      form.teamNote.value = ac.teamNote || "";
      $("staff-list").innerHTML = siteData.staff
        .map((p, i) => `<article class="cms-card" data-staff="${i}">
