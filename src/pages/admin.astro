    async function readRemoteSite() {
      const file = await api(`/repos/${owner}/${repo}/contents/${SITE_PATH}?ref=main`);
      const raw = String(file.content || "").replace(/\n/g, "");
      return JSON.parse(fromB64(raw));
    }
    async function publishSiteFields(fields, message) {
      const remote = await readRemoteSite();
      const next = { ...remote, ...fields };
      await publishFile(SITE_PATH, JSON.stringify(next, null, 2) + "\n", message);
      Object.assign(siteData, next);
    }

    async function uploadPending(list, kind) {
      for (const item of list) {
        if (!item?._file) continue;
        const name = slugify(item.name || kind) + "-" + Date.now() + "." + fileExt(item._file);
        const path = "public/images/" + name;
        await publishFile(path, await fileToB64(item._file), "Sube foto de " + (item.name || kind) + ".", true);
        item.image = "images/" + name;
        if (kind === "venue" || kind === "more") item.image = "/images/" + name;
        delete item._file;
        delete item._preview;
      }
    }

    function getPublishToken() {
      try {
        const data = JSON.parse(localStorage.getItem(AUTH_KEY) || sessionStorage.getItem(AUTH_KEY) || "{}");
        return String(data.token || "").trim();
      } catch {
        return "";
      }
    }
    function usePublishToken(el) {
      token = getPublishToken();
      if (!API_URL || !token) {
        msg(el, "La sesión segura venció. Volvé a ingresar al admin.", "err");
        return false;
      }
      return true;
    }
    function publishError(err) {
      const m = String(err?.message || err);
      if (/does not match/i.test(m)) {
        return "El sitio se actualizó en otro lado. Tocá Guardar de nuevo.";
      }
      if (/bad credentials/i.test(m) || /\b401\b/.test(m)) {
        return "No se pudo guardar. El permiso de publicación del sitio está vencido.";
      }
      return m;
    }
