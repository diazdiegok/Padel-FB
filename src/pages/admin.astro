    $("disp-publish").addEventListener("click", async () => {
      token = $("gh-token").value.trim();
      if (!token) {
        msg($("disp-msg"), "Para guardar pegá un token de GitHub arriba.", "err");
        $("gh-token").focus();
        return;
      }
      sessionStorage.setItem(KEY, token);
