---
import Layout from "../layouts/Layout.astro";
import fixture from "../data/fixture.json";
import results from "../data/results.json";
import { site } from "../data/site";
import { combineResults, seasonLabel, seasonNumber, weekNumber } from "../lib/liga.js";

const DAY_ORDER = ["lunes", "martes", "miércoles", "miercoles", "jueves", "viernes", "sábado", "sabado", "domingo"];
const dayIdx = (d: string) => {
  const key = String(d || "").trim().toLowerCase();
  const i = DAY_ORDER.indexOf(key);
  return i < 0 ? 99 : i;
};
const matches = combineResults(results, fixture.filter((m: any) => m.home && m.away)).sort((a, b) => {
  const da = dayIdx(a.day);
  const db = dayIdx(b.day);
  if (da !== db) return da - db;
  return String(a.time || "").localeCompare(String(b.time || ""), "es");
});
const seasons = [...new Set(matches.map((m) => m.temp || site.currentSeason || "T4"))]
  .sort((a, b) => seasonNumber(b) - seasonNumber(a));
const seasonBlocks = seasons.map((temp) => {
  const list = matches.filter((m) => (m.temp || site.currentSeason || "T4") === temp);
  const weeks = [...new Set(list.map((m) => m.week || "Sin fecha"))]
    .sort((a, b) => weekNumber(b) - weekNumber(a) || String(a).localeCompare(String(b), "es"));
  const cards = weeks.map((week) => {
    const weekList = list.filter((m) => (m.week || "Sin fecha") === week);
    const played = weekList.filter((m) => String(m.result || "").trim()).length;
    return { week, temp, total: weekList.length, played };
  });
  return {
    temp,
    title: seasonLabel(temp),
    total: list.length,
    live: temp === (site.currentSeason || ""),
    cards,
  };
});
const cards = seasonBlocks.flatMap((block) => block.cards);
const first = cards[0];
---
<Layout
  title="Resultados | Padel FB"
  description="Resultados por fecha de Padel FB en Paraná."
>
  <div class="wrap">
    <header class="page-hero">
      <p class="kicker">Liga</p>
      <h1>Resultados</h1>
      <p>Cada temporada es una caja. Adentro están las fechas.</p>
    </header>

    {cards.length === 0 ? (
      <p class="empty" style="display:block;padding:48px 0">Próximamente. Cuando se publique la Fecha 1 van a aparecer acá.</p>
    ) : (
      seasonBlocks.map((block, s) => (
        <section class:list={["season-box", { open: s === 0 }]} data-res-season={block.temp}>
          <header class="season-box-head">
            <p class="kicker">Temporada{block.live ? " · En juego" : ""}</p>
            <h2>{block.title}</h2>
            <p>{block.cards.length} fecha{block.cards.length === 1 ? "" : "s"}</p>
          </header>
          <div class="result-grid">
            {block.cards.map((c, i) => (
              <button
                class:list={["result-card", { open: s === 0 && i === 0 }]}
                type="button"
                data-week={c.week}
                data-temp={c.temp}
              >
                <p class="kicker">Fecha</p>
                <h2>{c.week}</h2>
                <p>{c.played} / {c.total} resultados</p>
              </button>
            ))}
          </div>
          <div class="season-box-body" data-res-body hidden={s !== 0}>
            <div data-res-root></div>
          </div>
        </section>
      ))
    )}
  </div>

  <script>
    import { describeResult } from "../lib/scoring.js";
    window.__ligaScoring = { describeResult };
  </script>
  <script define:vars={{ matches, first }}>
    let week = first?.week || "";
    let temp = first?.temp || "";

    const describeResult = (raw) => window.__ligaScoring?.describeResult?.(raw) || null;
    function esc(s) {
      return String(s ?? "").replace(/[&<>"']/g, (c) =>
        ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c])
      );
    }

    function activeRoot() {
      return document.querySelector(`.season-box[data-res-season="${temp}"] [data-res-root]`);
    }

    function render() {
      const root = activeRoot();
      if (!root) return;
      const list = matches.filter((m) =>
        (m.week || "Sin fecha") === week && (m.temp || "") === temp
      );
      const groups = [...new Set(list.map((m) => m.cat || "Sin categoría"))];
      root.innerHTML = `<section class="fixture-week" style="padding-top:0">
        <h2>${esc(week)}</h2>
        ${groups
          .map((cat) => {
            const rows = list.filter((m) => (m.cat || "Sin categoría") === cat);
            return `<h3 class="kicker" style="margin:18px 0 10px">${esc(cat)}</h3>
              <div class="fixture-list">
                ${rows
                  .map((m) => {
                    const info = describeResult(m.result);
                    return `<article class="fixture-row">
                      <div class="fixture-meta">
                        <span>${esc(m.day || m.date)}</span>
                        <span>${esc(m.time)}</span>
                        <span>${esc(m.venue)}${m.court ? ` · ${esc(m.court)}` : ""}</span>
                      </div>
                      <div class="fixture-vs">
                        <div class="pair pair-a${info?.homeWin ? " winner" : ""}">
                          <span class="pair-label">Pareja 1</span>
                          <strong>${esc(m.home)}</strong>
                          ${info ? `<span class="pair-pts">${info.homePts} pts</span>` : ""}
                        </div>
                        <span class="vs">vs</span>
                        <div class="pair pair-b${info && !info.homeWin ? " winner" : ""}">
                          <span class="pair-label">Pareja 2</span>
                          <strong>${esc(m.away)}</strong>
                          ${info ? `<span class="pair-pts">${info.awayPts} pts</span>` : ""}
                        </div>
                      </div>
                      <div class="fixture-score">${
                        info
                          ? `<b>${esc(info.score)}</b><span>${info.label}</span>`
                          : m.result
                            ? `<b>${esc(m.result)}</b>`
                            : `<span class="tag">Pendiente</span>`
                      }</div>
                    </article>`;
                  })
                  .join("")}
              </div>`;
          })
          .join("")}
      </section>`;
    }

    document.querySelectorAll("[data-week]").forEach((btn) => {
      btn.addEventListener("click", () => {
        week = btn.dataset.week;
        temp = btn.dataset.temp || "";
        document.querySelectorAll(".season-box").forEach((box) => {
          const on = box.dataset.resSeason === temp;
          box.classList.toggle("open", on);
          const body = box.querySelector("[data-res-body]");
          if (body) body.hidden = !on;
        });
        document.querySelectorAll("[data-week]").forEach((b) => {
          b.classList.toggle("open", b.dataset.week === week && b.dataset.temp === temp);
        });
        render();
        document.querySelector(`.season-box[data-res-season="${temp}"]`)?.scrollIntoView({
          behavior: "smooth",
          block: "nearest",
        });
      });
    });
    if (first) render();
  </script>
</Layout>
