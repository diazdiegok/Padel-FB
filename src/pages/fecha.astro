---
import Layout from "../layouts/Layout.astro";
import { site } from "../data/site";
import disp from "../data/disponibilidad.json";
import parejas from "../data/parejas.json";
import { DAYS } from "../lib/disponibilidad.js";
import { deadlinePassed, deadlineText, validDeadline } from "../lib/cierre.js";

const base = import.meta.env.BASE_URL;
const season = (disp as any).temp || site.currentSeason;
const builtPairs = (parejas as any[])
  .filter((p) => p.temp === season)
  .map((p) => ({ id: p.id, p1: p.p1, p2: p.p2, cat: p.cat }));

const pad = (n: number) => String(n).padStart(2, "0");
const HOURS: string[] = [];
for (let m = 8 * 60; m <= 24 * 60; m += 30) HOURS.push(`${pad(Math.floor(m / 60) % 24)}:${pad(m % 60)}`);
const FROM_HOURS = HOURS.slice(0, -3);
const TO_HOURS = HOURS.slice(3);
const deadline = validDeadline(disp.deadline);
const cargaAbierta = disp.open !== false && !deadlinePassed(deadline);
---
<Layout
  title={`${disp.week} | Padel FB`}
  description={`Cargá disponibilidad de tu pareja para ${disp.week} de Padel FB en Paraná.`}
>
  <div class="wrap">
    <header class="page-hero">
      <p class="kicker">Disponibilidad · {site.currentSeason}</p>
      <h1>{disp.week}</h1>
      <p>
        Anotá los días y horarios en los que su pareja puede jugar. Con eso se arman los partidos
        de la fecha.
      </p>
      {deadline && (
        <p class="deadline" id="fecha-deadline"><strong>Cierra el</strong> {deadlineText(deadline)}</p>
      )}
    </header>

    <form class="form form-fecha" id="fecha-form" hidden={!cargaAbierta}>
        <div class="pair-picker" id="pair-picker">
          <label>Buscá tu pareja
            <input id="pair-q" type="search" placeholder="Escribí tu apellido" autocomplete="off" aria-controls="pair-results" />
          </label>
          <ul class="pair-results" id="pair-results" role="listbox" hidden></ul>
          <div class="pair-chosen" id="pair-chosen" hidden>
            <div>
              <strong id="pair-chosen-name"></strong>
              <span id="pair-chosen-cat"></span>
            </div>
            <button class="btn btn-ghost" type="button" id="pair-change">Cambiar</button>
          </div>
          <p class="form-hint">¿No aparece su pareja? <a href={`${base}inscribir-pareja/`}>Inscríbanla acá</a> (se hace una sola vez) y vuelvan.</p>
        </div>
        <fieldset class="form-set">
          <legend>¿Necesitan recuperar fecha?</legend>
          <div class="seg">
            <label class="seg-item"><input type="radio" name="recover" value="no" checked /> No</label>
            <label class="seg-item"><input type="radio" name="recover" value="si" /> Sí</label>
          </div>
        </fieldset>
        <fieldset class="form-set">
          <legend>Días que pueden jugar</legend>
          <div class="day-list">
            {DAYS.map((d) => (
              <div class="day-row">
                <label class="day-check">
                  <input type="checkbox" name="day" value={d} />
                  <span>{d}</span>
                </label>
                <span class="day-hours">
                  <select data-from={d} aria-label={`${d} desde`} disabled>
                    <option value="">Desde</option>
                    {FROM_HOURS.map((h) => <option value={h}>{h}</option>)}
                  </select>
                  <select data-to={d} aria-label={`${d} hasta`} disabled>
                    <option value="">Hasta</option>
                    {TO_HOURS.map((h) => <option value={h}>{h}</option>)}
                  </select>
                </span>
              </div>
            ))}
            <label class="day-row day-bye">
              <span class="day-check">
                <input type="checkbox" name="bye" />
                <span>No podemos jugar esta semana</span>
              </span>
            </label>
            <p class="form-hint">Cada partido dura 1:30. Cuanto más amplio el horario, más fácil es encontrarles rival.</p>
          </div>
        </fieldset>
        <label>Información adicional
          <textarea name="note" rows="3" placeholder="Sede, cancha, o cualquier dato extra…"></textarea>
        </label>
        <input class="hp" name="website" tabindex="-1" autocomplete="off" />
        <button class="btn btn-lime" type="submit" id="fecha-send">Enviar disponibilidad</button>
        <p class="admin-msg" id="fecha-msg" aria-live="polite"></p>
      </form>
      <p class="empty" id="fecha-closed" hidden={cargaAbierta}>
        La carga de {disp.week} está cerrada. Cuando se abra la próxima fecha va a aparecer acá.
      </p>
  </div>

  <script is:inline define:vars={{ builtPairs, season }}>
    window.__fechaPairs = { builtPairs, season };
  </script>
  <script>
    import site from "../data/site.json";
    import disp from "../data/disponibilidad.json";
    import { DAYS, cleanEntry, fold, validateEntry } from "../lib/disponibilidad.js";
    import { deadlinePassed, validDeadline } from "../lib/cierre.js";

    const apiUrl = String(site.apiUrl || "").replace(/\/$/, "");
    const form = document.querySelector("#fecha-form");
    const msg = document.querySelector("#fecha-msg");
    const closeForm = () => {
      if (!form) return;
      form.hidden = true;
      const closed = document.querySelector("#fecha-closed");
      const limit = document.querySelector("#fecha-deadline");
      if (closed) closed.hidden = false;
      if (limit) limit.hidden = true;
    };
    if (form && disp.open !== false) {
      const deadline = validDeadline(disp.deadline);
      if (deadlinePassed(deadline)) closeForm();
      else if (deadline) {
        const wait = Date.parse(`${deadline}:00-03:00`) - Date.now();
        if (wait > 0 && wait < 2147000000) setTimeout(closeForm, wait + 250);
      }
    }
    const bye = form?.querySelector("[name=bye]");
    const { builtPairs = [], season = "" } = window.__fechaPairs || {};
    let pairs = builtPairs;
    let chosen = null;

    function setMsg(text, kind) {
      if (!msg) return;
      msg.textContent = text;
      msg.className = "admin-msg" + (kind ? " " + kind : "");
    }

    const q = document.querySelector("#pair-q");
    const results = document.querySelector("#pair-results");
    const chosenBox = document.querySelector("#pair-chosen");

    async function loadPairs() {
      if (!apiUrl) return;
      try {
        const res = await fetch(`${apiUrl}/pairs?temp=${encodeURIComponent(season)}`);
        if (res.ok) {
          const live = await res.json();
          if (Array.isArray(live)) pairs = live;
        }
      } catch {
        /* queda la lista publicada */
      }
      if (q?.value) showResults();
    }

    function showResults() {
      const term = fold(q.value);
      results.innerHTML = "";
      if (term.length < 2) {
        results.hidden = true;
        return;
      }
      const words = term.split(" ");
      const found = pairs.filter((p) => {
        const blob = fold(`${p.p1} ${p.p2}`);
        return words.every((w) => blob.includes(w));
      }).slice(0, 8);
      if (!found.length) {
        const li = document.createElement("li");
        li.className = "pair-none";
        li.textContent = "No encontramos esa pareja. Si no se inscribieron, usen el link de abajo.";
        results.append(li);
      }
      for (const p of found) {
        const li = document.createElement("li");
        const btn = document.createElement("button");
        btn.type = "button";
        btn.setAttribute("role", "option");
        const name = document.createElement("strong");
        name.textContent = `${p.p1} / ${p.p2}`;
        const cat = document.createElement("span");
        cat.textContent = p.cat;
        btn.append(name, cat);
        btn.addEventListener("click", () => choose(p));
        li.append(btn);
        results.append(li);
      }
      results.hidden = false;
    }

    function choose(p) {
      chosen = p;
      document.querySelector("#pair-chosen-name").textContent = `${p.p1} / ${p.p2}`;
      document.querySelector("#pair-chosen-cat").textContent = p.cat;
      chosenBox.hidden = false;
      results.hidden = true;
      q.closest("label").hidden = true;
      setMsg("");
    }

    q?.addEventListener("input", showResults);
    document.querySelector("#pair-change")?.addEventListener("click", () => {
      chosen = null;
      chosenBox.hidden = true;
      q.closest("label").hidden = false;
      q.value = "";
      q.focus();
    });
    loadPairs();

    function syncDays() {
      const off = Boolean(bye?.checked);
      form?.querySelectorAll("[name=day]").forEach((box) => {
        box.disabled = off;
        if (off) box.checked = false;
        form.querySelectorAll(`[data-from="${box.value}"], [data-to="${box.value}"]`).forEach((sel) => {
          sel.disabled = off || !box.checked;
          if (sel.disabled) sel.value = "";
        });
      });
    }

    form?.querySelectorAll("[name=day]").forEach((box) => {
      box.addEventListener("change", syncDays);
    });
    bye?.addEventListener("change", syncDays);

    form?.querySelectorAll("input[name=recover]").forEach((radio) => {
      radio.addEventListener("change", () => {
        form.querySelectorAll(".seg-item").forEach((el) => el.classList.toggle("on", el.querySelector("input")?.checked));
      });
    });
    form?.querySelectorAll(".seg-item").forEach((el) => {
      el.classList.toggle("on", el.querySelector("input")?.checked);
    });

    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (form.website.value) return;
      const days = {};
      DAYS.forEach((day) => {
        const on = form.querySelector(`[name=day][value="${day}"]`)?.checked;
        const from = form.querySelector(`[data-from="${day}"]`)?.value || "";
        const to = form.querySelector(`[data-to="${day}"]`)?.value || "";
        if (on) days[day] = from && to ? `${from} - ${to}` : "";
      });
      if (!chosen) {
        setMsg("Buscá y elegí su pareja arriba. Si no aparece, inscríbanla primero.", "err");
        q?.focus();
        return;
      }
      const entry = cleanEntry({
        p1: chosen.p1,
        p2: chosen.p2,
        cat: chosen.cat,
        recover: form.recover.value === "si",
        bye: bye?.checked,
        days,
        note: form.note.value,
      });
      const err = validateEntry(entry);
      if (err) {
        setMsg(err, "err");
        return;
      }
      if (!apiUrl) {
        setMsg("La carga segura todavía no está configurada.", "err");
        return;
      }
      const btn = document.querySelector("#fecha-send");
      btn.disabled = true;
      setMsg("Enviando…");
      try {
        const res = await fetch(`${apiUrl}/availability`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ ...entry, pairId: chosen.id, website: form.website.value }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.message || "No se pudo enviar.");
        form.hidden = true;
        const ok = document.createElement("div");
        ok.className = "empty";
        ok.style.display = "block";
        ok.style.padding = "48px 0";
        const strong = document.createElement("strong");
        strong.textContent = "Listo. ";
        ok.append(strong, `${entry.p1} / ${entry.p2} quedó anotada. Cuando se cierre la carga se arma el fixture y lo ven en la sección Fixture.`);
        form.insertAdjacentElement("afterend", ok);
      } catch (ex) {
        setMsg(ex.message || "No se pudo enviar.", "err");
        btn.disabled = false;
      }
    });
  </script>
</Layout>
