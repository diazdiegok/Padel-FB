---
import Layout from "../../layouts/Layout.astro";
import { site } from "../../data/site";
import ascensosJson from "../../data/ascensos.json";
import { asset, page } from "../../lib/paths";

const items = (Array.isArray(ascensosJson) ? ascensosJson : [])
  .map((item) => ({
    id: String(item?.id || ""),
    title: String(item?.title || "").trim(),
    image: String(item?.image || "").replace(/^\//, "").trim(),
  }))
  .filter((item) => item.title && item.image);
---
<Layout
  title="Ascensos | Padel FB"
  description={`Ascensos de la liga Padel FB en ${site.city}.`}
>
  <div class="wrap">
    <header class="page-hero">
      <p class="kicker">Liga</p>
      <h1>Ascensos</h1>
      <p>Las fotos de los ascensos de cada temporada.</p>
    </header>

    {items.length === 0 ? (
      <div class="coming">
        <p class="kicker" style="margin:0 0 12px">Pronto</p>
        <h2 style="margin-bottom:12px">Todavía no hay ascensos publicados</h2>
        <p style="margin:0 0 24px">Cuando se carguen desde el admin, van a aparecer acá.</p>
        <div class="actions" style="margin:0">
          <a class="btn btn-ghost" href={page("liga/")}>Volver a Liga</a>
        </div>
      </div>
    ) : (
      <div class="ascensos-list">
        {items.map((item) => (
          <article class="ascensos-card">
            <h2>{item.title}</h2>
            <button
              class="ascensos-figure"
              type="button"
              data-asc-open
              data-src={asset(item.image)}
              data-title={item.title}
              aria-label={`Ampliar ${item.title}`}
            >
              <span class="ascensos-bg" aria-hidden="true">
                <img src={asset(item.image)} alt="" loading="lazy" />
              </span>
              <span class="ascensos-shot">
                <img class="photo" src={asset(item.image)} alt={item.title} loading="lazy" />
              </span>
            </button>
          </article>
        ))}
      </div>
    )}
  </div>

  {items.length > 0 && (
    <dialog class="ascensos-lightbox" id="ascensos-lightbox" aria-label="Foto de ascensos">
      <div class="ascensos-lightbox-bg" aria-hidden="true">
        <img id="ascensos-lightbox-bg-img" alt="" />
      </div>
      <div class="ascensos-lightbox-panel">
        <div class="ascensos-lightbox-bar">
          <p class="ascensos-lightbox-title" id="ascensos-lightbox-title"></p>
          <button class="ascensos-lightbox-close" type="button" id="ascensos-lightbox-close" aria-label="Cerrar">×</button>
        </div>
        <img class="ascensos-lightbox-img" id="ascensos-lightbox-img" alt="" />
      </div>
    </dialog>
  )}

  {items.length > 0 && (
    <script>
      const box = document.getElementById("ascensos-lightbox");
      const img = document.getElementById("ascensos-lightbox-img");
      const bgImg = document.getElementById("ascensos-lightbox-bg-img");
      const title = document.getElementById("ascensos-lightbox-title");
      const closeBtn = document.getElementById("ascensos-lightbox-close");
      if (box && img && title && bgImg) {
        function openLightbox(src, name) {
          img.src = src;
          img.alt = name || "Ascensos";
          bgImg.src = src;
          title.textContent = name || "";
          if (typeof box.showModal === "function") box.showModal();
          else box.setAttribute("open", "");
        }
        function closeLightbox() {
          if (typeof box.close === "function") box.close();
          else box.removeAttribute("open");
          img.removeAttribute("src");
          bgImg.removeAttribute("src");
        }
        document.querySelectorAll("[data-asc-open]").forEach((btn) => {
          btn.addEventListener("click", () => openLightbox(btn.dataset.src, btn.dataset.title));
        });
        closeBtn?.addEventListener("click", closeLightbox);
        box.addEventListener("click", (e) => {
          if (e.target === box || e.target.closest(".ascensos-lightbox-bg")) closeLightbox();
        });
        box.addEventListener("cancel", (e) => {
          e.preventDefault();
          closeLightbox();
        });
      }
    </script>
  )}
</Layout>
