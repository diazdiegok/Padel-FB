---
import Layout from "../layouts/Layout.astro";
import { site } from "../data/site";
import ranking from "../data/ranking.json";
import { listSeasons } from "../lib/liga.js";
import { asset, page } from "../lib/paths";

const HIDDEN_CATS = new Set(["S Masculina"]);
const rows = ranking.filter((p) => !HIDDEN_CATS.has(p.cat));
const current = site.currentSeason || "T4";
const seasons = listSeasons(site, rows.map((p) => p.temp));
const seasonCounts = Object.fromEntries(seasons.map((t) => [t, rows.filter((p) => p.temp === t).length]));
const live = rows.filter((p) => p.temp === current);
const cats = [...new Set(live.map((p) => p.cat))];
const leaders = cats
  .map((cat) => live.filter((p) => p.cat === cat).sort((a, b) => a.pos - b.pos || b.pts - a.pts)[0])
  .filter(Boolean);
const countedVenues = (site.venues || []).filter((v) => v.liga !== false).length;
const leagueVenueCount = Number.isFinite(Number(site.leagueVenueCount)) ? Number(site.leagueVenueCount) : countedVenues;
---
<Layout
  title={`Padel FB | Liga y academia de pádel en ${site.city}`}
  description={`Liga y academia de pádel de Fabián Borini en ${site.city}. Ranking, fixture y clases de adultos y niños.`}
>
  <div class="hero-media" style={`--hero-img: url('${asset("images/DJI_0239-scaled.jpg")}')`}>
    <div class="wrap">
      <header class="hero">
        <div>
          <p class="kicker">{site.city} · Lunes a sábado · Liga + Academia</p>
          <h1>Sin esfuerzo<br />no hay gloria</h1>
          <p class="lead">{site.ligaIntro}</p>
          <div class="actions">
            <a class="btn btn-lime" href={page("liga/")}>Entrar a la liga</a>
            <a class="btn btn-ghost" href={page("academia/")}>Ver academia</a>
          </div>
        </div>
        <aside class:list={["scoreboard", { "is-empty": leaders.length === 0 }]}>
          <header>
            <span>Líderes {current}</span>
            <span class="live">En juego</span>
          </header>
          {leaders.length === 0 && <p class="empty-season">La tabla de esta temporada todavía no está publicada.</p>}
          {leaders.map((p) => p && (
            <div class="row-player">
              <span class="pos">{p.pos}</span>
              <div>
                {p.name}
                <div class="cat">{p.cat} · {p.pts} pts</div>
              </div>
              <span class="pts">{p.pts}</span>
            </div>
          ))}
        </aside>
      </header>
    </div>
  </div>

  <div class="wrap">
    <div class="home-stats">
      <div class="home-cell">
        <span class="filter-kicker">Temporada</span>
        <div class="seg" id="home-temps">
          {seasons.map((t) => (
            <button class:list={["seg-item", { on: t === current }]} type="button" data-temp={t}>
              <strong>{t}</strong>
            </button>
          ))}
        </div>
      </div>
      <div class="home-cell">
        <b id="home-players">{seasonCounts[current] || 0}</b>
        <span id="home-players-label">Jugadores en {current}</span>
      </div>
      <div class="home-cell">
        <b>{leagueVenueCount}</b>
        <span>Sedes de la liga</span>
      </div>
      <div class="home-cell">
        <b>1</b>
        <span>Partido por semana</span>
      </div>
    </div>
  </div>
  <script define:vars={{ seasonCounts }}>
    const counts = seasonCounts;
    const num = document.querySelector("#home-players");
    const label = document.querySelector("#home-players-label");
    document.querySelectorAll("#home-temps [data-temp]").forEach((btn) => {
      btn.addEventListener("click", () => {
        document.querySelectorAll("#home-temps [data-temp]").forEach((b) => b.classList.remove("on"));
        btn.classList.add("on");
        const temp = btn.dataset.temp;
        num.textContent = String(counts[temp] || 0);
        label.textContent = "Jugadores en " + temp;
      });
    });
  </script>

  <section>
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="kicker">La liga</p>
          <h2>Cómo se juega</h2>
        </div>
        <p>Categorías A, B y C. Damas y caballeros. Puntos individuales. Un partido por semana, lunes a sábado.</p>
      </div>
      <div class="steps">
        <article class="step">
          <div class="n">01</div>
          <h3>Te anotas</h3>
          <p>Elegís categoría. Te confirmamos por WhatsApp y entras al fixture.</p>
        </article>
        <article class="step">
          <div class="n">02</div>
          <h3>Tarde/Noche</h3>
          <p>En distintos complejos de la ciudad, según el fixture de cada semana.</p>
        </article>
        <article class="step">
          <div class="n">03</div>
          <h3>Subís en la tabla</h3>
          <p>Buscás tu nombre. Ves posición, partidos y diferencia de sets. Cuatro temporadas publicadas.</p>
        </article>
      </div>
    </div>
  </section>

  <div class="wrap" style="padding:64px 0 24px">
    <div class="section-head">
      <div>
        <p class="kicker">Tres caminos</p>
        <h2>Elegí dónde vas</h2>
      </div>
    </div>
    <div class="hub-grid">
      <a class="hub-card" href={page("liga/")}>
        <p class="kicker" style="margin:0">Competí</p>
        <h2>Liga</h2>
        <p>Ranking, fixture, resultados, fecha y sedes de la competencia.</p>
      </a>
      <a class="hub-card" href={page("academia/")}>
        <p class="kicker" style="margin:0">Entrená</p>
        <h2>Academia</h2>
        <p>Clases de adultos e infantiles, más las sedes donde se entrena.</p>
      </a>
      <a class="hub-card" href={page("torneos/")}>
        <p class="kicker" style="margin:0">Próximamente</p>
        <h2>Torneos</h2>
        <p>Espacio listo para futuros torneos abiertos y brackets.</p>
      </a>
    </div>
  </div>

</Layout>
