---
import Layout from "../layouts/Layout.astro";
import { site } from "../data/site";
import ranking from "../data/ranking.json";
import { asset, page } from "../lib/paths";
import VenueLinks from "../components/VenueLinks.astro";

const HIDDEN_CATS = new Set(["S Masculina"]);
const rows = ranking.filter((p) => !HIDDEN_CATS.has(p.cat));
const current = site.currentSeason || "T4";
const live = rows.filter((p) => p.temp === current);
const cats = [...new Set(live.map((p) => p.cat))];
const leaders = cats
  .map((cat) => live.filter((p) => p.cat === cat).sort((a, b) => a.pos - b.pos || b.pts - a.pts)[0])
  .filter(Boolean);
const totalPlayers = rows.length;
const leagueVenues = (site.venues || []).filter((v) => v.liga !== false);
const featuredVenues = leagueVenues.slice(0, 4);
---
<Layout
  title={`Padel FB | Liga y academia de pádel en ${site.city}`}
  description={`Liga y academia de pádel de Fabián Borini en ${site.city}. Ranking, fixture y clases de adultos y niños.`}
>
  <div class="hero-media" style={`--hero-img: url('${asset("images/DJI_0239-scaled.jpg")}')`}>
    <div class="wrap">
      <header class="hero">
        <div>
          <p class="kicker">{site.city} · Lunes a sábado · Liga + Academia</p>
          <h1>Sin esfuerzo<br />no hay gloria</h1>
          <p class="lead">{site.ligaIntro}</p>
          <div class="actions">
            <a class="btn btn-lime" href={page("liga/")}>Entrar a la liga</a>
            <a class="btn btn-ghost" href={page("academia/")}>Ver academia</a>
          </div>
        </div>
        <aside class="scoreboard">
          <header>
            <span>Líderes {current}</span>
            <span class="live">En juego</span>
          </header>
          {leaders.map((p) => p && (
            <div class="row-player">
              <span class="pos">{p.pos}</span>
              <div>
                {p.name}
                <div class="cat">{p.cat} · {p.pts} pts</div>
              </div>
              <span class="pts">{p.pts}</span>
            </div>
          ))}
        </aside>
      </header>
    </div>
  </div>

  <div class="wrap">
    <div class="stats">
      <div class="stat"><b>{totalPlayers}</b><span>Jugadores totales (todas las temporadas)</span></div>
      <div class="stat"><b>{leagueVenues.length}</b><span>Sedes de la liga</span></div>
      <div class="stat"><b>1</b><span>Partido por semana</span></div>
    </div>
  </div>

  <section>
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="kicker">La liga</p>
          <h2>Cómo se juega</h2>
        </div>
        <p>Categorías A, B y C. Damas y caballeros. Puntos individuales. Un partido por semana, lunes a sábado.</p>
      </div>
      <div class="steps">
        <article class="step">
          <div class="n">01</div>
          <h3>Te anotas</h3>
          <p>Elegís categoría. Te confirmamos por WhatsApp y entras al fixture.</p>
        </article>
        <article class="step">
          <div class="n">02</div>
          <h3>Jugás de noche</h3>
          <p>En distintos complejos de la ciudad, según el fixture de cada semana.</p>
        </article>
        <article class="step">
          <div class="n">03</div>
          <h3>Subís en la tabla</h3>
          <p>Buscás tu nombre. Ves posición, partidos y diferencia de sets. Cuatro temporadas publicadas.</p>
        </article>
      </div>
    </div>
  </section>

  <div class="wrap" style="padding:64px 0 24px">
    <div class="section-head">
      <div>
        <p class="kicker">Tres caminos</p>
        <h2>Elegí dónde vas</h2>
      </div>
    </div>
    <div class="hub-grid">
      <a class="hub-card" href={page("liga/")}>
        <p class="kicker" style="margin:0">Competí</p>
        <h2>Liga</h2>
        <p>Ranking, fixture, resultados, fecha y sedes de la competencia.</p>
      </a>
      <a class="hub-card" href={page("academia/")}>
        <p class="kicker" style="margin:0">Entrená</p>
        <h2>Academia</h2>
        <p>Clases de adultos e infantiles, más las sedes donde se entrena.</p>
      </a>
      <a class="hub-card" href={page("torneos/")}>
        <p class="kicker" style="margin:0">Próximamente</p>
        <h2>Torneos</h2>
        <p>Espacio listo para futuros torneos abiertos y brackets.</p>
      </a>
    </div>
  </div>

  <section>
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="kicker">Liga</p>
          <h2>Sedes oficiales</h2>
        </div>
        <a class="btn btn-ghost" href={page("sedes/")}>Todas las sedes</a>
      </div>
      <div class="venues">
        {featuredVenues.map((v) => (
          <article class="venue">
            <div class="venue-photo">
              <img class="photo" src={asset(v.image)} alt={`${v.name}, cancha de pádel en ${v.address}`} loading="lazy" />
              <span>Abierta</span>
            </div>
            <div class="venue-body">
              <h3>{v.name}</h3>
              <p>{v.address}</p>
              <VenueLinks maps={v.maps} instagram={v.instagram} whatsapp={v.whatsapp} />
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>
