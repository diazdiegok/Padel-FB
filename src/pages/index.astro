---
import Layout from "../layouts/Layout.astro";
import { site } from "../data/site";
import ranking from "../data/ranking.json";
import playoffJson from "../data/playoff.json";
import { normalizePlayoffs, playoffSlug, resolveCategory } from "../lib/playoff.js";
import { listSeasons, seasonLabel } from "../lib/liga.js";
import { asset, page } from "../lib/paths";

const HIDDEN_CATS = new Set(["S Masculina"]);
const rows = ranking.filter((p) => !HIDDEN_CATS.has(p.cat));
const current = site.currentSeason || "T4";
const showPlayoff = Boolean(site.showPlayoff);
const upcomingRaw = String(site.upcomingSeason || "").trim().toUpperCase();
const upcoming = upcomingRaw && upcomingRaw !== current ? upcomingRaw : "";
const seasons = listSeasons(site, rows.map((p) => p.temp));
const seasonCounts = Object.fromEntries(seasons.map((t) => [t, rows.filter((p) => p.temp === t).length]));
const live = rows.filter((p) => p.temp === current);
const seasonStarted = live.some((p) => Number(p.pts) > 0 || Number(p.pj) > 0);
const cats = [...new Set(live.map((p) => p.cat))];
const leaders = cats
  .map((cat) => live.filter((p) => p.cat === cat).sort((a, b) => a.pos - b.pos || b.pts - a.pts)[0])
  .filter(Boolean);
const currentPlayoff = normalizePlayoffs(playoffJson).find((p) => p.temp === current && p.categories.length);
const champions = currentPlayoff
  ? currentPlayoff.categories.map(resolveCategory).filter((c) => c.champion)
  : [];
const playoffDone = Boolean(currentPlayoff && champions.length > 0 && champions.length === currentPlayoff.categories.length);
const boardRows = playoffDone
  ? champions.map((c) => ({ name: c.champion, cat: c.cat }))
  : seasonStarted
    ? leaders.map((p) => ({ name: p.name, cat: `${p.cat} · ${p.pts} pts`, pts: p.pts, pos: p.pos }))
    : [];
const boardTitle = playoffDone
  ? `Campeones ${seasonLabel(current)}`
  : seasonStarted
    ? `Líderes ${current}`
    : seasonLabel(current);
const countedVenues = (site.venues || []).filter((v) => v.liga !== false).length;
const savedVenues = site.seasonVenues && typeof site.seasonVenues === "object" ? site.seasonVenues : {};
const seasonVenues = Object.fromEntries(
  seasons.map((t) => {
    const n = Number(savedVenues[t]);
    return [t, Number.isFinite(n) ? n : countedVenues];
  })
);
---
<Layout
  title={`Padel FB | Liga y academia de pádel en ${site.city}`}
  description={`Liga y academia de pádel de Fabián Borini en ${site.city}. Ranking, fixture y clases de adultos y niños.`}
>
  <div class="hero-media home-open" style={`--hero-img: url('${asset("images/DJI_0239-scaled.jpg")}')`}>
    <div class="wrap">
      <header class="hero">
        <div>
          <p class="kicker">{site.city} · Lunes a sábado · Liga + Academia</p>
          <span class="home-sweep" aria-hidden="true"></span>
          <h1>Sin esfuerzo<br />no hay gloria</h1>
          <p class="lead">{site.ligaIntro}</p>
          <div class="actions">
            {showPlayoff && <a class="btn btn-lime" href={page(`playoff/${playoffSlug(current)}/`)}>Ver playoff</a>}
            <a class:list={["btn", showPlayoff ? "btn-ghost" : "btn-lime"]} href={page("liga/")}>Entrar a la liga</a>
            <a class="btn btn-ghost" href={page("academia/")}>Ver academia</a>
          </div>
        </div>
        <div class="home-board">
          {upcoming && <p class="home-soon">Próximamente {seasonLabel(upcoming)}</p>}
          <aside class:list={["scoreboard", { "is-empty": boardRows.length === 0, "is-finished": playoffDone }]}>
            <header>
              {playoffDone ? (
                <span class="live">{boardTitle}</span>
              ) : (
                <span>{boardTitle}</span>
              )}
              {playoffDone ? (
                <span class="status-done">Finalizado</span>
              ) : seasonStarted ? (
                <span class="live">En juego</span>
              ) : (
                <span class="status-soon">Próximamente</span>
              )}
            </header>
            {boardRows.length === 0 && (
              <p class="empty-season">
                {seasonStarted
                  ? "La tabla de esta temporada todavía no está publicada."
                  : `${seasonLabel(current)} todavía no comenzó. Cuando haya resultados aparecen los líderes.`}
              </p>
            )}
            {boardRows.map((p) => (
              <div class="row-player">
                <span class="pos">{playoffDone ? "🥇" : p.pos}</span>
                <div>
                  {p.name}
                  <div class="cat">{p.cat}</div>
                </div>
                {!playoffDone && <span class="pts">{p.pts}</span>}
              </div>
            ))}
          </aside>
        </div>
      </header>
    </div>
  </div>

  <div class="wrap">
    <div class="home-stats">
      <div class="home-cell">
        <span class="filter-kicker">Temporada</span>
        <div class="seg" id="home-temps">
          {seasons.map((t) => (
            <button class:list={["seg-item", { on: t === current }]} type="button" data-temp={t}>
              <strong>{t}</strong>
            </button>
          ))}
        </div>
      </div>
      <div class="home-cell">
        <b id="home-players">{seasonCounts[current] || 0}</b>
        <span id="home-players-label">Jugadores en {current}</span>
      </div>
      <div class="home-cell">
        <b id="home-venues">{seasonVenues[current] ?? countedVenues}</b>
        <span id="home-venues-label">Sedes en {current}</span>
      </div>
      <div class="home-cell">
        <b>1</b>
        <span>Partido por semana</span>
      </div>
    </div>
  </div>
  <script define:vars={{ seasonCounts, seasonVenues, githubOwner: site.githubOwner, githubRepo: site.githubRepo }}>
    const counts = seasonCounts;
    const venues = seasonVenues;
    const num = document.querySelector("#home-players");
    const label = document.querySelector("#home-players-label");
    const venueNum = document.querySelector("#home-venues");
    const venueLabel = document.querySelector("#home-venues-label");
    function selectedTemp() {
      return document.querySelector("#home-temps .on")?.dataset.temp || "";
    }
    function paint(temp) {
      num.textContent = String(counts[temp] || 0);
      label.textContent = "Jugadores en " + temp;
      venueNum.textContent = String(venues[temp] ?? 0);
      venueLabel.textContent = "Sedes en " + temp;
    }
    document.querySelectorAll("#home-temps [data-temp]").forEach((btn) => {
      btn.addEventListener("click", () => {
        document.querySelectorAll("#home-temps [data-temp]").forEach((b) => b.classList.remove("on"));
        btn.classList.add("on");
        paint(btn.dataset.temp);
      });
    });
    if (githubOwner && githubRepo) {
      fetch("https://raw.githubusercontent.com/" + githubOwner + "/" + githubRepo + "/main/src/data/site.json?t=" + Date.now(), { cache: "no-store" })
        .then((res) => (res.ok ? res.json() : null))
        .then((remote) => {
          const saved = remote && remote.seasonVenues;
          if (!saved || typeof saved !== "object") return;
          Object.keys(venues).forEach((temp) => {
            const n = Number(saved[temp]);
            if (Number.isFinite(n)) venues[temp] = n;
          });
          const temp = selectedTemp();
          if (temp) paint(temp);
        })
        .catch(() => {});
    }
  </script>

  <script>
    const root = document.querySelector(".home-open");
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (root && !reduce) {
      const arm = () => root.classList.add("home-play");
      const splash = document.getElementById("splash");
      setTimeout(() => {
        if (!splash || splash.hidden || !splash.isConnected) {
          arm();
          return;
        }
        const watch = new MutationObserver(() => {
          if (splash.classList.contains("out") || !splash.isConnected) arm();
        });
        watch.observe(splash, { attributes: true, attributeFilter: ["class"] });
        setTimeout(() => {
          arm();
          watch.disconnect();
        }, 3400);
      }, 0);
    }
  </script>

  <section>
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="kicker">La liga</p>
          <h2>Cómo se juega</h2>
        </div>
        <p>Categorías A, B y C. Damas y caballeros. Puntos individuales. Un partido por semana, lunes a sábado.</p>
      </div>
      <div class="steps">
        <article class="step">
          <div class="n">01</div>
          <h3>Te anotas</h3>
          <p>Elegís categoría. Te confirmamos por WhatsApp y entras al fixture.</p>
        </article>
        <article class="step">
          <div class="n">02</div>
          <h3>Tarde/Noche</h3>
          <p>En distintos complejos de la ciudad, según el fixture de cada semana.</p>
        </article>
        <article class="step">
          <div class="n">03</div>
          <h3>Subís en la tabla</h3>
          <p>Buscás tu nombre. Ves posición, partidos y diferencia de sets. Cuatro temporadas publicadas.</p>
        </article>
      </div>
    </div>
  </section>

  <div class="wrap" style="padding:64px 0 24px">
    <div class="section-head">
      <div>
        <p class="kicker">Tres caminos</p>
        <h2>Elegí dónde vas</h2>
      </div>
    </div>
    <div class="hub-grid">
      <a class="hub-card" href={page("liga/")}>
        <p class="kicker" style="margin:0">Competí</p>
        <h2>Liga</h2>
        <p>Ranking, fixture, resultados e inscripciones de la competencia.</p>
      </a>
      <a class="hub-card" href={page("academia/")}>
        <p class="kicker" style="margin:0">Entrená</p>
        <h2>Academia</h2>
        <p>Clases de adultos e infantiles, más las sedes donde se entrena.</p>
      </a>
      <a class="hub-card" href={page("torneos/")}>
        <p class="kicker" style="margin:0">Próximamente</p>
        <h2>Torneos</h2>
        <p>Espacio listo para futuros torneos abiertos y brackets.</p>
      </a>
    </div>
  </div>

</Layout>
