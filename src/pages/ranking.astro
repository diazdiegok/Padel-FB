---
import Layout from "../layouts/Layout.astro";
import ranking from "../data/ranking.json";
import { site } from "../data/site";
import { listSeasons, seasonLabel, seasonNumber } from "../lib/liga.js";

const HIDDEN_CATS = new Set(["S Masculina"]);
const rows = ranking.filter((p) => !HIDDEN_CATS.has(p.cat));
const temps = listSeasons(site, rows.map((p) => p.temp))
  .slice()
  .sort((a, b) => seasonNumber(b) - seasonNumber(a));
const current = temps.includes(site.currentSeason) ? site.currentSeason : temps[0] || "";
const seasonBlocks = temps.map((temp) => {
  const list = rows.filter((p) => p.temp === temp);
  const catCards = [...new Set(list.map((p) => p.cat))]
    .sort((a, b) => a.localeCompare(b, "es"))
    .map((cat) => ({
      cat,
      total: list.filter((p) => p.cat === cat).length,
    }));
  return {
    temp,
    title: seasonLabel(temp),
    total: list.length,
    live: temp === current,
    cats: catCards,
  };
});
---
<Layout
  title="Ranking | Padel FB"
  description="Ranking actualizado de Padel FB en Paraná. Buscá tu nombre, filtrá por categoría y temporada."
>
  <div class="wrap">
    <header class="page-hero">
      <p class="kicker">{rows.length} jugadores totales (todas las temporadas)</p>
      <h1>Ranking</h1>
      <p>Elegí la temporada. Adentro están las categorías.</p>
    </header>

    <aside class="rank-rules" aria-labelledby="rank-rules-title">
      <h2 id="rank-rules-title">Cómo se suman los puntos</h2>
      <p>Cada partido suma puntos a la pareja. <strong>La ganadora siempre suma 3 puntos</strong>. La perdedora suma según cómo se jugó:</p>
      <ul>
        <li>
          <strong>Ganás 2-0</strong> (ej. <b>6-4 6-2</b>): ganadora <b>3 pts</b>, perdedora <b>0 pts</b>.
        </li>
        <li>
          <strong>Ganás 2-1</strong> (ej. <b>6-4 3-6 6-2</b>): ganadora <b>3 pts</b>, perdedora <b>1 pt</b> (porque ganó un set).
        </li>
      </ul>
      <p>
        En la tabla, <b>PJ</b> son los partidos jugados y <b>Dif. sets</b> es la diferencia de sets a favor y en contra.
        El orden es por puntos; si empatan, decide la diferencia de sets.
      </p>
    </aside>

    {seasonBlocks.length === 0 ? (
      <p class="empty" style="display:block;padding:48px 0">Próximamente. Cuando haya parejas en el ranking van a aparecer acá.</p>
    ) : (
      <>
        <div class="hub-grid" id="rank-seasons" style="grid-template-columns: repeat(auto-fill, minmax(220px, 1fr))">
          {seasonBlocks.map((block) => (
            <button class="hub-card" type="button" data-open-temp={block.temp} style="cursor:pointer;width:100%;text-align:left">
              <p class="kicker" style="margin:0">Temporada{block.live ? " · En juego" : ""}</p>
              <h2>{block.title}</h2>
              <p>{block.total} pareja{block.total === 1 ? "" : "s"}</p>
            </button>
          ))}
        </div>

        <div id="rank-inside" hidden>
          {seasonBlocks.map((block) => (
            <section class="season-box" data-rank-season={block.temp} hidden>
              <header class="season-box-head">
                <button class="season-back" type="button" data-rank-back>← Temporadas</button>
                <p class="kicker">Temporada{block.live ? " · En juego" : ""}</p>
                <h2>{block.title}</h2>
                <p>{block.total} pareja{block.total === 1 ? "" : "s"}</p>
              </header>
              <div class="season-box-body" style="border:0;padding-top:16px">
                <div class="result-grid">
                  <button class="result-card" type="button" data-temp={block.temp} data-cat="Todas">
                    <p class="kicker">Ranking</p>
                    <h2>Todas</h2>
                    <p>{block.total} pareja{block.total === 1 ? "" : "s"}</p>
                  </button>
                  {block.cats.map((c) => (
                    <button class="result-card" type="button" data-temp={block.temp} data-cat={c.cat}>
                      <p class="kicker">Categoría</p>
                      <h2>{c.cat}</h2>
                      <p>{c.total} pareja{c.total === 1 ? "" : "s"}</p>
                    </button>
                  ))}
                </div>
                <div data-rank-body hidden>
                  <div class="filters">
                    <input class="search" data-rank-q type="search" placeholder="Buscar jugador o pareja…" autocomplete="off" />
                    <span class="tag" data-rank-count aria-live="polite"></span>
                  </div>
                  <p class="table-hint">Deslizá horizontalmente para ver toda la tabla.</p>
                  <div class="table-scroll" tabindex="0" role="region" aria-label={`Tabla ${block.title}`}>
                    <table class="board">
                      <thead>
                        <tr>
                          <th>#</th>
                          <th>Jugador / pareja</th>
                          <th>Categoría</th>
                          <th>PJ</th>
                          <th>Dif. sets</th>
                          <th>Pts</th>
                        </tr>
                      </thead>
                      <tbody data-rank-rows></tbody>
                    </table>
                  </div>
                  <p class="empty" data-rank-empty hidden>No hay jugadores con ese filtro.</p>
                </div>
              </div>
            </section>
          ))}
        </div>
      </>
    )}
  </div>

  <style>
    .season-back {
      justify-self: start;
      border: 0;
      background: none;
      color: var(--lime);
      font: inherit;
      font-size: 13px;
      padding: 0;
      margin-bottom: 6px;
      cursor: pointer;
    }
  </style>

  <script define:vars={{ players: rows }}>
    let cat = "Todas";
    let temp = "";
    const seasons = document.querySelector("#rank-seasons");
    const inside = document.querySelector("#rank-inside");

    function esc(s) {
      return String(s ?? "").replace(/[&<>"']/g, (c) =>
        ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c])
      );
    }

    function activeBox() {
      return document.querySelector(`.season-box[data-rank-season="${temp}"]`);
    }

    function showSeasons() {
      temp = "";
      cat = "Todas";
      if (seasons) seasons.hidden = false;
      if (inside) inside.hidden = true;
      document.querySelectorAll(".season-box").forEach((box) => {
        box.hidden = true;
        box.classList.remove("open");
        const body = box.querySelector("[data-rank-body]");
        if (body) body.hidden = true;
      });
    }

    function render() {
      const box = activeBox();
      if (!box) return;
      const tbody = box.querySelector("[data-rank-rows]");
      const empty = box.querySelector("[data-rank-empty]");
      const count = box.querySelector("[data-rank-count]");
      const q = box.querySelector("[data-rank-q]");
      const term = (q?.value || "").trim().toLowerCase();
      const list = players
        .filter((p) => {
          const okCat = cat === "Todas" || p.cat === cat;
          const okTemp = p.temp === temp;
          const okQ = !term || (p.name || "").toLowerCase().includes(term);
          return okCat && okTemp && okQ;
        })
        .sort((a, b) => Number(a.pos) - Number(b.pos) || Number(b.pts) - Number(a.pts));
      tbody.innerHTML = list
        .map(
          (p) => `<tr class="${Number(p.pos) === 1 ? "top1" : ""}">
          <td class="pos">${esc(p.pos)}</td>
          <td class="name">${esc(p.name)}</td>
          <td>${esc(p.cat)}</td>
          <td>${esc(p.pj)}</td>
          <td>${Number(p.dif) > 0 ? "+" : ""}${esc(p.dif)}</td>
          <td><strong>${esc(p.pts)}</strong></td>
        </tr>`
        )
        .join("");
      empty.hidden = list.length > 0;
      count.textContent = list.length + " jugadores";
    }

    function openSeason(nextTemp, nextCat = "Todas") {
      temp = nextTemp || "";
      cat = nextCat || "Todas";
      if (seasons) seasons.hidden = true;
      if (inside) inside.hidden = false;
      document.querySelectorAll(".season-box").forEach((box) => {
        const on = box.dataset.rankSeason === temp;
        box.hidden = !on;
        box.classList.toggle("open", on);
        const body = box.querySelector("[data-rank-body]");
        if (body) body.hidden = !on;
      });
      document.querySelectorAll(".result-card[data-temp]").forEach((b) => {
        b.classList.toggle("open", b.dataset.temp === temp && b.dataset.cat === cat);
      });
      render();
    }

    document.querySelectorAll("[data-open-temp]").forEach((btn) => {
      btn.addEventListener("click", () => openSeason(btn.dataset.openTemp, "Todas"));
    });
    document.querySelectorAll("[data-rank-back]").forEach((btn) => {
      btn.addEventListener("click", showSeasons);
    });
    document.querySelectorAll(".result-card[data-temp]").forEach((btn) => {
      btn.addEventListener("click", () => openSeason(btn.dataset.temp, btn.dataset.cat));
    });
    document.querySelectorAll("[data-rank-q]").forEach((input) => {
      input.addEventListener("input", () => {
        if (input.closest(".season-box")?.dataset.rankSeason === temp) render();
      });
    });
  </script>
</Layout>
