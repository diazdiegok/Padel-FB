---
import Layout from "../layouts/Layout.astro";
import ranking from "../data/ranking.json";
import { site } from "../data/site";
import { listSeasons, seasonLabel, seasonNumber } from "../lib/liga.js";

const HIDDEN_CATS = new Set(["S Masculina"]);
const rows = ranking.filter((p) => !HIDDEN_CATS.has(p.cat));
const temps = listSeasons(site, rows.map((p) => p.temp))
  .slice()
  .sort((a, b) => seasonNumber(b) - seasonNumber(a));
const cats = [...new Set(rows.map((p) => p.cat))].sort((a, b) => a.localeCompare(b, "es"));
const current = temps.includes(site.currentSeason) ? site.currentSeason : temps[0] || "";
const seasonBlocks = temps.map((temp) => {
  const list = rows.filter((p) => p.temp === temp);
  const catCards = [...new Set(list.map((p) => p.cat))]
    .sort((a, b) => a.localeCompare(b, "es"))
    .map((cat) => ({
      cat,
      total: list.filter((p) => p.cat === cat).length,
    }));
  return {
    temp,
    title: seasonLabel(temp),
    total: list.length,
    live: temp === current,
    cats: catCards,
  };
});
---
<Layout
  title="Ranking | Padel FB"
  description="Ranking actualizado de Padel FB en Paraná. Buscá tu nombre, filtrá por categoría y temporada."
>
  <div class="wrap">
    <header class="page-hero">
      <p class="kicker">{rows.length} jugadores totales (todas las temporadas)</p>
      <h1>Ranking</h1>
      <p>Elegí la temporada y después la categoría. También podés buscar por apellido.</p>
    </header>

    <aside class="rank-rules" aria-labelledby="rank-rules-title">
      <h2 id="rank-rules-title">Cómo se suman los puntos</h2>
      <p>Cada partido suma puntos a la pareja. <strong>La ganadora siempre suma 3 puntos</strong>. La perdedora suma según cómo se jugó:</p>
      <ul>
        <li>
          <strong>Ganás 2-0</strong> (ej. <b>6-4 6-2</b>): ganadora <b>3 pts</b>, perdedora <b>0 pts</b>.
        </li>
        <li>
          <strong>Ganás 2-1</strong> (ej. <b>6-4 3-6 6-2</b>): ganadora <b>3 pts</b>, perdedora <b>1 pt</b> (porque ganó un set).
        </li>
      </ul>
      <p>
        En la tabla, <b>PJ</b> son los partidos jugados y <b>Dif. sets</b> es la diferencia de sets a favor y en contra.
        El orden es por puntos; si empatan, decide la diferencia de sets.
      </p>
    </aside>

    {seasonBlocks.length === 0 ? (
      <p class="empty" style="display:block;padding:48px 0">Próximamente. Cuando haya parejas en el ranking van a aparecer acá.</p>
    ) : (
      <>
        {seasonBlocks.map((block) => (
          <div class="result-season" data-rank-season={block.temp}>
            <p class="kicker">Temporada{block.live ? " · En juego" : ""}</p>
            <h2>{block.title}</h2>
            <p style="margin:8px 0 0;color:var(--muted)">{block.total} pareja{block.total === 1 ? "" : "s"}</p>
            <div class="result-grid">
              <button
                class="result-card"
                type="button"
                data-temp={block.temp}
                data-cat="Todas"
              >
                <p class="kicker">Ranking</p>
                <h2>Todas</h2>
                <p>{block.total} / {block.total} parejas</p>
              </button>
              {block.cats.map((c) => (
                <button
                  class="result-card"
                  type="button"
                  data-temp={block.temp}
                  data-cat={c.cat}
                >
                  <p class="kicker">Categoría</p>
                  <h2>{c.cat}</h2>
                  <p>{c.total} pareja{c.total === 1 ? "" : "s"}</p>
                </button>
              ))}
            </div>
          </div>
        ))}

        <div id="rank-panel" class="result-panel" hidden>
          <div class="filters">
            <input class="search" id="q" type="search" placeholder="Buscar jugador o pareja…" autocomplete="off" />
            <div class="filter-group" style="flex:1;min-width:220px">
              <span>Categoría</span>
              <div class="pills" id="rank-cats">
                <button class="pill on" data-filter-cat="Todas" type="button">Todas</button>
                {cats.map((c) => (
                  <button class="pill" data-filter-cat={c} type="button">{c}</button>
                ))}
              </div>
            </div>
            <span class="tag" id="count" aria-live="polite"></span>
          </div>

          <p class="table-hint">Deslizá horizontalmente para ver toda la tabla.</p>
          <div class="table-scroll" tabindex="0" role="region" aria-label="Tabla de posiciones">
            <table class="board">
              <thead>
                <tr>
                  <th>#</th>
                  <th>Jugador / pareja</th>
                  <th>Categoría</th>
                  <th>PJ</th>
                  <th>Dif. sets</th>
                  <th>Pts</th>
                </tr>
              </thead>
              <tbody id="rows"></tbody>
            </table>
          </div>
          <p class="empty" id="empty" hidden>No hay jugadores con ese filtro.</p>
        </div>
      </>
    )}
  </div>

  <script define:vars={{ players: rows, cats }}>
    const panel = document.querySelector("#rank-panel");
    if (!panel) throw new Error("ranking");
    const q = document.querySelector("#q");
    const tbody = document.querySelector("#rows");
    const empty = document.querySelector("#empty");
    const count = document.querySelector("#count");
    const catPills = document.querySelector("#rank-cats");
    let cat = "Todas";
    let temp = "";

    function esc(s) {
      return String(s ?? "").replace(/[&<>"']/g, (c) =>
        ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c])
      );
    }

    function syncCatPills() {
      if (!catPills) return;
      const used = new Set(
        players.filter((p) => !temp || p.temp === temp).map((p) => p.cat)
      );
      catPills.querySelectorAll("[data-filter-cat]").forEach((btn) => {
        const value = btn.dataset.filterCat;
        const show = value === "Todas" || used.has(value);
        btn.hidden = !show;
        btn.classList.toggle("on", value === cat);
      });
    }

    function render() {
      const term = (q.value || "").trim().toLowerCase();
      const rows = players
        .filter((p) => {
          const okCat = cat === "Todas" || p.cat === cat;
          const okTemp = !temp || p.temp === temp;
          const okQ = !term || (p.name || "").toLowerCase().includes(term);
          return okCat && okTemp && okQ;
        })
        .sort((a, b) => Number(a.pos) - Number(b.pos) || Number(b.pts) - Number(a.pts));
      tbody.innerHTML = rows
        .map(
          (p) => `<tr class="${Number(p.pos) === 1 ? "top1" : ""}">
          <td class="pos">${esc(p.pos)}</td>
          <td class="name">${esc(p.name)}</td>
          <td>${esc(p.cat)}</td>
          <td>${esc(p.pj)}</td>
          <td>${Number(p.dif) > 0 ? "+" : ""}${esc(p.dif)}</td>
          <td><strong>${esc(p.pts)}</strong></td>
        </tr>`
        )
        .join("");
      empty.hidden = rows.length > 0;
      count.textContent = rows.length + " jugadores";
      syncCatPills();
    }

    function openSeason(nextTemp, nextCat) {
      temp = nextTemp || "";
      cat = nextCat || "Todas";
      if (cat !== "Todas" && !cats.includes(cat)) cat = "Todas";
      document.querySelectorAll(".result-card[data-temp]").forEach((b) => {
        const on = b.dataset.temp === temp && b.dataset.cat === cat;
        b.classList.toggle("open", on);
      });
      panel.hidden = !temp;
      syncCatPills();
      render();
      if (temp) panel.scrollIntoView({ behavior: "smooth", block: "start" });
    }

    q.addEventListener("input", render);
    catPills?.addEventListener("click", (e) => {
      const btn = e.target.closest("[data-filter-cat]");
      if (!btn || btn.hidden) return;
      cat = btn.dataset.filterCat || "Todas";
      document.querySelectorAll(".result-card[data-temp]").forEach((b) => {
        b.classList.toggle("open", b.dataset.temp === temp && b.dataset.cat === cat);
      });
      render();
    });
    document.querySelectorAll(".result-card[data-temp]").forEach((btn) => {
      btn.addEventListener("click", () => openSeason(btn.dataset.temp, btn.dataset.cat));
    });
  </script>
</Layout>
