---
import Layout from "../layouts/Layout.astro";
import ranking from "../data/ranking.json";
import { site } from "../data/site";

const HIDDEN_CATS = new Set(["S Masculina"]);
const rows = ranking.filter((p) => !HIDDEN_CATS.has(p.cat));
const temps = [...new Set(rows.map((p) => p.temp))];
const cats = [...new Set(rows.map((p) => p.cat))].sort();
const current = site.currentSeason || temps[temps.length - 1];
const seasonCounts = Object.fromEntries(temps.map((t) => [t, rows.filter((p) => p.temp === t).length]));
---
<Layout
  title="Ranking | Padel FB"
  description="Ranking actualizado de Padel FB en Paraná. Buscá tu nombre, filtrá por categoría y temporada."
>
  <div class="wrap">
    <header class="page-hero">
      <p class="kicker">{rows.length} jugadores totales (todas las temporadas)</p>
      <h1>Ranking</h1>
      <p>Escribí un apellido y filtrá por categoría. Elegí la temporada abajo.</p>
    </header>

    <div class="season-bar">
      <span class="filter-kicker">Temporada</span>
      <div class="seg" id="temps">
        {temps.map((t) => (
          <button class:list={["seg-item", { on: t === current }]} data-temp={t} type="button">
            <strong>{t}</strong>
            <span>{seasonCounts[t]}</span>
          </button>
        ))}
      </div>
    </div>

    <div class="filters">
      <input class="search" id="q" type="search" placeholder="Buscar jugador o pareja…" autocomplete="off" />
      <div class="filter-group" style="flex:1;min-width:220px">
        <span>Categoría</span>
        <div class="pills">
          <button class="pill on" data-cat="Todas" type="button">Todas</button>
          {cats.map((c) => (
            <button class="pill" data-cat={c} type="button">{c}</button>
          ))}
        </div>
      </div>
      <span class="tag" id="count" aria-live="polite"></span>
    </div>

    <p class="table-hint">Deslizá horizontalmente para ver toda la tabla.</p>
    <div class="table-scroll" tabindex="0" role="region" aria-label="Tabla de posiciones">
      <table class="board">
        <thead>
          <tr>
            <th>#</th>
            <th>Jugador / pareja</th>
            <th>Categoría</th>
            <th>PJ</th>
            <th>Dif. sets</th>
            <th>Pts</th>
          </tr>
        </thead>
        <tbody id="rows"></tbody>
      </table>
    </div>
    <p class="empty" id="empty" hidden>No hay jugadores con ese filtro.</p>
  </div>

  <script define:vars={{ players: rows }}>
    const q = document.querySelector("#q");
    const tbody = document.querySelector("#rows");
    const empty = document.querySelector("#empty");
    const count = document.querySelector("#count");
    let cat = "Todas";
    let temp = document.querySelector("[data-temp].on")?.dataset.temp || "";

    function esc(s) {
      return String(s ?? "").replace(/[&<>"']/g, (c) =>
        ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c])
      );
    }

    function render() {
      const term = (q.value || "").trim().toLowerCase();
      const rows = players.filter((p) => {
        const okCat = cat === "Todas" || p.cat === cat;
        const okTemp = !temp || p.temp === temp;
        const okQ = !term || (p.name || "").toLowerCase().includes(term);
        return okCat && okTemp && okQ;
      }).sort((a, b) => Number(a.pos) - Number(b.pos) || Number(b.pts) - Number(a.pts));
      tbody.innerHTML = rows
        .map(
          (p) => `<tr class="${Number(p.pos) === 1 ? "top1" : ""}">
          <td class="pos">${esc(p.pos)}</td>
          <td class="name">${esc(p.name)}</td>
          <td>${esc(p.cat)}</td>
          <td>${esc(p.pj)}</td>
          <td>${Number(p.dif) > 0 ? "+" : ""}${esc(p.dif)}</td>
          <td><strong>${esc(p.pts)}</strong></td>
        </tr>`
        )
        .join("");
      empty.hidden = rows.length > 0;
      count.textContent = rows.length + " jugadores";
    }

    q.addEventListener("input", render);
    document.querySelectorAll("[data-cat]").forEach((btn) => {
      btn.addEventListener("click", () => {
        document.querySelectorAll("[data-cat]").forEach((b) => b.classList.remove("on"));
        btn.classList.add("on");
        cat = btn.dataset.cat;
        render();
      });
    });
    document.querySelectorAll("[data-temp]").forEach((btn) => {
      btn.addEventListener("click", () => {
        document.querySelectorAll("[data-temp]").forEach((b) => b.classList.remove("on"));
        btn.classList.add("on");
        temp = btn.dataset.temp;
        render();
      });
    });
    render();
  </script>
</Layout>
