---
import Layout from "../layouts/Layout.astro";
import fixture from "../data/fixture.json";
import results from "../data/results.json";
import { site } from "../data/site";
import { combineResults, seasonLabel, seasonNumber, weekNumber } from "../lib/liga.js";

const DAY_ORDER = ["lunes", "martes", "miércoles", "miercoles", "jueves", "viernes", "sábado", "sabado", "domingo"];
const dayIdx = (d: string) => {
  const key = String(d || "").trim().toLowerCase();
  const i = DAY_ORDER.indexOf(key);
  return i < 0 ? 99 : i;
};

const all = combineResults(results, (fixture as any[]).filter((m) => m.home && m.away)).sort((a, b) => {
  const da = dayIdx(a.day);
  const db = dayIdx(b.day);
  if (da !== db) return da - db;
  return String(a.time || "").localeCompare(String(b.time || ""), "es");
});

const liveKeys = new Set(
  (fixture as any[])
    .filter((m) => m.home && m.away)
    .map((m) => `${m.temp || ""}|${m.week || ""}`)
);

const seasons = [...new Set(all.map((m) => m.temp || site.currentSeason || "T4"))].sort(
  (a, b) => seasonNumber(b) - seasonNumber(a)
);

const seasonBlocks = seasons.map((temp) => {
  const list = all.filter((m) => (m.temp || site.currentSeason || "T4") === temp);
  const weeks = [...new Set(list.map((m) => m.week || "Sin fecha"))].sort(
    (a, b) => weekNumber(b) - weekNumber(a) || String(a).localeCompare(String(b), "es")
  );
  const cards = weeks.map((week) => {
    const weekList = list.filter((m) => (m.week || "Sin fecha") === week);
    const live = liveKeys.has(`${temp}|${week}`);
    return { week, temp, total: weekList.length, live };
  });
  return {
    temp,
    title: seasonLabel(temp),
    live: temp === (site.currentSeason || ""),
    cards,
  };
});

const pending = (fixture as any[])
  .filter((m) => !!m.pending && !String(m.away || "").trim())
  .sort((a, b) => String(a.cat).localeCompare(String(b.cat), "es") || String(a.home).localeCompare(String(b.home), "es"));
const pendingCats = [...new Set(pending.map((m) => m.cat || "Sin categoría"))];
---
<Layout
  title="Fixture | Padel FB"
  description="Partidos semanales de Padel FB en Paraná. Filtrá por día, categoría, cancha y buscá una pareja."
>
  <div class="wrap">
    <header class="page-hero">
      <p class="kicker">Liga</p>
      <h1>Fixture</h1>
      <p>Elegí la temporada y después la fecha. Los partidos de cada jornada quedan ahí.</p>
    </header>

    {seasonBlocks.length === 0 ? (
      <p class="empty" style="display:block;padding:48px 0">Todavía no hay partidos cargados. Cuando se publiquen desde el admin van a aparecer acá.</p>
    ) : (
      <>
        <div class="hub-grid" id="fx-seasons" style="grid-template-columns: repeat(auto-fill, minmax(220px, 1fr))">
          {seasonBlocks.map((block) => (
            <button class="hub-card" type="button" data-open-temp={block.temp} style="cursor:pointer;width:100%;text-align:left">
              <p class="kicker" style="margin:0">Temporada{block.live ? " · En juego" : ""}</p>
              <h2>{block.title}</h2>
              <p>{block.cards.length} fecha{block.cards.length === 1 ? "" : "s"}</p>
            </button>
          ))}
        </div>

        <div id="fx-inside" hidden>
          {seasonBlocks.map((block) => (
            <section class="season-box" data-fx-season={block.temp} hidden>
              <header class="season-box-head">
                <button class="season-back" type="button" data-fx-back>← Temporadas</button>
                <p class="kicker">Temporada{block.live ? " · En juego" : ""}</p>
                <h2>{block.title}</h2>
                <p>{block.cards.length} fecha{block.cards.length === 1 ? "" : "s"}</p>
              </header>
              <div class="season-box-body" style="border:0;padding-top:16px">
                <div class="result-grid">
                  {block.cards.map((c) => (
                    <button class="result-card" type="button" data-week={c.week} data-temp={c.temp}>
                      <p class="kicker">Fecha</p>
                      <h2>{c.week}</h2>
                      <p>{c.total} partido{c.total === 1 ? "" : "s"}{c.live ? " · en juego" : ""}</p>
                    </button>
                  ))}
                </div>
                <div data-fx-body hidden>
                  <div class="filters fixture-filters">
                    <input class="search" data-fx-q type="search" placeholder="Buscar pareja o jugador…" autocomplete="off" />
                    <span class="tag" data-fx-count></span>
                  </div>
                  <div data-fx-root></div>
                  <p class="empty" data-fx-empty hidden>No hay partidos con ese filtro.</p>
                </div>
              </div>
            </section>
          ))}
        </div>
      </>
    )}

    {pending.length > 0 && (
      <section class="fixture-pending">
        <h2>Pendientes · {pending.length}</h2>
        <p>Estas parejas se anotaron pero no coincidieron en día y horario con otra de su categoría. Si pueden en otro horario, avisen a la organización.</p>
        {pendingCats.map((cat) => (
          <div class="fixture-pending-cat">
            <h3>{cat}</h3>
            <ul>
              {pending.filter((m) => (m.cat || "Sin categoría") === cat).map((m) => (
                <li>
                  <strong>{m.home}</strong>
                  {m.avail && <span>{m.avail}</span>}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </section>
    )}
  </div>

  <style>
    .season-back {
      justify-self: start;
      border: 0;
      background: none;
      color: var(--lime);
      font: inherit;
      font-size: 13px;
      padding: 0;
      margin-bottom: 6px;
      cursor: pointer;
    }
  </style>

  <script>
    import { describeResult } from "../lib/scoring.js";
    window.__ligaScoring = { describeResult };
  </script>
  <script define:vars={{ matches: all }}>
    let week = "";
    let temp = "";
    const seasonsEl = document.querySelector("#fx-seasons");
    const inside = document.querySelector("#fx-inside");
    const describeResult = (raw) => window.__ligaScoring?.describeResult?.(raw) || null;

    function esc(s) {
      return String(s ?? "").replace(/[&<>"']/g, (c) =>
        ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c])
      );
    }
    function fold(s) {
      return String(s || "")
        .toLowerCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "");
    }

    function activeBox() {
      return document.querySelector(`.season-box[data-fx-season="${temp}"]`);
    }

    function showSeasons() {
      week = "";
      temp = "";
      if (seasonsEl) seasonsEl.hidden = false;
      if (inside) inside.hidden = true;
      document.querySelectorAll(".season-box").forEach((box) => {
        box.hidden = true;
        box.classList.remove("open");
        const body = box.querySelector("[data-fx-body]");
        if (body) body.hidden = true;
      });
    }

    function render() {
      const box = activeBox();
      if (!box || !week) return;
      const root = box.querySelector("[data-fx-root]");
      const empty = box.querySelector("[data-fx-empty]");
      const count = box.querySelector("[data-fx-count]");
      const q = box.querySelector("[data-fx-q]");
      const term = fold((q?.value || "").trim());
      const rows = matches.filter((m) => {
        if ((m.week || "Sin fecha") !== week || (m.temp || "") !== temp) return false;
        const blob = fold([m.home, m.away].filter(Boolean).join(" "));
        return !term || blob.includes(term);
      });
      root.innerHTML = `<section class="fixture-week" style="padding-top:0">
        <h2>${esc(week)}</h2>
        <div class="fixture-list">
          ${rows
            .map((m) => {
              const info = describeResult(m.result);
              return `<article class="fixture-row">
                <div class="fixture-meta">
                  <span>${esc(m.day || m.date)}</span>
                  <span>${esc(m.time)}</span>
                  <span>${esc(m.cat)}</span>
                </div>
                <div class="fixture-vs">
                  <div class="pair pair-a${info?.homeWin ? " winner" : ""}">
                    <span class="pair-label">Pareja 1</span>
                    <strong>${esc(m.home)}</strong>
                    ${info ? `<span class="pair-pts">${info.homePts} pts</span>` : ""}
                  </div>
                  <span class="vs">vs</span>
                  <div class="pair pair-b${info && !info.homeWin ? " winner" : ""}">
                    <span class="pair-label">Pareja 2</span>
                    <strong>${esc(m.away)}</strong>
                    ${info ? `<span class="pair-pts">${info.awayPts} pts</span>` : ""}
                  </div>
                </div>
                <div class="fixture-score">${
                  info
                    ? `<b>${esc(info.score)}</b><span>${info.label}</span>`
                    : m.result
                      ? `<b>${esc(m.result)}</b>`
                      : `<span class="tag">Por jugar</span>`
                }</div>
                <div class="fixture-place">
                  <span>${esc(m.venue)}${m.court ? ` · ${esc(m.court)}` : ""}</span>
                </div>
              </article>`;
            })
            .join("")}
        </div>
      </section>`;
      empty.hidden = rows.length > 0;
      count.textContent = rows.length + (rows.length === 1 ? " partido" : " partidos");
    }

    function openSeason(nextTemp) {
      temp = nextTemp || "";
      week = "";
      if (seasonsEl) seasonsEl.hidden = true;
      if (inside) inside.hidden = false;
      document.querySelectorAll(".season-box").forEach((box) => {
        const on = box.dataset.fxSeason === temp;
        box.hidden = !on;
        box.classList.toggle("open", on);
        const body = box.querySelector("[data-fx-body]");
        if (body) body.hidden = true;
      });
      document.querySelectorAll("[data-week]").forEach((b) => b.classList.remove("open"));
    }

    document.querySelectorAll("[data-open-temp]").forEach((btn) => {
      btn.addEventListener("click", () => openSeason(btn.dataset.openTemp));
    });
    document.querySelectorAll("[data-fx-back]").forEach((btn) => {
      btn.addEventListener("click", showSeasons);
    });
    document.querySelectorAll("[data-week]").forEach((btn) => {
      btn.addEventListener("click", () => {
        week = btn.dataset.week;
        temp = btn.dataset.temp || temp;
        document.querySelectorAll(".season-box").forEach((box) => {
          const on = box.dataset.fxSeason === temp;
          box.hidden = !on;
          box.classList.toggle("open", on);
          const body = box.querySelector("[data-fx-body]");
          if (body) body.hidden = !on;
        });
        document.querySelectorAll("[data-week]").forEach((b) => {
          b.classList.toggle("open", b.dataset.week === week && b.dataset.temp === temp);
        });
        render();
      });
    });
    document.querySelectorAll("[data-fx-q]").forEach((input) => {
      input.addEventListener("input", () => {
        if (input.closest(".season-box")?.dataset.fxSeason === temp) render();
      });
    });
  </script>
</Layout>
